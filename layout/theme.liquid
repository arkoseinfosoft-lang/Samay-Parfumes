<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#c9a96e">
    <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192x192.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <!-- Google Fonts for Luxury Typography (Asynchronous Non-Blocking) -->
    {% # theme-check-disable RemoteAsset, AssetPreload %}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap">
    </noscript>
    {% # theme-check-enable RemoteAsset, AssetPreload %}

    {% # LCP Image Preload for Instant Mobile Paint %}
    {%- if template.name == 'index' -%}
      <link rel="preload" as="image" href="{{ 'samay-hero-clock-mobile.webp' | asset_url }}" media="(max-width: 768px)" type="image/webp" fetchpriority="high">
      <link rel="preload" as="image" href="{{ 'samay-hero-clock.webp' | asset_url }}" media="(min-width: 769px)" type="image/webp" fetchpriority="high">
    {%- endif -%}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Inlined Critical CSS (0ms render-blocking delay) %}
    <style>
      {% render 'critical-css' %}
    </style>

    {% # Load Samay Parfumes Luxury CSS with native preload %}
    {{ 'samay.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="samay-theme-light">
    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <!-- Samay Interactive Script -->
    <script src="{{ 'samay.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
