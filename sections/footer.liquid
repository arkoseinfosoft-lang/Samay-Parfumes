{% comment %}
  SAMAY PARFUMES - LUXURY FOOTER
{% endcomment %}

<footer class="samay-footer">
  <div class="container">
    <div class="samay-footer-top">
      <!-- Col 1: Brand Info -->
      <div class="samay-footer-brand">
        <a href="{{ routes.root_url }}" aria-label="Samay Parfumes Home" class="samay-footer-logo-link">
          <img 
            src="{{ 'samay-logo-gold.png' | asset_url }}" 
            alt="Samay Parfumes Logo" 
            class="samay-footer-logo-img"
            width="200"
            height="88"
            loading="lazy"
          >
        </a>
        <p>
          A Fragrance Beyond Time. Handcrafted with master Grasse essences and aged oriental oud, Zyro is formulated to leave an indelible impression.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="samay-footer-heading">Maison</h4>
        <ul class="samay-footer-links">
          <li><a href="#hero">Home</a></li>
          <li><a href="#collection">Zyro 50ml Single</a></li>
          <li><a href="#collection">2-in-1 Duo Combo</a></li>
          <li><a href="#collection">3-in-1 Grand Trio</a></li>
          <li><a href="#notes">Olfactory Notes</a></li>
        </ul>
      </div>

      <!-- Col 3: Experience -->
      <div>
        <h4 class="samay-footer-heading">Experience</h4>
        <ul class="samay-footer-links">
          <li><a href="#about">Our Story</a></li>
          <li><a href="#contact">Contact Concierge</a></li>
          <li><a href="#contact">Shipping & FAQs</a></li>
          <li><a href="#contact">Customer Concierge</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Guarantee -->
      <div>
        <h4 class="samay-footer-heading">Our Promise</h4>
        <p style="font-size: 0.88rem; color: var(--dim); line-height: 1.7; margin-bottom: 16px;">
          ✦ 100% Genuine Artisan Perfumery<br>
          ✦ 6-8 Hours Proven Longevity<br>
          ✦ Formulated to IFRA Standards & Skin Safe<br>
          ✦ Free Express Courier across India
        </p>
      </div>
    </div>

    <div class="samay-footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} Samay Parfumes. All Rights Reserved. A Fragrance Beyond Time.
      </div>
      <div style="display: flex; gap: 20px; align-items: center;">
        <span>UPI Accepted</span>
        <span>•</span>
        <span>Cash on Delivery</span>
        <span>•</span>
        <span>NetBanking & Cards</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Luxury Footer",
  "settings": []
}
{% endschema %}
