{% comment %}
  SAMAY PARFUMES - LUXURY FOOTER
{% endcomment %}

<footer class="samay-footer">
  <div class="container">
    <div class="samay-footer-top">
      <!-- Col 1: Brand Info -->
      <div class="samay-footer-brand">
        <a href="{{ routes.root_url }}" aria-label="Samay Parfumes Home" class="samay-footer-logo-link">
          <picture>
            <source srcset="{{ 'samay-logo-gold.webp' | asset_url }}" type="image/webp">
            <img 
              src="{{ 'samay-logo-gold.png' | asset_url }}" 
              alt="Samay Parfumes Logo" 
              class="samay-footer-logo-img"
              width="200"
              height="88"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </a>
        <p>
          A Fragrance Beyond Time. Handcrafted with a blend of citrus, spice, oud and amber, Zayro is formulated to leave an indelible impression.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h2 class="samay-footer-heading">Maison</h2>
        <ul class="samay-footer-links">
          <li><a href="{{ routes.root_url }}#hero">Home</a></li>
          <li><a href="{{ routes.root_url }}#collection">Zayro 50ml Single</a></li>
          <li><a href="{{ routes.root_url }}#collection">2-in-1 Duo Combo</a></li>
          <li><a href="{{ routes.root_url }}#collection">3-in-1 Grand Trio</a></li>
          <li><a href="{{ routes.root_url }}#notes">Olfactory Notes</a></li>
        </ul>
      </div>

      <!-- Col 3: Experience -->
      <div>
        <h2 class="samay-footer-heading">Experience</h2>
        <ul class="samay-footer-links">
          <li><a href="{{ routes.root_url }}#about">Our Story</a></li>
          <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact &amp; Concierge</a></li>
          {%- if shop.shipping_policy != blank -%}
            <li><a href="{{ shop.shipping_policy.url }}">Shipping & FAQs</a></li>
          {%- else -%}
            <li><a href="{{ routes.root_url }}#faq">Shipping & FAQs</a></li>
          {%- endif -%}
          <li><a href="{{ routes.all_products_collection_url }}">All Fragrance Editions</a></li>
        </ul>
      </div>

      <!-- Col 4: Policies -->
      <div>
        <h2 class="samay-footer-heading">Policies</h2>
        <ul class="samay-footer-links">
          {%- if shop.policies.size > 0 -%}
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {% if shop.privacy_policy != blank %}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
            {% endif %}
            {% if shop.shipping_policy != blank %}
              <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
            {% endif %}
            {% if shop.terms_of_service != blank %}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
            {% endif %}
          {%- endif -%}
        </ul>
        {% assign footer_email = section.settings.contact_email | default: 'samayparfume@gmail.com' %}
        {% assign footer_phone = section.settings.contact_phone | default: '+91 93058 88555' %}
        {% if footer_email != blank or footer_phone != blank %}
          {% assign clean_phone = footer_phone | replace: ' ', '' | replace: '-', '' %}
          {% unless clean_phone contains '+' %}
            {% assign clean_phone = '+91' | append: clean_phone %}
          {% endunless %}
          {% assign display_phone = footer_phone %}
          {% if display_phone == '9305888555' or display_phone == '+919305888555' %}
            {% assign display_phone = '+91 93058 88555' %}
          {% endif %}
          <div class="samay-footer-contact">
            {% if footer_email != blank %}
              <a href="mailto:{{ footer_email | escape }}" aria-label="Email: {{ footer_email | escape }}">
                <span>✉</span> {{ footer_email | escape }}
              </a>
            {% endif %}
            {% if footer_phone != blank %}
              <a href="tel:{{ clean_phone | escape }}" aria-label="Call: {{ display_phone | escape }}">
                <span>✆</span> {{ display_phone | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Col 5: Trust & Guarantee -->
      <div>
        <h2 class="samay-footer-heading">Our Promise</h2>
        <p style="font-size: 0.88rem; color: #e2d7c5; line-height: 1.7; margin-bottom: 16px;">
          ✦ Authentic Samay Parfumes<br>
          ✦ Up to 6-8 Hours, varies by skin<br>
          ✦ Handcrafted in India<br>
          ✦ Free Express Shipping across India
        </p>
      </div>
    </div>

    <div class="samay-footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} Samay Parfumes. All Rights Reserved. A Fragrance Beyond Time.
      </div>
      <div style="display: flex; gap: 20px; align-items: center;">
        <span>UPI Accepted</span>
        <span>•</span>
        <span>Cash on Delivery</span>
        <span>•</span>
        <span>NetBanking & Cards</span>
      </div>
    </div>
  </div>
</footer>

{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "samayparfume@gmail.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 93058 88555"
    }
  ]
}
{% endschema %}
