{% comment %}
  SAMAY PARFUMES - LUXURY FOOTER
{% endcomment %}

<footer class="samay-footer">
  <div class="container">
    <div class="samay-footer-top">
      <!-- Col 1: Brand Info -->
      <div class="samay-footer-brand">
        <a href="{{ routes.root_url }}" aria-label="Samay Parfumes Home" class="samay-footer-logo-link">
          <picture>
            <source srcset="{{ 'samay-logo-gold.webp' | asset_url }}" type="image/webp">
            <img 
              src="{{ 'samay-logo-gold.png' | asset_url }}" 
              alt="Samay Parfumes Logo" 
              class="samay-footer-logo-img"
              width="200"
              height="88"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </a>
        <p>
          A Fragrance Beyond Time. Handcrafted with a blend of bergamot, lavender, smoked oud and amber resin, Zayro is formulated to leave an indelible impression.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h2 class="samay-footer-heading">Maison</h2>
        <ul class="samay-footer-links">
          <li><a href="{{ routes.root_url }}#hero">Home</a></li>
          <li><a href="{{ routes.root_url }}#collection">Zayro 50ml Single</a></li>
          <li><a href="{{ routes.root_url }}#collection">2-in-1 Duo Combo</a></li>
          <li><a href="{{ routes.root_url }}#collection">3-in-1 Grand Trio</a></li>
          <li><a href="{{ routes.root_url }}#notes">Olfactory Notes</a></li>
        </ul>
      </div>

      <!-- Col 3: Experience -->
      <div>
        <h2 class="samay-footer-heading">Experience</h2>
        <ul class="samay-footer-links">
          <li><a href="{{ routes.root_url }}#about">Our Story</a></li>
          <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact &amp; Concierge</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="{{ routes.root_url }}#faq">FAQs</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">All SAMAY Packs</a></li>
        </ul>
      </div>

      <!-- Col 4: Policies -->
      <div>
        <h2 class="samay-footer-heading">Policies</h2>
        <ul class="samay-footer-links">
          {%- if shop.policies.size > 0 -%}
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {% if shop.privacy_policy != blank %}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
            {% endif %}
            {% if shop.shipping_policy != blank %}
              <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
            {% endif %}
            {% if shop.terms_of_service != blank %}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
            {% endif %}
          {%- endif -%}
          <li><a href="#seller-info">Product &amp; Seller Info</a></li>
        </ul>
        {%- comment -%} TODO: Verify/update customer contact email (samayparfume@gmail.com) {%- endcomment -%}
        {% assign footer_email = section.settings.contact_email | default: 'samayparfume@gmail.com' %}
        {% assign footer_phone = section.settings.contact_phone | default: '+91 93058 88555' %}
        {% if footer_email != blank or footer_phone != blank %}
          {% assign clean_phone = footer_phone | replace: ' ', '' | replace: '-', '' %}
          {% unless clean_phone contains '+' %}
            {% assign clean_phone = '+91' | append: clean_phone %}
          {% endunless %}
          {% assign display_phone = footer_phone %}
          {% if display_phone == '9305888555' or display_phone == '+919305888555' %}
            {% assign display_phone = '+91 93058 88555' %}
          {% endif %}
          <div class="samay-footer-contact">
            {% if footer_email != blank %}
              <a href="mailto:{{ footer_email | escape }}" aria-label="Email: {{ footer_email | escape }}">
                <span>✉</span> {{ footer_email | escape }}
              </a>
            {% endif %}
            {% if footer_phone != blank %}
              <a href="tel:{{ clean_phone | escape }}" aria-label="Call: {{ display_phone | escape }}">
                <span>✆</span> {{ display_phone | escape }}
              </a>
              <a href="https://wa.me/919305888555?text=Hi%20Samay%20Parfumes%2C%20I%20have%20a%20question%20about%20Zayro" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" data-track-click="whatsapp_footer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:-2px;margin-right:6px;"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.08 7.41 8.84 7.67C8.6 7.93 7.92 8.57 7.92 9.87C7.92 11.17 8.87 12.42 9 12.6C9.13 12.78 10.84 15.42 13.45 16.55C14.07 16.82 14.56 16.98 14.93 17.1C15.56 17.3 16.12 17.27 16.57 17.2C17.07 17.13 18.12 16.56 18.34 15.94C18.56 15.31 18.56 14.78 18.49 14.67C18.42 14.55 18.25 14.49 18 14.36C17.75 14.23 16.49 13.61 16.26 13.52C16.03 13.43 15.86 13.39 15.7 13.63C15.53 13.88 15.05 14.44 14.9 14.61C14.76 14.78 14.61 14.81 14.36 14.68C14.11 14.55 13.31 14.29 12.36 13.44C11.62 12.78 11.12 11.97 10.97 11.72C10.83 11.47 10.95 11.34 11.08 11.21C11.19 11.1 11.33 10.92 11.45 10.77C11.58 10.62 11.62 10.51 11.7 10.35C11.79 10.18 11.74 10.04 11.68 9.92C11.62 9.8 11.12 8.58 10.91 8.08C10.71 7.6 10.51 7.66 10.35 7.65C10.21 7.64 10.04 7.64 9.87 7.64C9.71 7.64 9.53 7.34 9.53 7.34Z"/></svg>
                Chat on WhatsApp
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Col 5: Trust & Guarantee -->
      <div>
        <h2 class="samay-footer-heading">Our Promise</h2>
        <p style="font-size: 0.88rem; color: #e2d7c5; line-height: 1.7; margin-bottom: 16px;">
          ✦ Authentic Samay Parfumes<br>
          ✦ Handcrafted in India<br>
          ✦ Free Shipping across India
        </p>
      </div>
    </div>

    <div class="samay-footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} Samay Parfumes. All Rights Reserved. A Fragrance Beyond Time.
      </div>
      <div style="display: flex; gap: 20px; align-items: center;">
        <span>UPI Accepted</span>
        <span>•</span>
        <span>Cash on Delivery</span>
        <span>•</span>
        <span>NetBanking & Cards</span>
      </div>
    </div>
  </div>
</footer>

{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "samayparfume@gmail.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 93058 88555"
    }
  ]
}
{% endschema %}
