{% comment %}
  SAMAY PARFUMES - LUXURY SHOPPING BAG TEMPLATE (/cart)
  Mobile-first architecture mirroring the slide-out cart drawer look & feel.
  Works natively without JavaScript (real form to /cart with name="checkout"
  and direct /cart/change links), enhanced with AJAX via window.samayCart.
{% endcomment %}

<div class="samay-cart-page-wrapper" id="samayCartPage">
  <div class="container" style="max-width: 620px; padding: 40px 16px 80px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <nav class="samay-breadcrumb" style="margin-bottom: 24px; justify-content: center;" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="samay-breadcrumb-sep">/</span>
      <span aria-current="page">Shopping Bag</span>
    </nav>

    <!-- Luxury Cart Container (Drawer-Look Aesthetic) -->
    <div class="samay-cart-drawer-card">
      <div class="samay-drawer-header" style="padding: 24px;">
        <h1 class="samay-drawer-title" style="font-size: 1.5rem; margin: 0;">
          Shopping Bag
          {%- if cart.item_count > 0 -%}
            <span style="font-family: var(--sans); font-size: 0.9rem; color: var(--gold-dark); font-weight: 600; margin-left: 8px;">
              ({{ cart.item_count }})
            </span>
          {%- endif -%}
        </h1>
      </div>

      {%- if cart.item_count > 0 -%}
        <!-- Free Shipping Unlock Banner -->
        <div style="padding: 16px 20px 0;">
          <div class="samay-cart-free-shipping" style="margin: 0;">
            ✦ <strong>Free shipping across India</strong> unlocked on your order!
          </div>
        </div>

        <!-- Real Form to /cart working with and without JS -->
        <form action="{{ routes.cart_url }}" method="post" id="samayCartPageForm" style="margin: 0;">
          <div class="samay-cart-items-body" style="padding: 12px 24px 24px;">
            {%- for item in cart.items -%}
              {%- assign item_img = item.image -%}
              {%- assign fallback_img = 'samay-product-single.webp' | asset_url -%}
              {%- if item.product.handle contains 'duo' or item.title contains 'Duo' -%}
                {%- assign fallback_img = 'samay-product-duo.webp' | asset_url -%}
              {%- elsif item.product.handle contains 'trio' or item.title contains 'Trio' -%}
                {%- assign fallback_img = 'samay-product-trio.webp' | asset_url -%}
              {%- endif -%}

              <div class="samay-cart-item" data-line-key="{{ item.key }}" style="align-items: flex-start;">
                {%- if item_img -%}
                  <a href="{{ item.url }}" style="display: block; flex-shrink: 0;">
                    <img 
                      src="{{ item_img | image_url: width: 160, height: 160, crop: 'center' }}" 
                      alt="{{ item.title | escape }}" 
                      class="samay-cart-item-img"
                      width="72"
                      height="72"
                      loading="lazy"
                    >
                  </a>
                {%- else -%}
                  <a href="{{ item.url }}" style="display: block; flex-shrink: 0;">
                    <img 
                      src="{{ fallback_img }}" 
                      alt="{{ item.title | escape }}" 
                      class="samay-cart-item-img"
                      width="72"
                      height="72"
                      loading="lazy"
                    >
                  </a>
                {%- endif -%}

                <div class="samay-cart-item-details">
                  <a href="{{ item.url }}" style="text-decoration: none; color: inherit;">
                    <h2 class="samay-cart-item-title" style="margin: 0 0 4px; font-size: 1.15rem; line-height: 1.3;">
                      {{ item.product.title }}
                    </h2>
                  </a>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="samay-cart-item-variant" style="margin-bottom: 8px;">
                      {{ item.variant.title }}
                    </div>
                  {%- endunless -%}

                  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; flex-wrap: wrap; gap: 8px;">
                    <span class="samay-cart-item-price">
                      {{ item.final_price | money }}
                    </span>

                    <!-- Quantity Stepper (-/+, not a text box) -->
                    <div class="samay-cart-stepper-wrap" style="display: inline-flex; align-items: center; gap: 6px;">
                      <a 
                        href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" 
                        class="samay-qty-btn samay-page-qty-minus" 
                        data-key="{{ item.key }}" 
                        data-qty="{{ item.quantity | minus: 1 }}" 
                        aria-label="Decrease quantity"
                      >−</a>

                      <span class="samay-cart-qty-display" style="font-size: 0.88rem; font-weight: 600; min-width: 22px; text-align: center; color: var(--brown);">
                        {{ item.quantity }}
                      </span>

                      <a 
                        href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" 
                        class="samay-qty-btn samay-page-qty-plus" 
                        data-key="{{ item.key }}" 
                        data-qty="{{ item.quantity | plus: 1 }}" 
                        aria-label="Increase quantity"
                      >+</a>
                    </div>
                  </div>

                  <div style="margin-top: 8px;">
                    <a 
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" 
                      class="samay-cart-item-remove samay-page-remove-btn" 
                      data-key="{{ item.key }}"
                      aria-label="Remove {{ item.title | escape }}"
                    >
                      Remove
                    </a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <!-- Drawer-Matched Footer with Subtotal & Full-Width Gold Checkout Button -->
          <div class="samay-drawer-footer">
            <div class="samay-drawer-subtotal">
              <span>Subtotal</span>
              <strong id="samayCartSubtotalVal" style="font-size: 1.25rem; color: var(--brown-dark);">
                {{ cart.original_total_price | default: cart.items_subtotal_price | default: cart.total_price | money }}
              </strong>
            </div>

            <div class="samay-drawer-tax-note" style="margin-bottom: 18px; font-size: 0.82rem; color: var(--dim);">
              All taxes included · Free shipping across India
            </div>

            {%- render 'coupon-banner' -%}

            <button 
              type="submit" 
              name="checkout" 
              class="samay-btn samay-btn--gold samay-btn--full" 
              style="font-size: 0.95rem; padding: 18px 24px; cursor: pointer; border: none; width: 100%;"
            >
              PROCEED TO CHECKOUT
            </button>

            <div style="text-align: center; margin-top: 16px;">
              <a 
                href="{{ routes.all_products_collection_url | default: '/collections/all' }}" 
                style="font-size: 0.84rem; color: var(--taupe); text-decoration: none; transition: color 0.25s ease;"
                onmouseover="this.style.color='var(--gold-dark)'"
                onmouseout="this.style.color='var(--taupe)'"
              >
                ← Continue Shopping
              </a>
            </div>
          </div>
        </form>

      {%- else -%}
        <!-- Styled Empty Cart State matching Cart Drawer with link to Collection -->
        <div style="text-align: center; padding: 60px 24px; color: var(--taupe);">
          <div style="font-size: 2.8rem; color: var(--gold); margin-bottom: 14px;">⚜</div>
          <h2 style="font-family: var(--serif); font-size: 1.5rem; color: var(--brown); margin-bottom: 8px;">
            Your Shopping Bag is Empty
          </h2>
          <p style="font-size: 0.92rem; color: var(--dim); margin-bottom: 24px;">
            Experience the timeless essence of Zayro Eau De Parfum.
          </p>
          <a 
            href="{{ routes.all_products_collection_url | default: '/collections/all' }}" 
            class="samay-btn samay-btn--gold" 
            style="padding: 14px 32px; display: inline-flex;"
          >
            DISCOVER THE COLLECTION
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Progressive Enhancement for AJAX Interception if JS is enabled -->
<script>
  (function() {
    function initCartPageInteractions() {
      var minusBtns = document.querySelectorAll('.samay-page-qty-minus');
      var plusBtns = document.querySelectorAll('.samay-page-qty-plus');
      var removeBtns = document.querySelectorAll('.samay-page-remove-btn');

      function changeItemQuantity(key, targetQty) {
        if (window.samayCart && typeof window.samayCart.change === 'function') {
          window.samayCart.change(key, targetQty).then(function() {
            window.location.reload();
          });
        }
      }

      minusBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          if (window.samayCart && typeof window.samayCart.change === 'function') {
            e.preventDefault();
            var key = btn.getAttribute('data-key');
            var qty = parseInt(btn.getAttribute('data-qty'), 10);
            changeItemQuantity(key, qty < 0 ? 0 : qty);
          }
        });
      });

      plusBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          if (window.samayCart && typeof window.samayCart.change === 'function') {
            e.preventDefault();
            var key = btn.getAttribute('data-key');
            var qty = parseInt(btn.getAttribute('data-qty'), 10);
            changeItemQuantity(key, qty);
          }
        });
      });

      removeBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          if (window.samayCart && typeof window.samayCart.change === 'function') {
            e.preventDefault();
            var key = btn.getAttribute('data-key');
            changeItemQuantity(key, 0);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCartPageInteractions);
    } else {
      initCartPageInteractions();
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury Shopping Bag",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
