{% comment %}
  SAMAY PARFUMES - CONTACT PAGE TEMPLATE
  Dedicated luxury contact form and newsletter signup.
{% endcomment %}

<!-- ==========================================================================
     CONTACT SECTION
     ========================================================================== -->
<section class="samay-contact-section" id="contact">
  <div class="container">
    <div class="samay-sec-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="samay-heading-eyebrow samay-sec-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h1 class="samay-sec-title">{{ page.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="samay-sec-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
      <div class="samay-sec-divider"></div>
      {%- comment -%} TODO: Verify/update customer contact email (samayparfume@gmail.com) {%- endcomment -%}
      {%- assign concierge_email = section.settings.contact_email | default: 'samayparfume@gmail.com' -%}
      {%- assign concierge_phone = section.settings.contact_phone | default: '+91 93058 88555' -%}
      {%- assign clean_concierge_phone = concierge_phone | replace: ' ', '' | replace: '-', '' -%}
      {%- unless clean_concierge_phone contains '+' -%}
        {%- assign clean_concierge_phone = '+91' | append: clean_concierge_phone -%}
      {%- endunless -%}
      <div class="samay-contact-direct-bar">
        <span>Direct Assistance:</span>
        <a href="tel:{{ clean_concierge_phone | escape }}" class="samay-contact-direct-item" aria-label="Call {{ concierge_phone | escape }}">
          <span>✆</span> {{ concierge_phone | escape }}
        </a>
        <span class="samay-contact-direct-sep">•</span>
        <a href="https://wa.me/919305888555?text=Hi%20Samay%20Parfumes%2C%20I%20have%20a%20question%20about%20Zayro" target="_blank" rel="noopener noreferrer" class="samay-contact-direct-item" aria-label="Chat on WhatsApp" data-track-click="whatsapp_concierge_bar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:-1px;margin-right:4px;"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.08 7.41 8.84 7.67C8.6 7.93 7.92 8.57 7.92 9.87C7.92 11.17 8.87 12.42 9 12.6C9.13 12.78 10.84 15.42 13.45 16.55C14.07 16.82 14.56 16.98 14.93 17.1C15.56 17.3 16.12 17.27 16.57 17.2C17.07 17.13 18.12 16.56 18.34 15.94C18.56 15.31 18.56 14.78 18.49 14.67C18.42 14.55 18.25 14.49 18 14.36C17.75 14.23 16.49 13.61 16.26 13.52C16.03 13.43 15.86 13.39 15.7 13.63C15.53 13.88 15.05 14.44 14.9 14.61C14.76 14.78 14.61 14.81 14.36 14.68C14.11 14.55 13.31 14.29 12.36 13.44C11.62 12.78 11.12 11.97 10.97 11.72C10.83 11.47 10.95 11.34 11.08 11.21C11.19 11.1 11.33 10.92 11.45 10.77C11.58 10.62 11.62 10.51 11.7 10.35C11.79 10.18 11.74 10.04 11.68 9.92C11.62 9.8 11.12 8.58 10.91 8.08C10.71 7.6 10.51 7.66 10.35 7.65C10.21 7.64 10.04 7.64 9.87 7.64C9.71 7.64 9.53 7.34 9.53 7.34Z"/></svg>
          Chat on WhatsApp
        </a>
        <span class="samay-contact-direct-sep">•</span>
        <a href="mailto:{{ concierge_email | escape }}" class="samay-contact-direct-item" aria-label="Email {{ concierge_email | escape }}">
          <span>✉</span> {{ concierge_email | escape }}
        </a>
      </div>
    </div>

    <!-- Contact Form Box -->
    <div class="samay-contact-form-box samay-contact-form-box--page">
      {%- if section.settings.contact_form_heading != blank -%}
        <h2 class="samay-heading-section samay-contact-heading">{{ section.settings.contact_form_heading }}</h2>
      {%- endif -%}

      {% form 'contact', id: 'samayContactPageForm' %}
        {%- if section.settings.redirect_to_thank_you -%}
          <input type="hidden" name="return_to" value="/pages/thank-you">
        {%- endif -%}

        <!-- Anti-Spam Honeypot Field -->
        <div class="hp-field" aria-hidden="true" tabindex="-1">
          <input type="text" id="ContactPageHoney" name="b_comment" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        </div>

        {% if form.posted_successfully? %}
          <div class="samay-form-success">
            {%- if section.settings.contact_success_message != blank -%}
              {{ section.settings.contact_success_message }}
            {%- endif -%}
          </div>
        {% elsif form.errors %}
          <div class="samay-form-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="samay-form-row">
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactPageName">Full Name</label>
            <input 
              type="text" 
              id="ContactPageName" 
              name="contact[name]" 
              class="samay-form-input" 
              placeholder="e.g. Rahul Sharma" 
              value="{{ form.name | default: customer.name | escape }}" 
              required
            >
          </div>

          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactPageEmail">Email Address</label>
            <input 
              type="email" 
              id="ContactPageEmail" 
              name="contact[email]" 
              class="samay-form-input" 
              placeholder="e.g. rahul@example.com" 
              value="{{ form.email | default: customer.email | escape }}" 
              required
            >
          </div>
        </div>

        <div class="samay-form-group">
          <label class="samay-form-label" for="ContactPagePhone">Phone / WhatsApp</label>
          <input 
            type="tel" 
            id="ContactPagePhone" 
            name="contact[phone]" 
            class="samay-form-input" 
            placeholder="+91 98765 43210" 
            value="{{ form.phone | default: customer.phone | escape }}" 
            pattern="[0-9+\s\-]{10,15}"
            title="Please enter a valid 10-15 digit phone number"
            required
          >
        </div>

        <div class="samay-form-group">
          <label class="samay-form-label" for="ContactPageTopic">Inquiry Topic</label>
          {%- assign topic_options = section.settings.contact_topics | newline_to_br | split: '<br />' -%}
          <select id="ContactPageTopic" name="contact[Inquiry Topic]" class="samay-form-select">
            {%- for topic in topic_options -%}
              {%- assign clean_topic = topic | strip_newlines | strip -%}
              {%- if clean_topic != blank -%}
                <option value="{{ clean_topic | escape }}">{{ clean_topic }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>

        <div class="samay-form-group">
          <label class="samay-form-label" for="ContactPageMessage">Your Message</label>
          <textarea 
            id="ContactPageMessage" 
            name="contact[body]" 
            class="samay-form-textarea" 
            rows="4" 
            placeholder="How can we assist you today?" 
            required
          >{{ form.body | escape }}</textarea>
        </div>

        {%- if section.settings.contact_btn_label != blank -%}
          <button type="submit" class="samay-btn samay-btn--gold samay-btn--full">
            {{ section.settings.contact_btn_label }}
          </button>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

<!-- ==========================================================================
     VIP NEWSLETTER
     ========================================================================== -->
<section class="samay-newsletter-section">
  <div class="container">
    <div class="samay-newsletter-box">
      {%- if section.settings.newsletter_eyebrow != blank -%}
        <div class="samay-heading-eyebrow samay-sec-eyebrow--gold">{{ section.settings.newsletter_eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.newsletter_title != blank -%}
        <h2 class="samay-heading-section">{{ section.settings.newsletter_title }}</h2>
      {%- endif -%}
      {%- if section.settings.newsletter_desc != blank -%}
        <p>
          {{ section.settings.newsletter_desc }}
        </p>
      {%- endif -%}
      {% form 'customer', id: 'samayContactPageNewsletter', class: 'samay-newsletter-form-container' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="customer[accepts_marketing]" value="true">

        <!-- Anti-Spam Honeypot Field -->
        <div class="hp-field" aria-hidden="true" tabindex="-1">
          <input type="text" id="ContactNewsletterHoney" name="b_comment" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        </div>
        {% if form.posted_successfully? %}
          <div class="samay-newsletter-success">
            {%- if section.settings.newsletter_success_message != blank -%}
              {{ section.settings.newsletter_success_message }}
            {%- endif -%}
          </div>
        {% elsif form.errors %}
          <div class="samay-newsletter-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="samay-newsletter-form">
          <input 
            type="email" 
            id="ContactPageNewsletterEmail"
            name="contact[email]" 
            class="samay-newsletter-input" 
            placeholder="Enter your email address" 
            value="{{ customer.email | escape }}" 
            required
            aria-label="Email address"
          >
          {%- if section.settings.newsletter_btn_label != blank -%}
            <button type="submit" class="samay-btn samay-btn--gold">
              {{ section.settings.newsletter_btn_label }}
            </button>
          {%- endif -%}
        </div>
        {%- if section.settings.newsletter_consent != blank -%}
          <p class="samay-newsletter-consent">
            {{ section.settings.newsletter_consent }}
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "ASSISTANCE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Have a question about your order, tracking, or choosing between our single bottle and combos? Reach out directly to our team."
    },
    {
      "type": "header",
      "content": "Direct Concierge Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Concierge Email",
      "default": "samayparfume@gmail.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Concierge Phone",
      "default": "+91 93058 88555"
    },
    {
      "type": "header",
      "content": "Contact Form"
    },
    {
      "type": "text",
      "id": "contact_form_heading",
      "label": "Contact Form Heading",
      "default": "Send a Message"
    },
    {
      "type": "text",
      "id": "contact_success_message",
      "label": "Contact Form Success Message",
      "default": "✦ Thank you! Our perfumery will contact you within 24 hours."
    },
    {
      "type": "checkbox",
      "id": "redirect_to_thank_you",
      "label": "Redirect to /pages/thank-you",
      "info": "Redirects user to /pages/thank-you upon successful submission (requires creating the thank-you page in Shopify Admin).",
      "default": false
    },
    {
      "type": "textarea",
      "id": "contact_topics",
      "label": "Contact Inquiry Topics (one per line)",
      "default": "Order Status & Tracking\nAdvice on 2-in-1 or 3-in-1 Combo\nCorporate / Bulk Gifting\nGeneral Fragrance Inquiry"
    },
    {
      "type": "text",
      "id": "contact_btn_label",
      "label": "Submit Button Label",
      "default": "SEND MESSAGE"
    },
    {
      "type": "header",
      "content": "VIP Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter Eyebrow",
      "default": "Private Privileges"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Join The Samay Circle"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Newsletter Description",
      "default": "Enjoy privileged early access to small-batch launches, private olfactory invitations, and exclusive updates from our maison."
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Newsletter Success Message",
      "default": "✦ Welcome to the Samay Circle! Thank you for subscribing."
    },
    {
      "type": "text",
      "id": "newsletter_btn_label",
      "label": "Subscribe Button Label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "newsletter_consent",
      "label": "Newsletter Consent Disclaimer",
      "default": "By subscribing, you consent to receive email marketing communications from Samay Parfumes. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
