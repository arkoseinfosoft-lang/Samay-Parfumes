          <div class="samay-apply-icon-wrap" aria-hidden="true">
            <svg class="samay-apply-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 3v3m0 12v3M3 12h3m12 0h3"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <span class="samay-apply-step-num">Step 01</span>
          <p class="samay-apply-step-text">Spray on clean, moisturised skin at pulse points (wrists, neck).</p>
