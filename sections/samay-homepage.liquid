{% # theme-check-disable ExcessiveSettingsCount %}
{% comment %}
  SAMAY PARFUMES - COMPLETE LUXURY HOMEPAGE
  Inspired by House of Sasaa | Light Theme | Single Product with 3 Variations
  Fully dynamic and configurable via the Shopify Theme Editor (Online Store 2.0)
{% endcomment %}

<script>
  window.samayAssetUrl = "{{ 'zyro-single.jpg' | asset_url | split: 'zyro-single.jpg' | first }}";
  window.samayAssets = {
    single: "{{ 'samay-product-single.webp' | asset_url }}",
    duo: "{{ 'samay-product-duo.webp' | asset_url }}",
    trio: "{{ 'samay-product-trio.webp' | asset_url }}"
  };
</script>

<!-- ==========================================================================
     1. HERO BANNER SECTION
     ========================================================================== -->
<section class="samay-hero-section" id="hero">
  {%- if section.settings.hero_image != blank -%}
    <img 
      src="{{ section.settings.hero_image | image_url: width: 1400 }}" 
      alt="{{ section.settings.hero_image.alt | default: section.settings.hero_title | strip_html | escape }}" 
      class="samay-hero-bg"
      width="1024"
      height="571"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <img 
      src="{{ 'samay-hero-clock.jpg' | asset_url }}" 
      alt="Samay Parfumes Zayro Eau De Parfum Flacon Beyond Time" 
      class="samay-hero-bg"
      width="1024"
      height="571"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  <div class="samay-hero-overlay"></div>

  <div class="container samay-hero-container">
    <div class="samay-hero-content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <div class="samay-hero-eyebrow">
          <span>{{ section.settings.hero_eyebrow }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.hero_title != blank -%}
        <h1 class="samay-hero-title">
          {{ section.settings.hero_title }}
        </h1>
      {%- endif -%}
      {%- if section.settings.hero_desc != blank -%}
        <p class="samay-hero-desc">
          {{ section.settings.hero_desc }}
        </p>
      {%- endif -%}
      
      <div class="samay-hero-actions">
        {%- if section.settings.hero_btn1_label != blank -%}
          <a href="{{ section.settings.hero_btn1_link | default: '#collection' }}" class="samay-btn samay-btn--gold">
            {{ section.settings.hero_btn1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.hero_btn2_label != blank -%}
          <a href="{{ section.settings.hero_btn2_link | default: '#notes' }}" class="samay-btn samay-btn--outline">
            {{ section.settings.hero_btn2_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="samay-hero-highlights">
        {%- assign highlight_blocks = section.blocks | where: 'type', 'hero_highlight' -%}
        {%- if highlight_blocks.size > 0 -%}
          {%- for block in highlight_blocks -%}
            <div class="samay-highlight-item" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'star' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                {%- when 'shipping' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
              {%- endcase -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="samay-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>6-8 Hours Wear</span>
          </div>
          <div class="samay-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
            <span>15-20% Perfume Oil</span>
          </div>
          <div class="samay-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Free Express Shipping</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     2. INFINITE MARQUEE TICKER
     ========================================================================== -->
{%- assign marquee_blocks = section.blocks | where: 'type', 'marquee_item' -%}
{%- capture marquee_items_html -%}
  {%- if marquee_blocks.size > 0 -%}
    {%- for block in marquee_blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      <span class="samay-marquee-dot">✦</span>
    {%- endfor -%}
  {%- else -%}
    <span>EAU DE PARFUM</span>
    <span class="samay-marquee-dot">✦</span>
    <span>A FRAGRANCE BEYOND TIME</span>
    <span class="samay-marquee-dot">✦</span>
    <span>6-8 HOURS LONGEVITY</span>
    <span class="samay-marquee-dot">✦</span>
    <span>FRENCH & ORIENTAL ESSENCES</span>
    <span class="samay-marquee-dot">✦</span>
    <span>HANDCRAFTED IN INDIA</span>
    <span class="samay-marquee-dot">✦</span>
    <span>COMPLIMENT MAGNET</span>
    <span class="samay-marquee-dot">✦</span>
    <span>MAGNETIC LUXURY CAP</span>
    <span class="samay-marquee-dot">✦</span>
    <span>100% CRUELTY FREE</span>
    <span class="samay-marquee-dot">✦</span>
  {%- endif -%}
{%- endcapture -%}
<section class="samay-marquee-section">
  <div class="samay-marquee-track">
    <div class="samay-marquee-content">
      {{ marquee_items_html }}
    </div>
    <div class="samay-marquee-content" aria-hidden="true">
      {{ marquee_items_html }}
    </div>
  </div>
</section>

<!-- ==========================================================================
     3. BRAND PILLARS / CREDENTIALS
     ========================================================================== -->
<section class="samay-pillars-section">
  <div class="container">
    <h2 class="visually-hidden">Craftsmanship &amp; Pillars</h2>
    <div class="samay-pillars-grid">
      {%- assign pillar_blocks = section.blocks | where: 'type', 'brand_pillar' -%}
      {%- if pillar_blocks.size > 0 -%}
        {%- for block in pillar_blocks -%}
          <div class="samay-pillar-card" {{ block.shopify_attributes }}>
            <div class="samay-pillar-icon">{{ block.settings.icon }}</div>
            <div class="samay-pillar-eyebrow">{{ block.settings.eyebrow }}</div>
            <h3 class="samay-pillar-title">{{ block.settings.title }}</h3>
            <p class="samay-pillar-desc">
              {{ block.settings.description }}
            </p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="samay-pillar-card">
          <div class="samay-pillar-icon">⌛</div>
          <div class="samay-pillar-eyebrow">UNRIVALED LONGEVITY</div>
          <h3 class="samay-pillar-title">15-20% Perfume Oil</h3>
          <p class="samay-pillar-desc">
            Formulated at optimal Eau de Parfum concentration so your signature trail projects beautifully for 6-8 hours.
          </p>
        </div>

        <div class="samay-pillar-card">
          <div class="samay-pillar-icon">⚜</div>
          <div class="samay-pillar-eyebrow">MASTER ALCHEMY</div>
          <h3 class="samay-pillar-title">Rare French Essences</h3>
          <p class="samay-pillar-desc">
            Distilled with authentic Grasse bergamot, rare Indonesian agarwood, and ethically harvested amber crystals.
          </p>
        </div>

        <div class="samay-pillar-card">
          <div class="samay-pillar-icon">✦</div>
          <div class="samay-pillar-eyebrow">ARTISAN FLACON</div>
          <h3 class="samay-pillar-title">Heavy Crystal & Magnetic Cap</h3>
          <p class="samay-pillar-desc">
            Weighted luxury flacon with tactile pocket-watch motif, micro-mist atomiser, and satisfying magnetic snap.
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ==========================================================================
     4. PRODUCT VARIATIONS SECTION (SIGNATURE ELIXIR CARDS)
     ========================================================================== -->
<section class="samay-products-section ep-section" id="collection">
  <div class="container">
    <div class="ep-header">
      {%- if section.settings.collection_kicker != blank -%}
        <div class="ep-kicker">{{ section.settings.collection_kicker }}</div>
      {%- endif -%}
      {%- if section.settings.collection_title != blank -%}
        <h2 class="ep-section-title">{{ section.settings.collection_title }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.collection_hint != blank -%}
      <div class="ep-carousel-hint" aria-hidden="true">
        <span class="ep-hint-arrow">←</span>
        <span>{{ section.settings.collection_hint }}</span>
        <span class="ep-hint-arrow">→</span>
      </div>
    {%- endif -%}

    <div class="ep-grid">
      {%- assign bundle_blocks = section.blocks | where: 'type', 'bundle_tier' -%}
      {%- assign rendered_count = 0 -%}

      {%- if bundle_blocks.size > 0 -%}
        {%- for block in bundle_blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank and block.settings.fallback_handle != blank -%}
            {%- assign product = all_products[block.settings.fallback_handle] -%}
          {%- endif -%}
          {%- if product == blank -%}
            {%- assign default_handles = 'samay-zayro-50ml-eau-de-parfum,samay-zayro-duo-combo-2-in-1,samay-zayro-grand-trio-3-in-1-combo' | split: ',' -%}
            {%- assign default_handle = default_handles[forloop.index0] -%}
            {%- assign product = all_products[default_handle] -%}
          {%- endif -%}

          {%- if product != blank and product.title != blank -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            {%- assign price = variant.price -%}
            {%- assign compare_at = nil -%}
            {%- assign discount_percent = 0 -%}
            {%- assign compare_at = variant.compare_at_price -%}
            {%- if compare_at > price -%}
              {%- assign diff = compare_at | minus: price -%}
              {%- assign discount_percent = diff | times: 100 | divided_by: compare_at -%}
            {%- endif -%}

            {%- assign card_url = product.url -%}
            {%- if card_url == blank and block.settings.fallback_handle != blank -%}
              {%- assign card_url = '/products/' | append: block.settings.fallback_handle -%}
            {%- endif -%}
            {%- if card_url == blank and default_handle != blank -%}
              {%- assign card_url = '/products/' | append: default_handle -%}
            {%- endif -%}
            {%- if card_url == blank -%}
              {%- assign card_url = '#collection' -%}
            {%- endif -%}

            {%- assign card_title = block.settings.title | default: product.title -%}

            <article class="ep-card is-active" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}" data-product-url="{{ card_url }}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <span class="ep-badge">{{ block.settings.badge }}</span>
              {%- endif -%}

              <a href="{{ card_url }}" class="ep-media-link" aria-label="{{ card_title | escape }}">
                <div class="ep-media">
                  <div class="ep-media__viewport">
                    <div class="ep-media__inner">
                      {%- if block.settings.custom_image != blank -%}
                        {%- assign card_img = block.settings.custom_image | image_url: width: 1024 -%}
                      {%- elsif product.featured_image != blank -%}
                        {%- assign card_img = product.featured_image | image_url: width: 1024 -%}
                      {%- elsif forloop.index == 2 -%}
                        {%- assign card_img = 'samay-product-duo.webp' | asset_url -%}
                      {%- elsif forloop.index == 3 -%}
                        {%- assign card_img = 'samay-product-trio.webp' | asset_url -%}
                      {%- else -%}
                        {%- assign card_img = 'samay-product-single.webp' | asset_url -%}
                      {%- endif -%}

                      <img 
                        src="{{ card_img }}" 
                        alt="{{ product.title | escape }}" 
                        class="ep-img"
                        loading="lazy"
                        width="1024"
                        height="1024"
                      >
                    </div>
                  </div>
                </div>
              </a>

              <div class="ep-info">
                <a href="{{ card_url }}" class="ep-title-link">{{ card_title | upcase }}</a>

                <div class="ep-price-row">
                  <span class="ep-price">{{ price | money }}</span>
                  {%- if compare_at and compare_at > price -%}
                    <span class="ep-price-compare">{{ compare_at | money }}</span>
                    <span class="ep-price-discount">-{{ discount_percent }}%</span>
                  {%- endif -%}
                </div>

                {%- if block.settings.specs != blank -%}
                  <div class="ep-specs">
                    <span>✦</span>
                    <span>{{ block.settings.specs }}</span>
                  </div>
                {%- endif -%}

                <button 
                  type="button" 
                  class="ep-add samay-add-cart-btn" 
                  data-variant-id="{{ variant.id }}"
                  onclick="window.samayCart && window.samayCart.add({{ variant.id }}, 1)"
                  {% unless variant.available %}disabled="disabled"{% endunless %}
                >
                  {%- if variant.available -%}
                    {{ block.settings.button_label }}
                  {%- else -%}
                    OUT OF STOCK
                  {%- endif -%}
                </button>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}


      {%- if rendered_count == 0 -%}
        {%- for product in collections.all.products limit: 3 -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign price = variant.price -%}
          {%- assign compare_at = nil -%}
          {%- assign discount_percent = 0 -%}
          {%- assign compare_at = variant.compare_at_price -%}
          {%- if compare_at > price -%}
            {%- assign diff = compare_at | minus: price -%}
            {%- assign discount_percent = diff | times: 100 | divided_by: compare_at -%}
          {%- endif -%}

          {%- assign fallback_url = product.url | default: '#collection' -%}

          <article class="ep-card is-active" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}" data-product-url="{{ fallback_url }}">
            <a href="{{ fallback_url }}" class="ep-media-link" aria-label="{{ product.title | escape }}">
              <div class="ep-media">
                <div class="ep-media__viewport">
                  <div class="ep-media__inner">
                    {%- if product.featured_image != blank -%}
                      {%- assign fallback_card_img = product.featured_image | image_url: width: 1024 -%}
                    {%- elsif forloop.index == 2 -%}
                      {%- assign fallback_card_img = 'samay-product-duo.webp' | asset_url -%}
                    {%- elsif forloop.index == 3 -%}
                      {%- assign fallback_card_img = 'samay-product-trio.webp' | asset_url -%}
                    {%- else -%}
                      {%- assign fallback_card_img = 'samay-product-single.webp' | asset_url -%}
                    {%- endif -%}
                    <img 
                      src="{{ fallback_card_img }}" 
                      alt="{{ product.title | escape }}" 
                      class="ep-img"
                      loading="lazy"
                      width="1024"
                      height="1024"
                    >
                  </div>
                </div>
              </div>
            </a>

            <div class="ep-info">
              <a href="{{ fallback_url }}" class="ep-title-link">{{ product.title | upcase }}</a>

              <div class="ep-price-row">
                <span class="ep-price">{{ price | money }}</span>
                {%- if compare_at and compare_at > price -%}
                  <span class="ep-price-compare">{{ compare_at | money }}</span>
                  <span class="ep-price-discount">-{{ discount_percent }}%</span>
                {%- endif -%}
              </div>

              <button 
                type="button" 
                class="ep-add samay-add-cart-btn" 
                data-variant-id="{{ variant.id }}"
                onclick="window.samayCart && window.samayCart.add({{ variant.id }}, 1)"
              >
                ADD TO CART
              </button>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="ep-carousel-controls" aria-label="Product carousel controls">
      <button type="button" class="ep-carousel-arrow ep-carousel-prev" aria-label="Previous edition" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="ep-carousel-dots" role="tablist" aria-label="Product editions">
        {%- assign total_dots = rendered_count | default: 3 -%}
        {%- for i in (1..total_dots) -%}
          {%- assign dot_index = forloop.index0 -%}
          <button 
            type="button" 
            class="ep-carousel-dot{% if forloop.first %} is-active{% endif %}" 
            role="tab" 
            aria-selected="{{ forloop.first }}" 
            aria-label="Edition {{ forloop.index }}" 
            data-index="{{ dot_index }}"
          ></button>
        {%- endfor -%}
      </div>
      <button type="button" class="ep-carousel-arrow ep-carousel-next" aria-label="Next edition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <!-- Live Product & Offer Structured Data (Schema.org) -->
  <script type="application/ld+json">
  [
    {%- assign schema_rendered = false -%}
    {%- if bundle_blocks.size > 0 -%}
      {%- for block in bundle_blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank and block.settings.fallback_handle != blank -%}
          {%- assign p = all_products[block.settings.fallback_handle] -%}
        {%- endif -%}
        {%- if p == blank -%}
          {%- assign default_handles = 'samay-zayro-50ml-eau-de-parfum,samay-zayro-duo-combo-2-in-1,samay-zayro-grand-trio-3-in-1-combo' | split: ',' -%}
          {%- assign default_handle = default_handles[forloop.index0] -%}
          {%- assign p = all_products[default_handle] -%}
        {%- endif -%}
        {%- if p != blank and p.title != blank -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- if schema_rendered -%},{%- endif -%}
          {%- assign schema_rendered = true -%}
          {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": {{ p.title | json }},
            "url": {{ shop.url | append: p.url | json }},
            "description": {{ p.description | strip_html | truncatewords: 45 | json }},
            "brand": {
              "@type": "Brand",
              "name": {{ shop.name | json }}
            },
            {%- if p.featured_image -%}
              {%- assign p_img = p.featured_image | image_url: width: 1000 -%}
              {%- assign p_slice = p_img | slice: 0, 2 -%}
              {%- if p_slice == '//' -%}{%- assign p_img = 'https:' | append: p_img -%}{%- endif -%}
            "image": [
              {{ p_img | json }}
            ],
            {%- endif -%}
            {%- if v.sku != blank -%}
            "sku": {{ v.sku | json }},
            {%- endif -%}
            "offers": {
              "@type": "Offer",
              "url": {{ shop.url | append: p.url | json }},
              "priceCurrency": {{ cart.currency.iso_code | default: "INR" | json }},
              "price": {{ v.price | money_without_currency | remove: "," | json }},
              "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
              "itemCondition": "https://schema.org/NewCondition",
              "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
              "seller": {
                "@type": "Organization",
                "name": {{ shop.name | json }}
              }
            }
          }
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if schema_rendered == false -%}
      {%- for p in collections.all.products limit: 3 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- if schema_rendered -%},{%- endif -%}
        {%- assign schema_rendered = true -%}
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ p.title | json }},
          "url": {{ shop.url | append: p.url | json }},
          "description": {{ p.description | strip_html | truncatewords: 45 | json }},
          "brand": {
            "@type": "Brand",
            "name": {{ shop.name | json }}
          },
          {%- if p.featured_image -%}
            {%- assign p_img = p.featured_image | image_url: width: 1000 -%}
            {%- assign p_slice = p_img | slice: 0, 2 -%}
            {%- if p_slice == '//' -%}{%- assign p_img = 'https:' | append: p_img -%}{%- endif -%}
          "image": [
            {{ p_img | json }}
          ],
          {%- endif -%}
          {%- if v.sku != blank -%}
          "sku": {{ v.sku | json }},
          {%- endif -%}
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: p.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: "INR" | json }},
            "price": {{ v.price | money_without_currency | remove: "," | json }},
            "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
            "itemCondition": "https://schema.org/NewCondition",
            "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "seller": {
              "@type": "Organization",
              "name": {{ shop.name | json }}
            }
          }
        }
      {%- endfor -%}
    {%- endif -%}
  ]
  </script>
</section>

<!-- ==========================================================================
     5. PHILOSOPHY BANNER
     ========================================================================== -->
<section class="samay-philosophy-section">
  <div class="samay-philosophy-bg"></div>
  <div class="samay-philosophy-container">
    {%- if section.settings.philosophy_eyebrow != blank -%}
