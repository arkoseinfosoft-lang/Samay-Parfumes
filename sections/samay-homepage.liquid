        <div class="samay-apply-step">
          <div class="samay-apply-icon-wrap" aria-hidden="true">
            <svg class="samay-apply-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 3h6v3H9zM10 6v3h4V6"/>
              <rect x="7" y="9" width="10" height="12" rx="2"/>
              <path d="M20 12l2 3-2 3M2 15h3"/>
            </svg>
          </div>
          <span class="samay-apply-step-num">Step 02</span>
          <p class="samay-apply-step-text">Hold the bottle 15-20 cm away.</p>
