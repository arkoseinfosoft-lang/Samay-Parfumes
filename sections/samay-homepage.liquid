<!-- ==========================================================================
     4. PRODUCT VARIATIONS SECTION (FIKN SIGNATURE ELIXIR CARDS)
     ========================================================================== -->
<section class="samay-products-section ep-section" id="collection">
  <div class="container">
    <div class="ep-header">
      <div class="ep-kicker">THE SIGNATURE COLLECTION</div>
      <h2 class="ep-section-title">SAMAY COLLECTION</h2>
    </div>

    <div class="ep-grid">
      {%- assign handle_single = all_products['samay-zyro-50ml-eau-de-parfum'].handle | default: all_products['samay-zayro-50ml-eau-de-parfum'].handle | default: 'samay-zyro-50ml-eau-de-parfum' -%}
      {%- assign handle_duo = all_products['samay-zyro-duo-combo-2-in-1'].handle | default: all_products['samay-zayro-duo-combo-2-in-1'].handle | default: 'samay-zyro-duo-combo-2-in-1' -%}
      {%- assign handle_trio = all_products['samay-zyro-grand-trio-3-in-1-combo'].handle | default: all_products['samay-zayro-grand-trio-3-in-1-combo'].handle | default: 'samay-zyro-grand-trio-3-in-1-combo' -%}
      {%- assign handle_list = handle_single | append: ',' | append: handle_duo | append: ',' | append: handle_trio | split: ',' -%}
      {%- assign rendered_count = 0 -%}

      {%- for handle in handle_list -%}
        {%- assign product = all_products[handle] -%}
        {%- if product != blank and product.title != blank -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign price = variant.price -%}
          {%- assign compare_at = nil -%}
          {%- assign discount_percent = 0 -%}
          {%- if variant.compare_at_price and variant.compare_at_price > price -%}
            {%- assign compare_at = variant.compare_at_price -%}
            {%- assign diff = compare_at | minus: price -%}
            {%- assign discount_percent = diff | times: 100 | divided_by: compare_at -%}
          {%- endif -%}

          <article class="ep-card is-active" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
            <div class="ep-media">
              <div class="ep-media__viewport">
                <div class="ep-media__inner">
                  {%- assign custom_product_img = 'samay-product-single.jpg' | asset_url -%}
                  {%- if forloop.index == 2 or handle contains 'duo' -%}
                    {%- assign custom_product_img = 'samay-product-duo.jpg' | asset_url -%}
                  {%- elsif forloop.index == 3 or handle contains 'trio' -%}
                    {%- assign custom_product_img = 'samay-product-trio.jpg' | asset_url -%}
                  {%- endif -%}
                  <img 
                    src="{{ custom_product_img }}" 
                    alt="{{ product.title | escape }}" 
                    class="ep-img"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                </div>
              </div>
            </div>

            <div class="ep-info">
              <a href="{{ product.url | default: '#collection' }}" class="ep-title-link">{{ product.title | upcase }}</a>

              <div class="ep-price-row">
                <span class="ep-price">{{ price | money }}</span>
                {%- if compare_at and compare_at > price -%}
                  <span class="ep-price-compare">{{ compare_at | money }}</span>
                  <span class="ep-price-discount">-{{ discount_percent }}%</span>
                {%- endif -%}
              </div>

              <button 
                type="button" 
                class="ep-add samay-add-cart-btn" 
                data-variant-id="{{ variant.id }}"
                onclick="window.samayCart && window.samayCart.add({{ variant.id }}, 1)"
              >
                ADD TO CART
              </button>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}

      {%- if rendered_count == 0 -%}
        {%- for product in collections.all.products -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign price = variant.price -%}
          {%- assign compare_at = nil -%}
          {%- assign discount_percent = 0 -%}
          {%- if variant.compare_at_price and variant.compare_at_price > price -%}
            {%- assign compare_at = variant.compare_at_price -%}
            {%- assign diff = compare_at | minus: price -%}
            {%- assign discount_percent = diff | times: 100 | divided_by: compare_at -%}
          {%- endif -%}

          <article class="ep-card is-active" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
            <div class="ep-media">
              <div class="ep-media__viewport">
                <div class="ep-media__inner">
                  {%- assign custom_product_img = 'samay-product-single.jpg' | asset_url -%}
                  {%- if forloop.index == 2 or product.handle contains 'duo' -%}
                    {%- assign custom_product_img = 'samay-product-duo.jpg' | asset_url -%}
                  {%- elsif forloop.index == 3 or product.handle contains 'trio' -%}
                    {%- assign custom_product_img = 'samay-product-trio.jpg' | asset_url -%}
                  {%- endif -%}
                  <img 
                    src="{{ custom_product_img }}" 
                    alt="{{ product.title | escape }}" 
                    class="ep-img"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                </div>
              </div>
            </div>

            <div class="ep-info">
              <a href="{{ product.url | default: '#collection' }}" class="ep-title-link">{{ product.title | upcase }}</a>

              <div class="ep-price-row">
                <span class="ep-price">{{ price | money }}</span>
                {%- if compare_at and compare_at > price -%}
                  <span class="ep-price-compare">{{ compare_at | money }}</span>
                  <span class="ep-price-discount">-{{ discount_percent }}%</span>
                {%- endif -%}
              </div>

              <button 
                type="button" 
                class="ep-add samay-add-cart-btn" 
                data-variant-id="{{ variant.id }}"
                onclick="window.samayCart && window.samayCart.add({{ variant.id }}, 1)"
              >
                ADD TO CART
              </button>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

