<!-- ==========================================================================
     8. INTERACTIVE CONTACT US & FAQ (ON HOMEPAGE)
     ========================================================================== -->
<section class="samay-contact-section" id="contact">
  <div class="container">
    <div class="samay-sec-header">
      {%- if section.settings.contact_eyebrow != blank -%}
        <div class="samay-sec-eyebrow">{{ section.settings.contact_eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.contact_title != blank -%}
        <h2 class="samay-sec-title">{{ section.settings.contact_title }}</h2>
      {%- endif -%}
      {%- if section.settings.contact_subtitle != blank -%}
        <p class="samay-sec-subtitle">
          {{ section.settings.contact_subtitle }}
        </p>
      {%- endif -%}
      <div class="samay-sec-divider"></div>
      {%- assign hp_email = section.settings.contact_email | default: 'samayparfume@gmail.com' -%}
      {%- assign hp_phone = section.settings.contact_phone | default: '+91 93058 88555' -%}
      {%- assign clean_hp_phone = hp_phone | replace: ' ', '' | replace: '-', '' -%}
      <div class="samay-contact-direct-bar">
        <span>Direct Assistance:</span>
        <a href="tel:{{ clean_hp_phone | escape }}" class="samay-contact-direct-item" aria-label="Call {{ hp_phone | escape }}">
          <span>✆</span> {{ hp_phone | escape }}
        </a>
        <span class="samay-contact-direct-sep">•</span>
        <a href="mailto:{{ hp_email | escape }}" class="samay-contact-direct-item" aria-label="Email {{ hp_email | escape }}">
          <span>✉</span> {{ hp_email | escape }}
        </a>
      </div>
    </div>

    <div class="samay-contact-grid">
      <!-- Contact Form -->
      <div class="samay-contact-form-box">
        {%- if section.settings.contact_form_heading != blank -%}
          <h3 class="serif-font samay-contact-heading">{{ section.settings.contact_form_heading }}</h3>
        {%- endif -%}
        {% form 'contact', id: 'samayContactForm' %}
          {% if form.posted_successfully? %}
            <div class="samay-form-success">
              {{ section.settings.contact_success_message }}
            </div>
          {% elsif form.errors %}
            <div class="samay-form-error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormName">Full Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="samay-form-input" placeholder="e.g. Rahul Sharma" value="{{ form.name | default: customer.name | escape }}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormEmail">Email Address</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="samay-form-input" placeholder="e.g. rahul@example.com" value="{{ form.email | default: customer.email | escape }}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormPhone">Phone / WhatsApp</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" class="samay-form-input" placeholder="+91 98765 43210" value="{{ form.phone | default: customer.phone | escape }}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormTopic">Inquiry Topic</label>
            {%- capture newline %}
{% endcapture -%}
            {%- assign topic_options = section.settings.contact_topics | split: newline -%}
            <select id="ContactFormTopic" name="contact[Inquiry Topic]" class="samay-form-select">
              {%- for topic in topic_options -%}
                {%- assign clean_topic = topic | strip -%}
                {%- if clean_topic != blank -%}
                  <option value="{{ clean_topic | escape }}">{{ clean_topic }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormMessage">Your Message</label>
            <textarea id="ContactFormMessage" name="contact[body]" class="samay-form-textarea" rows="4" placeholder="How can we assist you today?" required>{{ form.body | escape }}</textarea>
          </div>
          {%- if section.settings.contact_btn_label != blank -%}
            <button type="submit" class="samay-btn samay-btn--gold samay-btn--full">
              {{ section.settings.contact_btn_label }}
            </button>
          {%- endif -%}
        {% endform %}

      </div>

      <!-- FAQ Accordion -->
      <div class="samay-faq-box" id="faq">
        {%- if section.settings.faq_heading != blank -%}
          <h3 class="serif-font samay-faq-heading">{{ section.settings.faq_heading }}</h3>
        {%- endif -%}

        {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
        {%- if faq_blocks.size > 0 -%}
          {%- for block in faq_blocks -%}
            {%- assign is_open = false -%}
            {%- if forloop.first or block.settings.is_open -%}
              {%- assign is_open = true -%}
            {%- endif -%}
            <div class="samay-faq-item{% if is_open %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="samay-faq-question" id="FaqQuestion{{ forloop.index }}" aria-expanded="{{ is_open }}" aria-controls="FaqAnswer{{ forloop.index }}">
                <span>{{ block.settings.question }}</span>
                <span class="samay-faq-icon">+</span>
              </button>
              <div class="samay-faq-answer" id="FaqAnswer{{ forloop.index }}" role="region" aria-labelledby="FaqQuestion{{ forloop.index }}">
                {{ block.settings.answer }}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="samay-faq-item is-open">
            <button type="button" class="samay-faq-question" id="FaqQuestion1" aria-expanded="true" aria-controls="FaqAnswer1">
              <span>How long does Zayro last on skin and clothes?</span>
              <span class="samay-faq-icon">+</span>
            </button>
            <div class="samay-faq-answer" id="FaqAnswer1" role="region" aria-labelledby="FaqQuestion1">
              Zayro is formulated as an Eau de Parfum (EDP) with 15-20% perfume oil concentration. On moisturized skin, it lasts 6 to 8 hours. On clothing and outerwear, its rich amber and agarwood base notes can linger throughout the day.
            </div>
          </div>

          <div class="samay-faq-item">
            <button type="button" class="samay-faq-question" id="FaqQuestion2" aria-expanded="false" aria-controls="FaqAnswer2">
              <span>What is the difference between the single and combo packs?</span>
              <span class="samay-faq-icon">+</span>
            </button>
            <div class="samay-faq-answer" id="FaqAnswer2" role="region" aria-labelledby="FaqQuestion2">
              The fragrance formulation in all 3 editions is identical (Zayro 50ml). The 2-in-1 Duo combo and 3-in-1 Grand Trio offer substantial volume savings per bottle and include complimentary luxury presentation gift boxes.
            </div>
          </div>

          <div class="samay-faq-item">
            <button type="button" class="samay-faq-question" id="FaqQuestion3" aria-expanded="false" aria-controls="FaqAnswer3">
              <span>What are the shipping times and is delivery free?</span>
              <span class="samay-faq-icon">+</span>
            </button>
            <div class="samay-faq-answer" id="FaqAnswer3" role="region" aria-labelledby="FaqQuestion3">
              Yes, express shipping is 100% complimentary across all pin codes in India for all orders. Metro cities (Delhi NCR, Mumbai, Bangalore, Pune) typically receive delivery in 2-3 business days. All other locations take 3-5 business days with live tracking provided via SMS and email notifications.
            </div>
          </div>

          <div class="samay-faq-item">
            <button type="button" class="samay-faq-question" id="FaqQuestion4" aria-expanded="false" aria-controls="FaqAnswer4">
              <span>What is your damaged replacement guarantee?</span>
              <span class="samay-faq-icon">+</span>
            </button>
            <div class="samay-faq-answer" id="FaqAnswer4" role="region" aria-labelledby="FaqQuestion4">
              Every bottle is packaged inside thick shock-resistant transit cushions. In the rare event of transit damage or leakage, simply share a quick photo with our team within 48 hours and we will dispatch a brand-new replacement bottle immediately with zero hassle.
            </div>
          </div>

          <div class="samay-faq-item">
            <button type="button" class="samay-faq-question" id="FaqQuestion5" aria-expanded="false" aria-controls="FaqAnswer5">
              <span>Is Cash on Delivery (COD) supported?</span>
              <span class="samay-faq-icon">+</span>
            </button>
            <div class="samay-faq-answer" id="FaqAnswer5" role="region" aria-labelledby="FaqQuestion5">
              Yes! We accept Cash on Delivery (COD), UPI (Google Pay, PhonePe, Paytm), and all major credit/debit cards during checkout.
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- FAQ Structured Data (Schema.org) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- if faq_blocks.size > 0 -%}
        {%- for block in faq_blocks -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }
        {%- endfor -%}
      {%- else -%}
        {
          "@type": "Question",
          "name": "How long does Zayro last on skin and clothes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zayro is formulated as an Eau de Parfum (EDP) with 15-20% perfume oil concentration. On moisturized skin, it lasts 6 to 8 hours. On clothing and outerwear, its rich amber and agarwood base notes can linger throughout the day."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the single and combo packs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The fragrance formulation in all 3 editions is identical (Zayro 50ml). The 2-in-1 Duo combo and 3-in-1 Grand Trio offer substantial volume savings per bottle and include complimentary luxury presentation gift boxes."
          }
        },
        {
          "@type": "Question",
          "name": "What are the shipping times and is delivery free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, express shipping is 100% complimentary across all pin codes in India for all orders. Metro cities (Delhi NCR, Mumbai, Bangalore, Pune) typically receive delivery in 2-3 business days. All other locations take 3-5 business days with live tracking provided via SMS and email notifications."
          }
        },
        {
          "@type": "Question",
          "name": "What is your damaged replacement guarantee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every bottle is packaged inside thick shock-resistant transit cushions. In the rare event of transit damage or leakage, simply share a quick photo with our team within 48 hours and we will dispatch a brand-new replacement bottle immediately with zero hassle."
          }
        },
        {
          "@type": "Question",
          "name": "Is Cash on Delivery (COD) supported?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We accept Cash on Delivery (COD), UPI (Google Pay, PhonePe, Paytm), and all major credit/debit cards during checkout."
          }
        }
      {%- endif -%}
    ]
  }
  </script>
</section>

