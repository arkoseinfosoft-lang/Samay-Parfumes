<!-- ==========================================================================
     10. VIP NEWSLETTER
     ========================================================================== -->
<section class="samay-newsletter-section">
  <div class="container">
    <div class="samay-newsletter-box">
      <div class="samay-sec-eyebrow" style="color: var(--gold-light);">PRIVATE PRIVILEGES</div>
      <h2>Join The Samay Circle</h2>
      <p>
        Enjoy a complimentary 10% welcome privilege on your next reserve, private access to small-batch launches, and bespoke olfactory invitations.
      </p>
      {% form 'customer', class: 'samay-newsletter-form-container' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <div style="color: var(--gold-light); font-weight: 500; font-size: 0.95rem; text-align: center; margin-bottom: 16px;">
            ✦ Welcome to the Samay Circle! Your VIP privilege code has been reserved.
          </div>
        {% elsif form.errors %}
          <div style="color: #ff8a80; font-size: 0.88rem; text-align: center; margin-bottom: 16px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="samay-newsletter-form">
          <input 
            type="email" 
            name="contact[email]" 
            class="samay-newsletter-input" 
            placeholder="Enter your email address" 
            value="{% if customer %}{{ customer.email }}{% endif %}" 
            required
            aria-label="Email address"
          >
          <button type="submit" class="samay-btn samay-btn--gold">
            SUBSCRIBE
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

<!-- ==========================================================================
     11. SLIDE-OUT CART DRAWER & OVERLAY
     ========================================================================== -->
<div class="samay-cart-drawer-overlay" id="samayCartOverlay">
  <div class="samay-cart-drawer">
    <div class="samay-drawer-header">
      <h3 class="samay-drawer-title">Shopping Bag</h3>
      <button type="button" class="samay-drawer-close" onclick="window.samayCart && window.samayCart.close()" aria-label="Close Shopping Bag">✕</button>
    </div>

    <div class="samay-drawer-body">
      <div class="samay-cart-free-shipping">
        ✦ <strong>FREE EXPRESS SHIPPING</strong> unlocked on your order!
      </div>
      <div id="samayCartDrawerItems">
        <!-- Rendered dynamically by samay.js -->
      </div>
    </div>

    <div class="samay-drawer-footer">
      <div class="samay-drawer-subtotal">
        <span>Estimated Total</span>
        <strong id="samayCartSubtotal">₹0</strong>
      </div>
      <div class="samay-drawer-tax-note">Taxes & shipping calculated at checkout</div>
      <form action="{{ routes.cart_url | default: '/cart' }}" method="post" id="samayCartDrawerForm" class="samay-cart-drawer-form" style="width: 100%; margin: 0;">
        <button type="submit" name="checkout" class="samay-btn samay-btn--gold samay-btn--full" style="font-size: 0.95rem; padding: 18px 24px; cursor: pointer; border: none; width: 100%;">
          PROCEED TO CHECKOUT
        </button>
      </form>
    </div>
  </div>
</div>



