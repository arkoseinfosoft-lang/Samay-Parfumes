<!-- ==========================================================================
     6. THE NOTES (OLFACTORY PYRAMID)
     ========================================================================== -->
<section class="samay-notes-section" id="notes">
  <div class="container">
    <div class="samay-sec-header">
      {%- if section.settings.notes_eyebrow != blank -%}
        <div class="samay-sec-eyebrow">{{ section.settings.notes_eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.notes_title != blank -%}
        <h2 class="samay-sec-title">{{ section.settings.notes_title }}</h2>
      {%- endif -%}
      {%- if section.settings.notes_subtitle != blank -%}
        <p class="samay-sec-subtitle">
          {{ section.settings.notes_subtitle }}
        </p>
      {%- endif -%}
      <div class="samay-sec-divider"></div>
    </div>

    <!-- Notes Cards -->
    <div class="samay-notes-grid">
      {%- assign note_blocks = section.blocks | where: 'type', 'olfactory_note' -%}
      {%- if note_blocks.size > 0 -%}
        {%- for block in note_blocks -%}
          <div class="samay-note-card{% if block.settings.is_featured or forloop.index == 2 %} is-center{% endif %}" {{ block.shopify_attributes }}>
            <div class="samay-note-stage">{{ block.settings.stage }}</div>
            <h3 class="samay-note-headline">{{ block.settings.headline }}</h3>
            <span class="samay-note-timing">{{ block.settings.timing }}</span>
            <div class="samay-note-ingredients">
              {{ block.settings.ingredients | newline_to_br }}
            </div>
            <p class="samay-note-description">
              {{ block.settings.description }}
            </p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- TOP NOTES -->
        <div class="samay-note-card">
          <div class="samay-note-stage">Act I · Top Notes</div>
          <h3 class="samay-note-headline">What you smell first</h3>
          <span class="samay-note-timing">0 to 45 MINUTES</span>
          <div class="samay-note-ingredients">
            Bergamot · Sun-Ripened Mandarin<br>
            Pink Peppercorn · Crisp Juniper Berry
          </div>
          <p class="samay-note-description">
            An electrifying burst of sparkling citrus spiced with freshly ground pepper that commands instant intrigue.
          </p>
        </div>

        <!-- HEART NOTES -->
        <div class="samay-note-card is-center">
          <div class="samay-note-stage">Act II · Heart Notes</div>
          <h3 class="samay-note-headline">The soul of the scent</h3>
          <span class="samay-note-timing">45 mins to 5 hours</span>
          <div class="samay-note-ingredients">
            Lavender · Golden Ambergris Accord<br>
            Smoked Green Cardamom · Velvet Orris
          </div>
          <p class="samay-note-description">
            A hypnotic warmth settles in. Rich aromatic spices intertwine with royal florals to project confidence and refined sophistication.
          </p>
        </div>

        <!-- BASE NOTES -->
        <div class="samay-note-card">
          <div class="samay-note-stage">Act III · Base Notes</div>
          <h3 class="samay-note-headline">What lingers on skin</h3>
          <span class="samay-note-timing">5 to 8 HOURS</span>
          <div class="samay-note-ingredients">
            Smoked Oud · Cedarwood<br>
            Warm Vanilla · Golden Amber Resin
          </div>
          <p class="samay-note-description">
            An unforgettable, deeply addictive trail of rich woods and sweet resinous amber that remains vivid throughout your day.
          </p>
        </div>
      {%- endif -%}
    </div>

    <!-- Raw Ingredients Visual Showcase -->
    <div class="samay-ingredients-showcase">
      <div class="samay-showcase-image-wrap">
        {%- if section.settings.showcase_image != blank -%}
          <img 
            src="{{ section.settings.showcase_image | image_url: width: 1200 }}" 
            alt="{{ section.settings.showcase_image.alt | default: section.settings.showcase_title | escape }}" 
            class="samay-showcase-image"
            width="1200"
            height="670"
            loading="lazy"
          >
        {%- else -%}
          <img 
            src="{{ 'zayro-notes.webp' | asset_url }}" 
            alt="Zayro fragrance ingredients: bergamot, lavender, oud and cedarwood" 
            class="samay-showcase-image"
            width="1200"
            height="670"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <div class="samay-showcase-content">
        {%- if section.settings.showcase_eyebrow != blank -%}
          <div class="samay-sec-eyebrow">{{ section.settings.showcase_eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.showcase_title != blank -%}
          <h2 class="serif-font samay-showcase-title">{{ section.settings.showcase_title }}</h2>
        {%- endif -%}
        {%- if section.settings.showcase_desc != blank -%}
          <p>
            {{ section.settings.showcase_desc }}
          </p>
        {%- endif -%}
        <div class="samay-specs-list">
          {%- assign spec_blocks = section.blocks | where: 'type', 'spec_item' -%}
          {%- if spec_blocks.size > 0 -%}
            {%- for block in spec_blocks -%}
              {%- if block.settings.value != blank -%}
                <div class="samay-spec-box" {{ block.shopify_attributes }}>
                  <div class="samay-spec-title">{{ block.settings.title }}</div>
                  <div class="samay-spec-val">{{ block.settings.value }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="samay-spec-box">
              <div class="samay-spec-title">CONCENTRATION</div>
              <div class="samay-spec-val">15-20% Perfume Oil</div>
            </div>
            <div class="samay-spec-box">
              <div class="samay-spec-title">LONGEVITY</div>
              <div class="samay-spec-val">6-8 Hours Wear</div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     6B. APPLICATION RITUAL (HOW TO APPLY)
     ========================================================================== -->
<section class="samay-apply-section" id="how-to-apply">
  <div class="container">
    <div class="samay-apply-box">
      <div class="samay-sec-eyebrow samay-sec-eyebrow--gold">{{ section.settings.how_to_apply_eyebrow | default: 'THE RITUAL' }}</div>
      <h2 class="serif-font samay-apply-title">{{ section.settings.how_to_apply_title | default: 'How to Apply' }}</h2>

      <div class="samay-apply-grid">
