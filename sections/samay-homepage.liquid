<!-- ==========================================================================
     8. ABOUT US (ON HOMEPAGE)
     ========================================================================== -->
<section class="samay-about-section" id="about">
  <div class="container">
    <div class="samay-about-grid">
      <div class="samay-about-text">
        <div class="samay-sec-eyebrow">THE MAISON</div>
        <h2>The Story of <em style="font-style: italic; font-weight: 300;">Samay Parfumes</em></h2>
        <p>
          In Sanskrit and Hindi, <strong>Samay</strong> means <em>Time</em>. Our perfumery was born from a singular obsession: creating fragrances that refuse to be forgotten. While fashion changes every season, memories ignited by scent echo forever.
        </p>
        <p>
          Every bottle of Zyro is meticulously crafted in small batches in India, marrying traditional Indian distillation of rare resins and agarwood with French Grasse perfumery techniques. We do not mass produce; each flacon is macerated in dark temperature-controlled cellars for over 60 days to ensure a rich, intoxicating trail.
        </p>

        <div class="samay-about-stats">
          <div class="samay-stat-item">
            <strong>15-20%</strong>
            <span>Perfume Oil</span>
          </div>
          <div class="samay-stat-item">
            <strong>60+</strong>
            <span>Days Maceration</span>
          </div>
          <div class="samay-stat-item">
            <strong>100%</strong>
            <span>Cruelty Free</span>
          </div>
        </div>
      </div>

      <div class="samay-about-media">
        <img 
          src="{{ 'samay-story-atelier.jpg' | asset_url }}" 
          alt="The Story of Samay Parfumes Atelier"
          loading="lazy"
          width="768"
          height="1024"
        >
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     9. INTERACTIVE CONTACT US & FAQ (ON HOMEPAGE)
     ========================================================================== -->
<section class="samay-contact-section" id="contact">
  <div class="container">
    <div class="samay-sec-header">
      <div class="samay-sec-eyebrow">ASSISTANCE & CONCIERGE</div>
      <h2 class="samay-sec-title">We are Here <em>For You</em></h2>
      <p class="samay-sec-subtitle">
        Have a question about your order, tracking, or choosing between our single bottle and combos? Reach out directly to our concierge team.
      </p>
      <div class="samay-sec-divider"></div>
    </div>

    <div class="samay-contact-grid">
      <!-- Contact Form -->
      <div class="samay-contact-form-box">
        <h3 class="serif-font" style="font-size: 1.8rem; margin-bottom: 20px;">Send a Message</h3>
        {% form 'contact', id: 'samayContactForm' %}
          {% if form.posted_successfully? %}
            <div style="padding: 16px; margin-bottom: 20px; background: rgba(46, 125, 50, 0.08); border: 1px solid #2e7d32; color: #2e7d32; border-radius: 4px; font-weight: 600; text-align: center; font-size: 0.92rem;">
              ✦ Thank you! Our perfumery concierge will contact you within 2 hours.
            </div>
          {% elsif form.errors %}
            <div style="padding: 16px; margin-bottom: 20px; background: rgba(211, 47, 47, 0.08); border: 1px solid #d32f2f; color: #d32f2f; border-radius: 4px; font-size: 0.88rem;">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormName">Full Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="samay-form-input" placeholder="e.g. Rahul Sharma" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormEmail">Email Address</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="samay-form-input" placeholder="e.g. rahul@example.com" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormPhone">Phone / WhatsApp</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" class="samay-form-input" placeholder="+91 98765 43210" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" required>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormTopic">Inquiry Topic</label>
            <select id="ContactFormTopic" name="contact[Inquiry Topic]" class="samay-form-select">
              <option value="Order Status & Tracking">Order Status & Tracking</option>
              <option value="Advice on 2-in-1 or 3-in-1 Combo">Advice on 2-in-1 or 3-in-1 Combo</option>
              <option value="Corporate / Bulk Gifting">Corporate / Bulk Gifting</option>
              <option value="General Fragrance Inquiry">General Fragrance Inquiry</option>
            </select>
          </div>
          <div class="samay-form-group">
            <label class="samay-form-label" for="ContactFormMessage">Your Message</label>
            <textarea id="ContactFormMessage" name="contact[body]" class="samay-form-textarea" rows="4" placeholder="How can our concierge assist you today?" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
          <button type="submit" class="samay-btn samay-btn--gold samay-btn--full">
            SEND MESSAGE
          </button>
        {% endform %}

      </div>

      <!-- FAQ Accordion -->
      <div class="samay-faq-box">
        <h3 class="serif-font" style="font-size: 1.8rem; margin-bottom: 20px;">Frequently Asked Questions</h3>

        <div class="samay-faq-item is-open">
          <button type="button" class="samay-faq-question">
            <span>How long does Zyro last on skin and clothes?</span>
            <span class="samay-faq-icon">+</span>
          </button>
          <div class="samay-faq-answer">
            Zyro is formulated as an Eau de Parfum (EDP) with 15-20% perfume oil concentration. On moisturized skin, it lasts 6 to 8 hours. On clothing and outerwear, its rich amber and agarwood base notes can linger throughout the day.
          </div>
        </div>

        <div class="samay-faq-item">
          <button type="button" class="samay-faq-question">
            <span>What is the difference between the single and combo packs?</span>
            <span class="samay-faq-icon">+</span>
          </button>
          <div class="samay-faq-answer">
            The fragrance formulation in all 3 editions is identical (Zyro 50ml). The 2-in-1 Duo combo and 3-in-1 Grand Trio offer substantial volume discounts (up to ₹2,100 in savings) and include complimentary luxury presentation gift boxes.
          </div>
        </div>

        <div class="samay-faq-item">
          <button type="button" class="samay-faq-question">
            <span>What are the shipping times and is delivery free?</span>
            <span class="samay-faq-icon">+</span>
          </button>
          <div class="samay-faq-answer">
            Yes, express shipping is 100% complimentary across all pin codes in India for all orders. Metro cities (Delhi NCR, Mumbai, Bangalore, Pune) typically receive delivery in 2-3 business days. All other locations take 3-5 business days with live tracking provided via SMS and email notifications.
          </div>
        </div>

        <div class="samay-faq-item">
          <button type="button" class="samay-faq-question">
            <span>What is your damaged replacement guarantee?</span>
            <span class="samay-faq-icon">+</span>
          </button>
          <div class="samay-faq-answer">
            Every bottle is packaged inside thick shock-resistant transit cushions. In the rare event of transit damage or leakage, simply share a quick photo with our concierge team within 48 hours and we will dispatch a brand-new replacement bottle immediately with zero hassle.
          </div>
        </div>

        <div class="samay-faq-item">
          <button type="button" class="samay-faq-question">
            <span>Is Cash on Delivery (COD) supported?</span>
            <span class="samay-faq-icon">+</span>
          </button>
          <div class="samay-faq-answer">
            Yes! We accept Cash on Delivery (COD), UPI (Google Pay, PhonePe, Paytm), and all major credit/debit cards during checkout.
          </div>
        </div>
      </div>
    </div>
  </div>

