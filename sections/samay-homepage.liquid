<!-- ==========================================================================
     6. THE NOTES (OLFACTORY PYRAMID)
     ========================================================================== -->
<section class="samay-notes-section" id="notes">
  <div class="container">
    <div class="samay-sec-header">
      <div class="samay-sec-eyebrow">THE OLFACTORY PYRAMID</div>
      <h2 class="samay-sec-title">What's in <em>Your Bottle?</em></h2>
      <p class="samay-sec-subtitle">
        Zyro is crafted as an evolving three-act composition that transforms seamlessly with your skin chemistry over 6-8 hours.
      </p>
      <div class="samay-sec-divider"></div>
    </div>

    <!-- 3 Notes Cards -->
    <div class="samay-notes-grid">
      <!-- TOP NOTES -->
      <div class="samay-note-card">
        <div class="samay-note-stage">ACT I · TOP NOTES</div>
        <h3 class="samay-note-headline">What you smell first</h3>
        <span class="samay-note-timing">0 to 45 MINUTES</span>
        <div class="samay-note-ingredients">
          Italian Bergamot · Sun-Ripened Mandarin<br>
          Pink Peppercorn · Crisp Juniper Berry
        </div>
        <p class="samay-note-description">
          An electrifying burst of sparkling Mediterranean citrus spiced with freshly ground pepper that commands instant intrigue.
        </p>
      </div>

      <!-- HEART NOTES -->
      <div class="samay-note-card is-center">
        <div class="samay-note-stage">ACT II · HEART NOTES</div>
        <h3 class="samay-note-headline">The soul of the scent</h3>
        <span class="samay-note-timing">45 MINS to 5 HOURS</span>
        <div class="samay-note-ingredients">
          French Lavender · Golden Ambergris<br>
          Smoked Green Cardamom · Velvet Orris
        </div>
        <p class="samay-note-description">
          A hypnotic warmth settles in. Rich aromatic spices intertwine with royal florals to project confidence and refined sophistication.
        </p>
      </div>

      <!-- BASE NOTES -->
      <div class="samay-note-card">
        <div class="samay-note-stage">ACT III · BASE NOTES</div>
        <h3 class="samay-note-headline">What lingers on skin</h3>
        <span class="samay-note-timing">5 to 8 HOURS</span>
        <div class="samay-note-ingredients">
          Aged Indonesian Oud · Virginia Cedarwood<br>
          Bourbon Vanilla · Golden Amber Resin
        </div>
        <p class="samay-note-description">
          An unforgettable, deeply addictive trail of rare woods and sweet resinous amber that remains vivid throughout your day.
        </p>
      </div>
    </div>

    <!-- Raw Ingredients Visual Showcase -->
    <div class="samay-ingredients-showcase">
      <div class="samay-showcase-image-wrap">
        <img 
          src="{{ 'zyro-notes.jpg' | asset_url }}" 
          alt="Raw artisan perfume ingredients of Zyro" 
          class="samay-showcase-image"
          width="1376"
          height="768"
          loading="lazy"
        >
      </div>
      <div class="samay-showcase-content">
        <div class="samay-sec-eyebrow">SOURCED FROM MASTER TERROIRS</div>
        <h3 class="serif-font" style="font-size: 2.2rem; margin-bottom: 16px;">Pure Artisanal Ingredients</h3>
        <p>
          We refuse to cut corners with diluted fillers. Zyro is formulated with raw Grasse bergamot oils, wild Indonesian agarwood harvested sustainably, and hand-scraped Bourbon vanilla pods.
        </p>
        <div class="samay-specs-list">
          <div class="samay-spec-box">
            <div class="samay-spec-title">CONCENTRATION</div>
            <div class="samay-spec-val">15-20% Perfume Oil</div>
          </div>
          <div class="samay-spec-box">
            <div class="samay-spec-title">LONGEVITY</div>
            <div class="samay-spec-val">6-8 Hours Wear</div>
          </div>
          <div class="samay-spec-box">
            <div class="samay-spec-title">SILLAGE</div>
            <div class="samay-spec-val">Arm's Length Aura</div>
          </div>
          <div class="samay-spec-box">
            <div class="samay-spec-title">FORMULATION</div>
            <div class="samay-spec-val">IFRA Certified Safe</div>
          </div>
        </div>
      </div>
    </div>
  </div>
