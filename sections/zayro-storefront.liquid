        <div class="details-feature-item">
          <div class="feature-icon-circle">&#10022;</div>
          <div class="feature-text-wrap">
            <span class="feature-title">EVERY OCCASION</span>
            <span class="feature-sub">Day-to-night signature</span>
          </div>
