<!-- ═══ 9. INTERACTIVE FORMULA & COMPOUND DOSSIER MODAL ═══ -->
<div id="zayro-formula-modal" class="zayro-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Official Formulation Dossier">
  <div class="zayro-modal-backdrop" id="formula-modal-backdrop"></div>
  <div class="zayro-modal-panel">
    <button type="button" id="formula-modal-close" class="modal-close-btn" aria-label="Close formula modal">&times;</button>
    <span class="eyebrow-tag">OFFICIAL ATELIER DOSSIER</span>
    <h3 class="heading-section" style="color:var(--sand-50); margin-bottom:0.75rem;">THE ZAYRO ALCHEMY</h3>
    <p style="font-size:0.86rem; color:var(--text-light-muted); line-height:1.7;">
      Exact maceration recipe &amp; compounding schedule engineered for Samay Parfumes. 80% V/V Fine Perfumer's Alcohol enriched with rare fixatives and molecular isolates.
    </p>

    <div class="formula-grid">
      <!-- Compound Mixture Sheet -->
      <div>
        <h4 style="font-family:var(--font-sans); font-size:0.80rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold); margin-bottom:1rem;">
          Compound Mixture &bull; 1000 g
        </h4>
        <table class="formula-table">
          <thead>
            <tr>
              <th>Ingredient</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Pineapple Platinum</td><td>5 g</td></tr>
            <tr><td>Bergamot (Calabria)</td><td>5 g</td></tr>
            <tr><td>Blackcurrant Bud</td><td>5 g</td></tr>
            <tr><td>Crisp Apple Extract</td><td>5 g</td></tr>
            <tr><td>Birch Tar (Frankincense)</td><td>5 g</td></tr>
            <tr><td>Patchouli (Roohaloud)</td><td>5 g</td></tr>
            <tr><td>Jasmin ABS</td><td>2 g</td></tr>
            <tr><td>White Musk Accord</td><td>10 g</td></tr>
            <tr><td>Oakmoss Absolute</td><td>1 g</td></tr>
            <tr><td>Ambrogeosh (MCO)</td><td>1 g</td></tr>
            <tr><td>Vanilla V3 Balsamic</td><td>10 g</td></tr>
            <tr><td>Creed Aventus Accord</td><td>30 g</td></tr>
            <tr><td>Ambraxon Molecular</td><td>10 g</td></tr>
            <tr><td>Javanol Sandalwood</td><td>5 g</td></tr>
            <tr><td>Jasmin Sambac TR</td><td>3 g</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Ethanol Mixture Sheet -->
      <div>
        <h4 style="font-family:var(--font-sans); font-size:0.80rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold); margin-bottom:1rem;">
          Ethanol Mixture Sheet
        </h4>
        <table class="formula-table">
          <thead>
            <tr>
              <th>Component</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Ethanol II</td><td>1 kg</td></tr>
            <tr><td>Galaxolite Pure</td><td>100 g</td></tr>
            <tr><td>Tonalite Power</td><td>25 g</td></tr>
            <tr><td>Eversnel Powder</td><td>10 g</td></tr>
            <tr><td>Evanillin</td><td>10 g</td></tr>
            <tr><td>Timorol</td><td>100 g</td></tr>
            <tr><td>Javanol Pure</td><td>50 g</td></tr>
            <tr><td>Ambraxon Powder</td><td>50 g</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ═══ 10. SLIDE-OUT CART DRAWER ═══ -->
<div id="zayro-cart-drawer" class="zayro-cart-drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Shopping Bag">
  <div id="cart-drawer-backdrop" class="cart-drawer-backdrop"></div>
  <aside class="cart-drawer-panel">
    <div class="cart-drawer-header">
      <h3 class="cart-drawer-title">Shopping Bag</h3>
      <button type="button" id="cart-drawer-close" class="cart-drawer-close" aria-label="Close cart">&times;</button>
    </div>

    <div id="cart-drawer-body" class="cart-drawer-body">
      {% if cart.item_count == 0 %}
        <div style="text-align:center; padding: 4rem 1.5rem;">
          <p style="font-family:var(--font-serif); font-size:1.35rem; font-style:italic; color:var(--text-muted); margin-bottom:1.75rem;">Your shopping bag is currently empty.</p>
          <a href="#packs" class="btn-luxury-solid" data-close-cart-link>Discover The Packs</a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-item-row" data-line-key="{{ item.key }}">
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title }}" class="cart-item-thumb">
            <div class="cart-item-info">
              <h4 class="cart-item-title">{{ item.product.title }}</h4>
              {% unless item.product.has_only_default_variant %}
                <p style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">{{ item.variant.title }}</p>
              {% endunless %}
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
              <div class="cart-qty-ctrl">
                <button type="button" class="cart-qty-btn" data-action="minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}">−</button>
                <span class="cart-qty-val">{{ item.quantity }}</span>
                <button type="button" class="cart-qty-btn" data-action="plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="cart-drawer-footer">
      <div class="cart-subtotal-row">
        <span>Subtotal</span>
        <span id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size:0.72rem; color:var(--text-muted); margin-bottom:1.25rem;">
        Shipping, taxes, and promotional discounts calculated at checkout.
      </p>
      <a href="/checkout" class="btn-luxury-solid cart-checkout-btn">
        PROCEED TO CHECKOUT &rarr;
      </a>
    </div>
  </aside>
</div>

{{ 'zayro.js' | asset_url | script_tag }}

