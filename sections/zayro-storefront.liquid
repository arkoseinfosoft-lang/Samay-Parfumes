{% comment %}
  =============================================================
  SAMAY PARFUMES — ZAYRO LUXURY STOREFRONT
  Editorial Mediterranean Haute Parfumerie Experience
  =============================================================
{% endcomment %}

{{ 'zayro.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign main_product = section.settings.featured_product | default: collections.all.products.first
  assign variant_single = main_product.variants[0]
  assign variant_duo    = main_product.variants[1] | default: variant_single
  assign variant_triple = main_product.variants[2] | default: variant_single
-%}

<!-- ═══ 1. BESPOKE LUXURY NAVIGATION HEADER ═══ -->
<header id="zayro-header" class="zayro-nav-header" role="banner">
  <div class="zayro-container zayro-nav-inner">
    <a href="#fragrance" class="zayro-brand-wrap" aria-label="Samay Parfumes — Home">
      <img
        src="{{ 'logo-black.png' | asset_url }}"
        alt="Samay Parfumes Clock Emblem"
        class="zayro-brand-logo-img"
        width="38"
        height="38"
        loading="eager"
      >
      <span class="zayro-brand-text">{{ section.settings.brand_title | default: 'SAMAY PARFUMES' }}</span>
    </a>

    <nav class="zayro-nav-links" aria-label="Main Navigation">
      <a href="#fragrance" class="zayro-nav-link is-active">THE FRAGRANCE</a>
      <a href="#story" class="zayro-nav-link">THE STORY</a>
      <a href="#packs" class="zayro-nav-link">PACKS</a>
      <a href="#faq" class="zayro-nav-link">FAQ</a>
      <a href="#contact" class="zayro-nav-link">CONTACT</a>
    </nav>

    <div class="zayro-nav-actions">
      <a href="#packs" class="btn-luxury-outline nav-order-btn">ORDER NOW &rarr;</a>
      <button type="button" id="nav-cart-btn" class="nav-cart-btn" aria-label="Open Shopping Bag">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span id="nav-cart-badge" class="nav-cart-badge">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- ═══ 2. HERO SECTION (#fragrance) ═══ -->
<section id="fragrance" class="zayro-hero-section" aria-label="Zayro Eau de Parfum">
  <img
    src="{{ 'hero-reference-upscaled.jpg' | asset_url }}"
    alt="Zayro 50ml Eau de Parfum on Raw Travertine Stone Pedestal overlooking Mediterranean"
    class="hero-backdrop-img"
    loading="eager"
    width="2048"
    height="717"
  >

  <!-- Semantic SEO Heading for search engines and accessibility -->
  <div class="visually-hidden">
    <h1>ZAYRO &mdash; Eau de Parfum 50 ML</h1>
    <p>A fragrance for the moments that stay.</p>
  </div>

  <div class="zayro-container hero-content-grid">
    <div class="hero-left-spacer" aria-hidden="true"></div>

    <!-- Interactive Chapter Hotspots positioned over the right navigation rail -->
    <nav class="hero-chapter-hotspots" aria-label="Storefront Chapters">
      <a href="#fragrance" class="chapter-hotspot is-active" title="The Fragrance"></a>
      <a href="#story" class="chapter-hotspot" title="The Story"></a>
      <a href="#packs" class="chapter-hotspot" title="Choose Your Pack"></a>
      <a href="#details" class="chapter-hotspot" title="Bottle Details"></a>
      <a href="#faq" class="chapter-hotspot" title="Frequently Asked Questions"></a>
    </nav>
  </div>
</section>

<!-- ═══ 3. SECTION: THE FRAGRANCE / NOTES (#notes) ═══ -->
<section id="notes" class="zayro-notes-section" aria-label="Fragrance Notes Accord">
  <img
    src="{{ 'notes-botanicals.jpg' | asset_url }}"
    alt="Botanical Still Life: Bergamot, French Lavender, Agarwood, Golden Amber"
    class="notes-backdrop-img"
    loading="lazy"
    width="1792"
    height="1024"
  >
  <div class="notes-vignette" aria-hidden="true"></div>

  <div class="zayro-container notes-content-grid">
    <div class="notes-left-intro">
      <span class="eyebrow-tag">THE FRAGRANCE</span>
      <h2 class="heading-section notes-title">A QUIET COMPOSITION.</h2>
      <p class="notes-desc">
        Zayro is crafted with a delicate balance of fresh, spicy and woody notes &mdash; a scent that feels familiar yet unforgettable. Macerated slowly in small batches for remarkable longevity and sillage.
      </p>
      <button type="button" class="btn-text-arrow btn-text-arrow--light" data-open-formula>
        &rarr; EXPLORE THE FORMULA & NOTES
      </button>
    </div>

    <div class="notes-pyramid-cols">
      <!-- TOP NOTES -->
      <div class="note-tier-card">
        <div class="note-tier-badge">TOP</div>
        <ul class="note-items-list">
          <li class="note-item">
            Bergamot
            <span class="note-item-sub">Calabrian Cold-Expressed</span>
          </li>
          <li class="note-item">
            Pineapple Platinum
            <span class="note-item-sub">Juicy Luminous Accord</span>
          </li>
          <li class="note-item">
            Blackcurrant
            <span class="note-item-sub">Burgundy Bud Absolute</span>
          </li>
          <li class="note-item">
            Crisp Apple
            <span class="note-item-sub">Himalayan Mountain Orchard</span>
          </li>
        </ul>
      </div>

      <!-- HEART NOTES -->
      <div class="note-tier-card">
        <div class="note-tier-badge">HEART</div>
        <ul class="note-items-list">
          <li class="note-item">
            Sacred Jasmine
            <span class="note-item-sub">Jasmine Absolute</span>
          </li>
          <li class="note-item">
            Jasmine Sambac
            <span class="note-item-sub">Indolic Temple Blossom</span>
          </li>
          <li class="note-item">
            Patchouli
            <span class="note-item-sub">Roohaloud Aged Oak</span>
          </li>
          <li class="note-item">
            Smoked Birch Tar
            <span class="note-item-sub">Pyrolyzed Frankincense</span>
          </li>
        </ul>
      </div>

      <!-- BASE NOTES -->
      <div class="note-tier-card">
        <div class="note-tier-badge">BASE</div>
        <ul class="note-items-list">
          <li class="note-item">
            White Musk
            <span class="note-item-sub">Galaxolide & Clean Skin</span>
          </li>
          <li class="note-item">
            Javanol
            <span class="note-item-sub">Mysore Sandalwood Heart</span>
          </li>
          <li class="note-item">
            Ambroxan
            <span class="note-item-sub">Radiant Saline Amber</span>
          </li>
          <li class="note-item">
            Oakmoss & Vanilla
            <span class="note-item-sub">Velvety Forest Balsam</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 4. SECTION: THE STORY (#story) ═══ -->
<section id="story" class="zayro-story-section" aria-label="Brand Story">
  <img
    src="{{ 'story-rocks.jpg' | asset_url }}"
    alt="Atmospheric dark geological rocks at twilight"
    class="story-backdrop-img"
    loading="lazy"
    width="1792"
    height="1024"
  >
  <div class="story-vignette" aria-hidden="true"></div>

  <div class="zayro-container story-content-grid">
    <div class="story-left">
      <span class="eyebrow-tag">THE STORY</span>
      <h2 class="heading-section story-title">INSPIRED BY TIME.</h2>
      <p class="story-body-text">
        Samay Parfumes is a celebration of moments, memories and milestones. Zayro represents the perfect blend of tradition and modernity &mdash; a fragrance made for those who value their time and make every moment count. Handcrafted and formulated in India with rare international aromatics.
      </p>
      <a href="#packs" class="btn-text-arrow btn-text-arrow--light">
        &rarr; ACQUIRE THE FLACON &rarr;
      </a>
    </div>

    <div class="story-right">
      <blockquote class="story-poetic-quote">
        SOME MOMENTS DESERVE TO LAST.
      </blockquote>
      <div class="story-origin-badge">
        <span>&#10022;</span>
        <span>Atelier: Kanpur, India &bull; 80% V/V Concentration</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 5. SECTION: CHOOSE YOUR PACK / PRICING (#packs) ═══ -->
<section id="packs" class="zayro-packs-section" aria-label="Choose Your Pack">
  <div class="zayro-container">
    <div class="packs-header-row">
      <div class="packs-header-left">
        <span class="eyebrow-tag eyebrow-tag--muted">CHOOSE YOUR PACK</span>
        <h2 class="heading-section packs-title">ONE ESSENCE.<br>THREE WAYS.</h2>
      </div>
      <p class="packs-header-subtitle">
        The same signature fragrance,<br>for every version of you.
      </p>
    </div>

    <div class="packs-cards-grid">
      <!-- 1. SINGLE PACK -->
      <article class="pack-card">
        <h3 class="pack-card-title">SINGLE PACK</h3>
        <p class="pack-card-vol">50 ML</p>
        <div class="pack-card-visual-wrap">
          <img
            src="{{ 'pack-single.jpg' | asset_url }}"
            alt="Single 50ml Zayro Bottle on Sandstone Pedestal"
            class="pack-card-img"
            loading="lazy"
            width="600"
            height="480"
          >
        </div>
        <div class="pack-price-row">
          <span class="pack-price-current">₹1,499</span>
        </div>
        <button
          type="button"
          class="btn-luxury-solid pack-card-btn"
          data-add-to-cart
          data-variant-id="{{ variant_single.id | default: '' }}"
          data-quantity="1"
        >
          ADD TO CART &rarr;
        </button>
      </article>

      <!-- 2. DUO PACK -->
      <article class="pack-card is-featured">
        <span class="pack-card-tag">Save 7%</span>
        <h3 class="pack-card-title">DUO PACK</h3>
        <p class="pack-card-vol">2 &times; 50 ML</p>
        <div class="pack-card-visual-wrap">
          <img
            src="{{ 'pack-duo.jpg' | asset_url }}"
            alt="Duo Pack (Two 50ml Zayro Bottles) on Sandstone Pedestal"
            class="pack-card-img"
            loading="lazy"
            width="600"
            height="480"
          >
        </div>
        <div class="pack-price-row">
          <span class="pack-price-current">₹2,799</span>
          <span class="pack-price-compare">₹2,998</span>
        </div>
        <button
          type="button"
          class="btn-luxury-solid pack-card-btn"
          data-add-to-cart
          data-variant-id="{{ variant_duo.id | default: variant_single.id | default: '' }}"
          data-quantity="2"
        >
          ADD TO CART &rarr;
        </button>
      </article>

      <!-- 3. TRIPLE PACK -->
      <article class="pack-card">
        <span class="pack-card-tag">Save 11%</span>
        <h3 class="pack-card-title">TRIPLE PACK</h3>
        <p class="pack-card-vol">3 &times; 50 ML</p>
        <div class="pack-card-visual-wrap">
          <img
            src="{{ 'pack-triple.jpg' | asset_url }}"
            alt="Triple Pack (Three 50ml Zayro Bottles) on Sandstone Pedestal"
            class="pack-card-img"
            loading="lazy"
            width="600"
            height="480"
          >
        </div>
        <div class="pack-price-row">
          <span class="pack-price-current">₹3,999</span>
          <span class="pack-price-compare">₹4,497</span>
        </div>
        <button
          type="button"
          class="btn-luxury-solid pack-card-btn"
          data-add-to-cart
          data-variant-id="{{ variant_triple.id | default: variant_single.id | default: '' }}"
          data-quantity="3"
        >
          ADD TO CART &rarr;
        </button>
      </article>
    </div>
  </div>
</section>

<!-- ═══ 6. SECTION: FLACON CRAFTSMANSHIP / DETAILS (#details) ═══ -->
