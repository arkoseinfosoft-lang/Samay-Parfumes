<!-- ═══ 7. SECTION: FAQ & CONTACT (#faq & #contact) ═══ -->
<section id="faq" class="zayro-faq-section" aria-label="FAQ and Concierge">
  <div class="zayro-container faq-section-grid">
    <!-- Left Column: Title -->
    <div class="faq-left-col">
      <h2 class="faq-main-heading">FREQUENTLY<br>ASKED<br>QUESTIONS</h2>
      <a href="#contact" class="faq-circle-btn" aria-label="Jump to Contact">
        &rarr;
      </a>
    </div>

    <!-- Center Column: Accordions -->
    <div class="faq-accordions-col" role="region" aria-label="Accordion list">
      <div class="faq-item is-open">
        <button type="button" class="faq-question-btn">
          <span>How long does the fragrance last?</span>
          <span class="faq-toggle-icon">&plus;</span>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-content">
            Formulated as an Eau de Parfum with 80% V/V concentration and 20% pure compound oils, Zayro delivers 12 to 16+ hours of evocative projection on skin, gently lingering on textiles for several days.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-question-btn">
          <span>What are the main notes in Zayro?</span>
          <span class="faq-toggle-icon">&plus;</span>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-content">
            Zayro opens with crisp bergamot, pineapple platinum, and blackcurrant, evolves through rich patchouli and sacred jasmine sambac, and rests upon an enduring base of white musk, oakmoss, javanol, and Madagascar vanilla.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-question-btn">
          <span>Is this suitable for daily use?</span>
          <span class="faq-toggle-icon">&plus;</span>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-content">
            Yes. The balanced harmony of bright zesty top notes and smooth woody drydown makes Zayro exceptionally versatile for daytime professional elegance and intimate evening occasions.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-question-btn">
          <span>Do you offer COD (Cash on Delivery)?</span>
          <span class="faq-toggle-icon">&plus;</span>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-content">
            Yes! Cash on Delivery is available across most serviceable pincodes in India alongside secure UPI, Debit/Credit Card, and Net Banking checkout options.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-question-btn">
          <span>Is it authentic and certified?</span>
          <span class="faq-toggle-icon">&plus;</span>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-content">
            Every bottle is 100% authentic, batch-numbered, vegan friendly, and cruelty free, crafted under strict artisan quality control in Kanpur, India.
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact -->
    <div id="contact" class="faq-contact-col">
      <span class="eyebrow-tag contact-eyebrow">STILL HAVE A QUESTION?</span>
      <h3 class="contact-heading">GET IN TOUCH.</h3>
      <p class="contact-subtext">We'd love to hear from you.</p>

      <div class="contact-details-list">
        <div class="contact-detail-row">
          <span>&#9993;</span>
          <a href="mailto:samayparfumes@gmail.com">samayparfumes@gmail.com</a>
        </div>
        <div class="contact-detail-row">
          <span>&#9742;</span>
          <a href="tel:+919305888555">+91 9305888555</a>
        </div>
        <div class="contact-detail-row">
          <span>&#9873;</span>
          <span>Keshavpuram, Kalyanpur, Kanpur, Uttar Pradesh - 208017</span>
        </div>
      </div>

      <a href="mailto:samayparfumes@gmail.com" class="btn-luxury-outline">
        CONTACT US &rarr;
      </a>
    </div>
  </div>
</section>

