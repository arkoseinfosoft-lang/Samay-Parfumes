            <div class="footer-panel-layout" data-footer-reveal>
              <div class="footer-brand-stage">
                <span class="footer-monogram" aria-hidden="true">S</span>
                <h2 class="footer-brand-title">{{ block.settings.brand_name | default: 'SAMAY PARFUMES' }}</h2>
                <p class="footer-brand-tagline">{{ block.settings.tagline | default: 'Time Captured in Scent' }}</p>
                <div class="footer-rule" aria-hidden="true"></div>
                <p class="footer-atelier-note">{{ block.settings.atelier_text | default: 'Fine Fragrances Distilled in Grasse &amp; New Delhi • Limited Edition Extraits' }}</p>
              </div>

              <div class="footer-links-grid">
                <div class="footer-col">
                  <span class="footer-col-heading">NAVIGATION</span>
                  <ul class="footer-col-links">
                    <li><a href="#home" data-nav-target="home">01 Home</a></li>
                    <li><a href="#about" data-nav-target="about">02 About</a></li>
                    <li><a href="#notes" data-nav-target="notes">03 Notes</a></li>
                    <li><a href="#bottle" data-nav-target="bottle">04 The Bottle</a></li>
                    <li><a href="#reviews" data-nav-target="reviews">05 Reviews</a></li>
                    <li><a href="#faq" data-nav-target="faq">06 FAQ</a></li>
                    <li><a href="#contact" data-nav-target="contact">07 Contact</a></li>
                  </ul>
                </div>

                <div class="footer-col">
                  <span class="footer-col-heading">LEGAL &amp; POLICIES</span>
                  <ul class="footer-col-links">
                    <li><button type="button" class="policy-link-btn" data-policy="shipping">Shipping Policy</button></li>
                    <li><button type="button" class="policy-link-btn" data-policy="refund">Return &amp; Refund Policy</button></li>
                    <li><button type="button" class="policy-link-btn" data-policy="privacy">Privacy Policy</button></li>
                    <li><button type="button" class="policy-link-btn" data-policy="terms">Terms of Service</button></li>
                  </ul>
                </div>

                <div class="footer-col">
                  <span class="footer-col-heading">ATELIER SOCIAL</span>
                  <ul class="footer-col-links">
                    <li><a href="{{ block.settings.instagram_url | default: 'https://instagram.com/samayparfumes' }}" target="_blank" rel="noopener">Instagram</a></li>
                    {%- if block.settings.twitter_url != blank -%}
                      <li><a href="{{ block.settings.twitter_url }}" target="_blank" rel="noopener">Twitter / X</a></li>
                    {%- endif -%}
                    {%- if block.settings.facebook_url != blank -%}
                      <li><a href="{{ block.settings.facebook_url }}" target="_blank" rel="noopener">Facebook</a></li>
                    {%- endif -%}
                    <li><a href="mailto:concierge@samayparfumes.com">Private Concierge</a></li>
                  </ul>
                </div>
              </div>

              <div class="footer-bottom-bar">
                <span class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} {{ block.settings.brand_name | default: 'Samay Parfumes' }}. All rights reserved.</span>
                <span class="footer-craft">Hand-Distilled &amp; Authenticated</span>
              </div>
            </div>
          </section>

        {%- else -%}
