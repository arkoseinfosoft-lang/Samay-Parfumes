                  <span class="footer-col-heading">NAVIGATION</span>
                  <ul class="footer-col-links">
                    <li><a href="#home" data-nav-target="home">01 Home</a></li>
                    <li><a href="#about" data-nav-target="about">02 About</a></li>
                    <li><a href="#notes" data-nav-target="notes">03 Notes</a></li>
                    <li><a href="#bottle" data-nav-target="bottle">04 The Bottle</a></li>
                    <li><a href="#faq" data-nav-target="faq">05 FAQ</a></li>
                    <li><a href="#contact" data-nav-target="contact">06 Contact</a></li>
                  </ul>
