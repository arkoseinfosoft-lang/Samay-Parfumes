{%- comment -%}
  samay-horizontal.liquid
  Samay Parfumes — Luxury horizontal scroll experience
  Block-based schema so panels are reorderable in the theme editor.
{%- endcomment -%}

{%- liquid
  assign num_panels = section.blocks.size | default: 6
  assign label_url  = 'label.webp'  | asset_url
  assign ref_url    = 'bottle-ref.webp' | asset_url
-%}

{{- 'samay.css' | asset_url | stylesheet_tag -}}

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"
  }
}
</script>

{%- comment -%} ── CDN Libraries ── {%- endcomment -%}
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" defer></script>

{%- comment -%} ── Site config object ── {%- endcomment -%}
<script>
  window.SamayConfig = {
    numPanels:  {{ num_panels }},
    labelUrl:   {{ label_url | json }},
    refUrl:     {{ ref_url   | json }},
  };
</script>

{%- comment -%} ── Grain overlay ── {%- endcomment -%}
<div id="samay-grain" aria-hidden="true"></div>

{%- comment -%} ── Custom cursor (desktop only) ── {%- endcomment -%}
<div id="samay-cursor" aria-hidden="true"></div>

{%- comment -%} ── Preloader ── {%- endcomment -%}
<div id="samay-preloader" role="status" aria-label="Loading Samay Parfumes">
  <span class="preloader-wordmark">{{ section.settings.brand_name | default: 'Samay' }}</span>
  <div class="preloader-bar-track" aria-hidden="true">
    <div class="preloader-bar-fill"></div>
  </div>
</div>

{%- comment -%} ── Three.js Canvas ── {%- endcomment -%}
<canvas id="samay-canvas" aria-hidden="true"></canvas>

{%- comment -%} ── Progress bar ── {%- endcomment -%}
<div id="samay-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Page progress">
  <div id="samay-progress-fill"></div>
</div>

{%- comment -%} ── Panel counter ── {%- endcomment -%}
<div id="samay-counter" aria-live="polite" aria-atomic="true">
  <span class="current">01</span> / {{ num_panels | prepend: '0' | slice: -2, 2 }}
</div>

{%- comment -%} ── Drag hint ── {%- endcomment -%}
<div id="drag-hint" role="note" aria-label="Drag to rotate bottle 360 degrees">
  <span class="drag-hint-icon" aria-hidden="true"></span>
  <span>Drag to rotate 360°</span>
</div>

{%- comment -%} ── Scroll hint (desktop) ── {%- endcomment -%}
<div class="scroll-hint" aria-hidden="true">
  <div class="scroll-hint-line"></div>
</div>

{%- comment -%} ── Root / Track ── {%- endcomment -%}
<div id="samay-root" class="full-width" role="main">
  <div id="samay-track-outer">
    <div id="samay-track">

      {%- for block in section.blocks -%}
        {%- assign panel_index = forloop.index0 -%}
        {%- assign panel_num   = forloop.index -%}

        {%- if block.type == 'hero' -%}
          {%- comment -%} ═══ PANEL 1: HERO ═══ {%- endcomment -%}
          <section
            class="samay-panel panel-hero"
            data-panel="{{ panel_index }}"
            {{ block.shopify_attributes }}
            aria-label="Hero — {{ block.settings.heading | default: 'Samay Parfumes' }}"
          >
            <div class="hero-content">
              <span class="hero-eyebrow">{{ block.settings.eyebrow | default: 'Fine Fragrances' }}</span>

              <h1 class="hero-heading" aria-label="{{ block.settings.heading | default: 'Time Captured in Scent' }}">
                {%- assign heading_words = block.settings.heading | default: 'Time Captured in Scent' | split: ' ' -%}
                {%- assign line_groups = '' | split: '' -%}
                {%- comment -%} Split heading into lines of ~2 words each {%- endcomment -%}
                {%- assign word_count = heading_words.size -%}
                {%- if word_count <= 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      <span class="word">{{ word }}&nbsp;</span>
                    {%- endfor -%}
                  </span>
                {%- elsif word_count == 3 -%}
                  <span class="line">
                    <span class="word">{{ heading_words[0] }}&nbsp;</span>
                    <span class="word">{{ heading_words[1] }}&nbsp;</span>
                  </span>
                  <span class="line">
                    <span class="word" style="color:var(--gold)">{{ heading_words[2] }}</span>
                  </span>
                {%- else -%}
                  {%- assign half = word_count | divided_by: 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 < half -%}
                        <span class="word">{{ word }}&nbsp;</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 >= half -%}
                        <span class="word"{% if forloop.last %} style="color:var(--gold)"{% endif %}>{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </h1>

              <p class="hero-sub">{{ block.settings.subtext | default: 'A rare alchemy of ancient woods, sacred resins and the golden hour — distilled into a single breath.' }}</p>

              <a
                href="{{ block.settings.cta_url | default: '/collections/all' }}"
                class="hero-cta"
                aria-label="{{ block.settings.cta_label | default: 'Explore Collection' }}"
              >
                <span>{{ block.settings.cta_label | default: 'Explore Collection' }}</span>
                <span class="cta-arrow" aria-hidden="true"></span>
              </a>
            </div>
          </section>

        {%- elsif block.type == 'story' -%}
          {%- comment -%} ═══ PANEL 2: STORY ═══ {%- endcomment -%}
          <section
            class="samay-panel panel-story"
            data-panel="{{ panel_index }}"
            {{ block.shopify_attributes }}
            aria-label="Story — {{ block.settings.heading | default: 'Our Story' }}"
          >
            {%- comment -%} Chapter number — decorative back-plane text {%- endcomment -%}
            <span class="story-chapter-bg" aria-hidden="true">02</span>

            {%- comment -%} Left col — text content {%- endcomment -%}
            <div class="story-content" data-story-reveal>
              <header class="story-header">
                <span class="story-eyebrow">{{ block.settings.eyebrow | default: 'The Origin' }}</span>
                <h2 class="story-heading">
                  {%- assign story_words = block.settings.heading | default: 'Born from Silence' | split: ' ' -%}
                  {%- for word in story_words -%}
                    <span class="s-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                  {%- endfor -%}
                </h2>
                <div class="story-rule" aria-hidden="true"></div>
              </header>

              <div class="story-body">
                <p class="story-p story-p--lead">{{ block.settings.paragraph_1 | default: 'Samay was born in the lantern-lit lanes of old Delhi, where a perfumers notebook and a grandmothers memory became the seed of something rare.' }}</p>
                <p class="story-p">{{ block.settings.paragraph_2 | default: 'We source only what the season offers willingly — raw oud from Assams oldest agarwood groves, Mysore sandalwood aged in silence, Bulgarian rose absolute hand-pressed at dawn.' }}</p>
                <p class="story-p">{{ block.settings.paragraph_3 | default: 'Every bottle holds a specific hour — not just a fragrance. An atmosphere you can return to.' }}</p>
              </div>

              {%- comment -%} Timeline milestones {%- endcomment -%}
              <ol class="story-timeline" aria-label="Brand milestones">
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_1_year | default: '2018' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_1_text | default: 'First batch distilled in a copper athar still' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_2_year | default: '2021' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_2_text | default: 'Awarded India Finest Artisan Fragrance' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_3_year | default: '2024' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_3_text | default: 'Expanded to 28 countries across 4 continents' }}</span>
                </li>
              </ol>

              {%- if block.settings.cta_label != blank -%}
                <a
                  href="{{ block.settings.cta_url | default: '/pages/about' }}"
                  class="story-cta"
                  aria-label="{{ block.settings.cta_label }}"
                >
                  <span>{{ block.settings.cta_label }}</span>
                  <span class="story-cta-line" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            </div>

            {%- comment -%} Right col — atmospheric image / decorative {%- endcomment -%}
            <div class="story-visual" aria-hidden="true" data-story-visual>
              <div class="story-visual-inner">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                            {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 768px) 80vw, 40vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="900"
                    height="1200"
                    loading="lazy"
                    class="story-img"
                  >
                {%- else -%}
                  {%- comment -%} Decorative SVG / CSS art when no image is set {%- endcomment -%}
                  <div class="story-art">
                    <div class="art-circle art-circle--lg"></div>
                    <div class="art-circle art-circle--md"></div>
                    <div class="art-circle art-circle--sm"></div>
                    <div class="art-lines">
                      {%- for i in (1..12) -%}
                        <div class="art-line" style="--i:{{ i }}"></div>
                      {%- endfor -%}
                    </div>
                    <div class="art-monogram">S</div>
                  </div>
                {%- endif -%}
                <div class="story-visual-overlay"></div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'notes' -%}
          {%- comment -%} ═══ PANEL 3: FRAGRANCE NOTES ═══ {%- endcomment -%}
          <section
            class="samay-panel panel-notes"
            data-panel="{{ panel_index }}"
            {{ block.shopify_attributes }}
            aria-label="Fragrance Notes"
          >
            {%- comment -%} Ghost chapter number {%- endcomment -%}
            <span class="notes-chapter-bg" aria-hidden="true">03</span>

            {%- comment -%} Left col — intro {%- endcomment -%}
            <div class="notes-intro" data-notes-reveal>
              <span class="notes-eyebrow">{{ block.settings.eyebrow | default: 'The Composition' }}</span>
              <h2 class="notes-heading">
                {%- assign n_words = block.settings.heading | default: 'A Living Accord' | split: ' ' -%}
                {%- for word in n_words -%}
                  <span class="n-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                {%- endfor -%}
              </h2>
              <div class="notes-rule" aria-hidden="true"></div>
              <p class="notes-desc">{{ block.settings.description | default: 'A compound of 1000 g, matured in ethanol and rare musks. Every element chosen for the hour it inhabits.' }}</p>

              {%- comment -%} Concentration tag {%- endcomment -%}
              <div class="notes-concentration">
                <span class="conc-label">{{ block.settings.concentration_label | default: 'Concentration' }}</span>
                <span class="conc-value">{{ block.settings.concentration | default: 'Eau de Parfum Intense' }}</span>
              </div>
            </div>

            {%- comment -%} Right col — pyramid tiers {%- endcomment -%}
            <div class="notes-pyramid" aria-label="Fragrance pyramid" data-notes-reveal>

              {%- comment -%} TOP TIER {%- endcomment -%}
              <div class="notes-tier notes-tier--top" data-tier="top">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.top_label | default: 'Top Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.top_sub | default: 'The first breath — bright &amp; fleeting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Top notes">
                  {%- assign top_notes = block.settings.top_notes | default: 'Bergamot,Blackcurrant,Apple,Pineapple Platinum' | split: ',' -%}
                  {%- for note in top_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              {%- comment -%} HEART TIER {%- endcomment -%}
              <div class="notes-tier notes-tier--heart" data-tier="heart">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.heart_label | default: 'Heart Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.heart_sub | default: 'The soul — warm &amp; enduring' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Heart notes">
                  {%- assign heart_notes = block.settings.heart_notes | default: 'Jasmine Absolute,Jasmine Sambac,Birch Tar,Patchouli' | split: ',' -%}
                  {%- for note in heart_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              {%- comment -%} BASE TIER {%- endcomment -%}
              <div class="notes-tier notes-tier--base" data-tier="base">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.base_label | default: 'Base Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.base_sub | default: 'The memory — deep &amp; long-lasting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Base notes">
                  {%- assign base_notes = block.settings.base_notes | default: 'White Musk,Vanilla,Ambraxon,Javanol (Sandalwood),Ambergris,Oakmoss' | split: ',' -%}
                  {%- for note in base_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

            </div>{%- comment -%}.notes-pyramid{%- endcomment -%}
          </section>

        {%- elsif block.type == 'product' -%}
          {%- comment -%} ═══ PANEL 4: THE BOTTLE / PRODUCT ═══ {%- endcomment -%}
          <section
            class="samay-panel panel-product"
            data-panel="{{ panel_index }}"
            {{ block.shopify_attributes }}
            aria-label="The Bottle — {{ block.settings.title | default: 'Samay Extrait de Parfum' }}"
          >
            {%- comment -%} Ghost chapter number {%- endcomment -%}
            <span class="product-chapter-bg" aria-hidden="true">04</span>

            <div class="product-layout" data-product-reveal>

              {%- comment -%} ── LEFT FLANK: Craftsmanship & Specs ── {%- endcomment -%}
              <div class="product-flank product-flank--specs">
                <header class="product-header">
                  <span class="product-eyebrow">{{ block.settings.eyebrow | default: 'The Artifact' }}</span>
                  <h2 class="product-heading">
                    {%- assign p_words = block.settings.heading | default: 'Sculpted in Darkness' | split: ' ' -%}
                    {%- for word in p_words -%}
                      <span class="p-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                    {%- endfor -%}
                  </h2>
                  <div class="product-rule" aria-hidden="true"></div>
                </header>

                <p class="product-desc">{{ block.settings.description | default: 'An architectural flacon sculpted from heavyweight smoked French glass, crowned with a 24-karat gold-gilded magnetic stopper. Each flacon is individually numbered.' }}</p>

                <div class="product-specs-list" aria-label="Flacon specifications">
                  <div class="product-spec-item" style="--psi:0">
                    <span class="spec-label">{{ block.settings.spec_1_label | default: 'Vessel Architecture' }}</span>
                    <span class="spec-val">{{ block.settings.spec_1_val | default: 'Smoked French crystal, 420g solid base' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:1">
                    <span class="spec-label">{{ block.settings.spec_2_label | default: 'The Stopper' }}</span>
                    <span class="spec-val">{{ block.settings.spec_2_val | default: 'Solid Zamak alloy, hand-gilded in 24K gold' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:2">
                    <span class="spec-label">{{ block.settings.spec_3_label | default: 'Maceration Period' }}</span>
                    <span class="spec-val">{{ block.settings.spec_3_val | default: '180 days in dark French oak casks' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:3">
                    <span class="spec-label">{{ block.settings.spec_4_label | default: 'Origin & Batch' }}</span>
                    <span class="spec-val">{{ block.settings.spec_4_val | default: 'Limited Run of 500 bottles • Grasse & New Delhi' }}</span>
                  </div>
                </div>
              </div>

              {%- comment -%} ── CENTER STAGE: 3D Bottle Reticle & Spatial Framing ── {%- endcomment -%}
              <div class="product-stage" aria-hidden="true">
                <div class="stage-reticle">
                  <div class="reticle-circle reticle-circle--outer"></div>
                  <div class="reticle-circle reticle-circle--inner"></div>
                  <div class="reticle-cross reticle-cross--h"></div>
                  <div class="reticle-cross reticle-cross--v"></div>
                </div>
                <div class="stage-coords">
                  <span class="coord-tag">FLACON NO. 01 / 500</span>
                  <span class="coord-drag-hint">DRAG TO INSPECT 360°</span>
                </div>
              </div>

              {%- comment -%} ── RIGHT FLANK: Commerce & Acquisition Card ── {%- endcomment -%}
              <div class="product-flank product-flank--commerce">
                <div class="product-card">
                  {%- if block.settings.badge_text != blank -%}
                    <div class="product-badge-wrap">
                      <span class="product-badge">
                        <span class="badge-dot" aria-hidden="true"></span>
                        {{ block.settings.badge_text }}
                      </span>
                    </div>
                  {%- endif -%}

                  <div class="product-title-group">
                    <h3 class="product-card-title">{{ block.settings.title | default: 'Samay Extrait de Parfum' }}</h3>
                    <span class="product-card-sub">{{ block.settings.subtitle | default: 'Batch No. 01 — Rare Harvest' }}</span>
                  </div>

                  <div class="product-price-row">
                    <div class="price-stack">
                      <span class="product-price" data-price-display>{{ block.settings.price | default: '$280' }}</span>
                      {%- if block.settings.compare_at_price != blank -%}
                        <span class="product-compare-price">{{ block.settings.compare_at_price }}</span>
                      {%- endif -%}
                    </div>
                    <span class="product-volume" data-volume-display>{{ block.settings.volume | default: '100 ML — 3.4 FL. OZ.' }}</span>
                  </div>

                  {%- comment -%} Volume / Size Selector {%- endcomment -%}
                  <div class="product-size-selector" role="group" aria-label="Select Volume">
                    <span class="selector-label">Volume:</span>
                    <div class="size-options">
                      <button
                        type="button"
                        class="size-pill is-selected"
                        data-size="100ml"
                        data-price="{{ block.settings.price | default: '$280' }}"
                        data-volume="100 ML — 3.4 FL. OZ."
                        aria-pressed="true"
                      >
                        100 ML
                      </button>
                      <button
                        type="button"
                        class="size-pill"
                        data-size="50ml"
                        data-price="{{ block.settings.price_50ml | default: '$190' }}"
                        data-volume="50 ML — 1.7 FL. OZ."
                        aria-pressed="false"
                      >
                        50 ML
                      </button>
                    </div>
                  </div>

                  {%- comment -%} Action CTAs {%- endcomment -%}
                  <div class="product-cta-group">
                    <a
                      href="{{ block.settings.cta_url | default: '/products/samay-extrait-de-parfum' }}"
                      class="product-primary-cta"
                      aria-label="{{ block.settings.cta_label | default: 'Acquire The Flacon' }}"
                    >
                      <span class="cta-glow-line" aria-hidden="true"></span>
                      <span class="cta-text">{{ block.settings.cta_label | default: 'Acquire The Flacon' }}</span>
                      <span class="cta-arrow" aria-hidden="true"></span>
                    </a>

                    {%- if block.settings.secondary_cta_label != blank -%}
                      <a
                        href="{{ block.settings.secondary_cta_url | default: '/pages/discovery-set' }}"
                        class="product-secondary-cta"
                        aria-label="{{ block.settings.secondary_cta_label }}"
                      >
                        <span>{{ block.settings.secondary_cta_label }}</span>
                        <span class="secondary-cta-arrow" aria-hidden="true">→</span>
                      </a>
                    {%- endif -%}
                  </div>

                  {%- comment -%} Luxury Assurances / Inclusions {%- endcomment -%}
                  <div class="product-inclusions" aria-label="Purchase guarantees">
                    {%- if block.settings.inclusion_1 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_1 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_2 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_2 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_3 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_3 }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                </div>{%- comment -%}.product-card{%- endcomment -%}
              </div>{%- comment -%}.product-flank--commerce{%- endcomment -%}

            </div>{%- comment -%}.product-layout{%- endcomment -%}
          </section>

        {%- elsif block.type == 'reviews' -%}
          {%- comment -%} ═══ PANEL 5: REVIEWS / VOICES ═══ {%- endcomment -%}
          <section
            class="samay-panel panel-reviews"
            data-panel="{{ panel_index }}"
            {{ block.shopify_attributes }}
            aria-label="Voices — {{ block.settings.heading | default: 'Voices in Reverie' }}"
          >
            {%- comment -%} Ghost chapter number {%- endcomment -%}
            <span class="reviews-chapter-bg" aria-hidden="true">05</span>

            <div class="reviews-layout" data-reviews-reveal>

              {%- comment -%} ── LEFT: Editorial Intro & Score ── {%- endcomment -%}
              <div class="reviews-editorial">
                <header class="reviews-header">
                  <span class="reviews-eyebrow">{{ block.settings.eyebrow | default: 'Critical Acclaim' }}</span>
                  <h2 class="reviews-heading">
                    {%- assign r_words = block.settings.heading | default: 'Voices in Reverie' | split: ' ' -%}
                    {%- for word in r_words -%}
                      <span class="r-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                    {%- endfor -%}
                  </h2>
                  <div class="reviews-rule" aria-hidden="true"></div>
                </header>

