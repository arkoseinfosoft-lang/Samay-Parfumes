{%- comment -%} ── Custom cursor script (inline, tiny) ── {%- endcomment -%}
<script>
(function() {
  var cursor = document.getElementById('samay-cursor');
  if (!cursor || window.matchMedia('(hover: none)').matches) return;
  var mx = 0, my = 0;
  document.addEventListener('mousemove', function(e) {
    mx = e.clientX; my = e.clientY;
    cursor.style.transform = 'translate3d(' + (mx - 6) + 'px,' + (my - 6) + 'px,0)';
  });
  document.querySelectorAll('a,button,[data-cursor]').forEach(function(el) {
    el.addEventListener('mouseenter', function() { cursor.classList.add('hovering'); });
    el.addEventListener('mouseleave', function() { cursor.classList.remove('hovering'); });
  });
  document.body.style.cursor = 'none';
})();

// Product volume / price pill switcher
(function() {
  document.addEventListener('click', function(e) {
    var pill = e.target.closest('.size-pill');
    if (!pill) return;
    var group = pill.closest('.size-options');
    if (group) {
      group.querySelectorAll('.size-pill').forEach(function(b) {
        b.classList.remove('is-selected');
        b.setAttribute('aria-pressed', 'false');
      });
    }
    pill.classList.add('is-selected');
    pill.setAttribute('aria-pressed', 'true');
    var card = pill.closest('.product-card');
    if (card) {
      var priceDisplay = card.querySelector('[data-price-display]');
      var volumeDisplay = card.querySelector('[data-volume-display]');
      if (priceDisplay && pill.getAttribute('data-price')) {
        priceDisplay.textContent = pill.getAttribute('data-price');
      }
      if (volumeDisplay && pill.getAttribute('data-volume')) {
        volumeDisplay.textContent = pill.getAttribute('data-volume');
      }
    }
  });
})();

// Reviews card switcher
(function() {
  document.addEventListener('click', function(e) {
    var prevBtn = e.target.closest('.review-nav-btn--prev');
    var nextBtn = e.target.closest('.review-nav-btn--next');
    var dot = e.target.closest('.review-dot');
    var container = e.target.closest('.panel-reviews');
    if (!container) return;
    var cards = container.querySelectorAll('.review-card');
    var dots = container.querySelectorAll('.review-dot');
    var countEl = container.querySelector('.review-counter-current');
    if (!cards.length) return;
    
    var currentIdx = 0;
    cards.forEach(function(c, i) {
      if (c.classList.contains('is-active')) currentIdx = i;
    });

    var targetIdx = currentIdx;
    if (prevBtn) {
      targetIdx = (currentIdx - 1 + cards.length) % cards.length;
    } else if (nextBtn) {
      targetIdx = (currentIdx + 1) % cards.length;
    } else if (dot) {
      targetIdx = parseInt(dot.getAttribute('data-index') || '0', 10);
    } else {
      return;
    }

    cards.forEach(function(c, i) {
      c.classList.toggle('is-active', i === targetIdx);
    });
    dots.forEach(function(d, i) {
      d.classList.toggle('is-active', i === targetIdx);
      d.setAttribute('aria-pressed', i === targetIdx ? 'true' : 'false');
    });
    if (countEl) countEl.textContent = '0' + (targetIdx + 1);
  });
})();
</script>

