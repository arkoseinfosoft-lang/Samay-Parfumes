    {%- else -%}
      <h3>[TO FILL - Terms of Service]</h3>
      <p>[TO FILL - Limited edition batch variations, artisanal production terms]</p>
      <p>[TO FILL - Intellectual property rights and trademark notice]</p>
    {%- endif -%}
