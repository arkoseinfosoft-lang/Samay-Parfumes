    SEO STRUCTURED DATA (JSON-LD)
    ════════════════════════════════════════════════ {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Samay Parfumes",
  "url": {{ shop.url | json }},
  "logo": {{ 'label.webp' | asset_url | json }},
  "description": "Artisan luxury fragrance house crafting rare extraits de parfum.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Concierge",
    "email": "concierge@samayparfumes.com"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Samay Extrait de Parfum",
  "image": {{ 'bottle-ref.webp' | asset_url | json }},
  "description": "An architectural flacon sculpted from heavyweight smoked French crystal with a 24-karat gold-gilded magnetic stopper. 100 ML Eau de Parfum Intense.",
  "brand": {
    "@type": "Brand",
    "name": "Samay Parfumes"
  },
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: 'INR' | json }},
    "price": "22500",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

{%- for block in section.blocks -%}
  {%- if block.type == 'faq' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_first = true -%}
        {%- for i in (1..6) -%}
          {%- assign q_key = 'q' | append: i -%}
          {%- assign a_key = 'a' | append: i -%}
          {%- assign q_val = block.settings[q_key] -%}
          {%- assign a_val = block.settings[a_key] -%}
          {%- if q_val != blank and a_val != blank -%}
            {%- unless faq_first -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ q_val | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ a_val | json }}
              }
            }
            {%- assign faq_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
    </script>
  {%- endif -%}
{%- endfor -%}

