                    <li><button type="button" class="policy-link-btn" data-policy="refund">Return &amp; Refund Policy</button></li>
                    <li><button type="button" class="policy-link-btn" data-policy="privacy">Privacy Policy</button></li>
                    <li><button type="button" class="policy-link-btn" data-policy="terms">Terms of Service</button></li>
                  </ul>
                </div>

                <div class="footer-col">
                  <span class="footer-col-heading">ATELIER SOCIAL</span>
                  <ul class="footer-col-links">
                    <li><a href="{{ block.settings.instagram_url | default: 'https://instagram.com/samayparfumes' }}" target="_blank" rel="noopener">Instagram</a></li>
                    {%- if block.settings.twitter_url != blank -%}
                      <li><a href="{{ block.settings.twitter_url }}" target="_blank" rel="noopener">Twitter / X</a></li>
                    {%- endif -%}
                    {%- if block.settings.facebook_url != blank -%}
