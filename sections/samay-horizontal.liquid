      <p>[TO FILL - Client privacy practices, data protection, and usage]</p>
      <p>[TO FILL - Third-party disclosures and payment security protocols]</p>
    {%- endif -%}
  </div>

  <div id="policy-template-terms" data-title="Terms of Service">
    {%- if shop.terms_of_service.body != blank -%}
