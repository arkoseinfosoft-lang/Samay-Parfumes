{%- comment -%} ════════════════════════════════════════════════
    ROOT / HORIZONTAL TRACK & PANELS
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-root" class="full-width" role="main">
  <div id="samay-track-outer">
    <div id="samay-track">

      {%- for block in section.blocks -%}
        {%- assign panel_index = forloop.index0 -%}
        {%- assign panel_num   = forloop.index -%}

        {%- if block.type == 'hero' -%}
          {%- comment -%} ═══ PANEL 1: HERO (#home) ═══ {%- endcomment -%}
          <section
            id="home"
            class="samay-panel panel-hero"
            data-panel="{{ panel_index }}"
            data-anchor="home"
            {{ block.shopify_attributes }}
            aria-label="Hero — {{ block.settings.heading | default: 'Samay Parfumes' }}"
          >
            <div class="hero-content">
              <span class="hero-eyebrow">{{ block.settings.eyebrow | default: 'Fine Fragrances' }}</span>

              <h1 class="hero-heading" aria-label="{{ block.settings.heading | default: '[TO FILL - Brand Tagline]' }}">
                {%- assign heading_words = block.settings.heading | default: '[TO FILL - Brand Tagline]' | split: ' ' -%}
                {%- assign word_count = heading_words.size -%}
                {%- if word_count <= 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      <span class="word">{{ word }}&nbsp;</span>
                    {%- endfor -%}
                  </span>
                {%- elsif word_count == 3 -%}
                  <span class="line">
                    <span class="word">{{ heading_words[0] }}&nbsp;</span>
                    <span class="word">{{ heading_words[1] }}&nbsp;</span>
                  </span>
                  <span class="line">
                    <span class="word" style="color:var(--gold)">{{ heading_words[2] }}</span>
                  </span>
                {%- else -%}
                  {%- assign half = word_count | divided_by: 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 < half -%}
                        <span class="word">{{ word }}&nbsp;</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 >= half -%}
                        <span class="word"{% if forloop.last %} style="color:var(--gold)"{% endif %}>{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </h1>

              <p class="hero-sub">{{ block.settings.subtext | default: 'A rare alchemy of ancient woods, sacred resins and the golden hour — distilled into a single breath.' }}</p>

              <div class="hero-cta-wrap">
                <a
                  href="#bottle"
                  class="hero-cta"
                  data-nav-target="bottle"
                  aria-label="{{ block.settings.cta_label | default: 'Acquire The Flacon' }}"
                >
                  <span>{{ block.settings.cta_label | default: 'Acquire The Flacon' }}</span>
                  <span class="cta-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'story' -%}
          {%- comment -%} ═══ PANEL 2: STORY (#about) ═══ {%- endcomment -%}
          <section
            id="about"
            class="samay-panel panel-story"
            data-panel="{{ panel_index }}"
            data-anchor="about"
            {{ block.shopify_attributes }}
            aria-label="Story — {{ block.settings.heading | default: 'Our Story' }}"
          >
            <span class="story-chapter-bg" aria-hidden="true">02</span>

            <div class="story-content" data-story-reveal>
              <header class="story-header">
                <span class="story-eyebrow">{{ block.settings.eyebrow | default: 'The Origin' }}</span>
                <h2 class="story-heading">
                  {%- assign story_words = block.settings.heading | default: 'Born from Silence' | split: ' ' -%}
                  {%- for word in story_words -%}
                    <span class="s-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                  {%- endfor -%}
                </h2>
                <div class="story-rule" aria-hidden="true"></div>
              </header>

              <div class="story-body">
                <p class="story-p story-p--lead">{{ block.settings.paragraph_1 | default: '[TO FILL - Brand origin, founder history & heritage story]' }}</p>
                <p class="story-p">{{ block.settings.paragraph_2 | default: '[TO FILL - Ingredient sourcing, botanical origins & harvesting methods]' }}</p>
                <p class="story-p">{{ block.settings.paragraph_3 | default: '[TO FILL - House philosophy, olfactive concept & vision]' }}</p>
              </div>

              <ol class="story-timeline" aria-label="Brand milestones">
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_1_year | default: '[TO FILL]' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_1_text | default: '[TO FILL - Historic milestone 1]' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_2_year | default: '[TO FILL]' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_2_text | default: '[TO FILL - Historic milestone 2]' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_3_year | default: '[TO FILL]' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_3_text | default: '[TO FILL - Historic milestone 3]' }}</span>
                </li>
              </ol>

              {%- if block.settings.cta_label != blank -%}
                <a
                  href="#notes"
                  data-nav-target="notes"
                  class="story-cta"
                  aria-label="{{ block.settings.cta_label }}"
                >
                  <span>{{ block.settings.cta_label }}</span>
                  <span class="story-cta-line" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            </div>

            <div class="story-visual" aria-hidden="true" data-story-visual>
              <div class="story-visual-inner">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                            {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 768px) 80vw, 40vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="900"
                    height="1200"
                    loading="lazy"
                    class="story-img"
                  >
                {%- else -%}
                  <div class="story-art">
                    <div class="art-circle art-circle--lg"></div>
                    <div class="art-circle art-circle--md"></div>
                    <div class="art-circle art-circle--sm"></div>
                    <div class="art-lines">
                      {%- for i in (1..12) -%}
                        <div class="art-line" style="--i:{{ i }}"></div>
                      {%- endfor -%}
                    </div>
                    <div class="art-monogram">S</div>
                  </div>
                {%- endif -%}
                <div class="story-visual-overlay"></div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'notes' -%}
          {%- comment -%} ═══ PANEL 3: FRAGRANCE NOTES (#notes) ═══ {%- endcomment -%}
          <section
            id="notes"
            class="samay-panel panel-notes"
            data-panel="{{ panel_index }}"
            data-anchor="notes"
            {{ block.shopify_attributes }}
            aria-label="Fragrance Notes"
          >
            <span class="notes-chapter-bg" aria-hidden="true">03</span>

            <div class="notes-intro" data-notes-reveal>
              <span class="notes-eyebrow">{{ block.settings.eyebrow | default: 'The Composition' }}</span>
              <h2 class="notes-heading">
                {%- assign n_words = block.settings.heading | default: 'A Living Accord' | split: ' ' -%}
                {%- for word in n_words -%}
                  <span class="n-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                {%- endfor -%}
              </h2>
              <div class="notes-rule" aria-hidden="true"></div>
              <p class="notes-desc">{{ block.settings.description | default: '[TO FILL - Composition details, maceration protocols & formulation concentration]' }}</p>

              <div class="notes-concentration">
                <span class="conc-label">{{ block.settings.concentration_label | default: 'Concentration' }}</span>
                <span class="conc-value">{{ block.settings.concentration | default: '[TO FILL - Fragrance Concentration]' }}</span>
              </div>
            </div>

            <div class="notes-pyramid" aria-label="Fragrance pyramid" data-notes-reveal>
              <div class="notes-tier notes-tier--top" data-tier="top">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.top_label | default: 'Top Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.top_sub | default: 'The first breath — bright &amp; fleeting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Top notes">
                  {%- assign top_notes = block.settings.top_notes | default: '[TO FILL - Top Note 1],[TO FILL - Top Note 2],[TO FILL - Top Note 3]' | split: ',' -%}
                  {%- for note in top_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}" data-note-key="{{ note | strip | downcase | replace: ' ', '-' | replace: '(', '' | replace: ')', '' }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              <div class="notes-tier notes-tier--heart" data-tier="heart">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.heart_label | default: 'Heart Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.heart_sub | default: 'The soul — warm &amp; enduring' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Heart notes">
                  {%- assign heart_notes = block.settings.heart_notes | default: '[TO FILL - Heart Note 1],[TO FILL - Heart Note 2],[TO FILL - Heart Note 3]' | split: ',' -%}
                  {%- for note in heart_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}" data-note-key="{{ note | strip | downcase | replace: ' ', '-' | replace: '(', '' | replace: ')', '' }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              <div class="notes-tier notes-tier--base" data-tier="base">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.base_label | default: 'Base Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.base_sub | default: 'The memory — deep &amp; long-lasting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Base notes">
                  {%- assign base_notes = block.settings.base_notes | default: '[TO FILL - Base Note 1],[TO FILL - Base Note 2],[TO FILL - Base Note 3]' | split: ',' -%}
                  {%- for note in base_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}" data-note-key="{{ note | strip | downcase | replace: ' ', '-' | replace: '(', '' | replace: ')', '' }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>
            </div>

            {%- comment -%} Interactive Botanical Notes Explorer Dossier Popover {%- endcomment -%}
            <div class="note-dossier-popover" id="note-dossier-popover" aria-live="polite" aria-hidden="true">
              <div class="dossier-inner">
                <div class="dossier-header">
                  <div class="dossier-badge-row">
                    <span class="dossier-tier-badge" id="dossier-tier-badge">TOP NOTE</span>
                    <span class="dossier-origin-badge" id="dossier-origin-badge">Calabria, Italy</span>
                  </div>
                  <button type="button" class="dossier-close-btn" id="dossier-close-btn" aria-label="Close botanical dossier">✕</button>
                </div>
                <h4 class="dossier-title" id="dossier-title">Bergamot Calabrian</h4>
                <p class="dossier-latin" id="dossier-latin">Citrus bergamia Risso</p>
                <p class="dossier-description" id="dossier-description">Cold-expressed at first dawn from sunlit rinds harvested along the Ionian coast, unleashing radiant solar brilliance and delicate citrus facet.</p>
                <div class="dossier-attributes">
                  <div class="dossier-attr">
                    <span class="attr-label">Distillation</span>
                    <span class="attr-val" id="dossier-method">Artisanal Cold-Expression</span>
                  </div>
                  <div class="dossier-attr">
                    <span class="attr-label">Aroma Profile</span>
                    <span class="attr-val" id="dossier-profile">Solar • Zesty • Crisp</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'product' -%}
          {%- comment -%} ═══ PANEL 4: THE BOTTLE / PRODUCT (#bottle) ═══ {%- endcomment -%}
          {%- liquid
            assign featured_product = block.settings.featured_product
            if featured_product != blank
              assign product_obj = featured_product
              assign current_variant = product_obj.selected_or_first_available_variant
              assign product_price = current_variant.price | money
              assign product_compare = current_variant.compare_at_price | money
              assign variant_id_val = current_variant.id
            else
              assign product_price = block.settings.price | default: '₹4,999'
              assign product_compare = block.settings.compare_at_price | default: '₹6,499'
              assign variant_id_val = ''
            endif
          -%}
          <section
            id="bottle"
            class="samay-panel panel-product"
            data-panel="{{ panel_index }}"
            data-anchor="bottle"
            {{ block.shopify_attributes }}
            aria-label="The Bottle — {{ block.settings.title | default: 'Samay Extrait de Parfum' }}"
          >
            <span class="product-chapter-bg" aria-hidden="true">04</span>

            <div class="product-layout" data-product-reveal>
              <div class="product-flank product-flank--specs">
                <header class="product-header">
                  <span class="product-eyebrow">{{ block.settings.eyebrow | default: 'The Artifact' }}</span>
                  <h2 class="product-heading">
                    {%- assign p_words = block.settings.heading | default: 'Sculpted in Darkness' | split: ' ' -%}
                    {%- for word in p_words -%}
                      <span class="p-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                    {%- endfor -%}
                  </h2>
                  <div class="product-rule" aria-hidden="true"></div>
                </header>

                <p class="product-desc">{{ block.settings.description | default: 'An architectural flacon sculpted from heavyweight smoked French crystal, crowned with a 24-karat gold-gilded magnetic stopper. Each flacon is individually numbered.' }}</p>

                <div class="product-specs-list" aria-label="Flacon specifications">
                  <div class="product-spec-item" style="--psi:0">
                    <span class="spec-label">{{ block.settings.spec_1_label | default: 'Vessel Architecture' }}</span>
                    <span class="spec-val">{{ block.settings.spec_1_val | default: '[TO FILL - Vessel Architecture & Materials]' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:1">
                    <span class="spec-label">{{ block.settings.spec_2_label | default: 'The Stopper' }}</span>
                    <span class="spec-val">{{ block.settings.spec_2_val | default: '[TO FILL - Cap & Finishes]' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:2">
                    <span class="spec-label">{{ block.settings.spec_3_label | default: 'Maceration Period' }}</span>
                    <span class="spec-val">{{ block.settings.spec_3_val | default: '[TO FILL - Aging & Maceration Duration]' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:3">
                    <span class="spec-label">{{ block.settings.spec_4_label | default: 'Origin & Batch' }}</span>
                    <span class="spec-val">{{ block.settings.spec_4_val | default: '[TO FILL - Production Origin & Batch Run]' }}</span>
                  </div>
                </div>
              </div>

              <div class="product-stage" aria-hidden="true">
                <div class="stage-reticle">
                  <div class="reticle-circle reticle-circle--outer"></div>
                  <div class="reticle-circle reticle-circle--inner"></div>
                  <div class="reticle-cross reticle-cross--h"></div>
                  <div class="reticle-cross reticle-cross--v"></div>
                </div>
                <div class="stage-coords">
                  <span class="coord-tag">FLACON NO. 01 / 500</span>
                  <span class="coord-drag-hint">DRAG TO INSPECT 360°</span>
                </div>
              </div>

              <div class="product-flank product-flank--commerce">
                <div class="product-card" id="samay-product-card" data-variant-id="{{ variant_id_val }}">
                  {%- if block.settings.badge_text != blank -%}
                    <div class="product-badge-wrap">
                      <span class="product-badge">
                        <span class="badge-dot" aria-hidden="true"></span>
                        {{ block.settings.badge_text }}
                      </span>
                    </div>
                  {%- endif -%}



                  <div class="product-title-group">
                    <h3 class="product-card-title">{{ block.settings.title | default: 'Samay Extrait de Parfum' }}</h3>
                    <span class="product-card-sub">{{ block.settings.subtitle | default: '[TO FILL - Batch Information]' }}</span>
                  </div>

                  <div class="product-price-row">
                    <div class="price-stack">
                      <span class="product-price" data-price-display>{{ product_price }}</span>
                      {%- if product_compare != blank -%}
                        <span class="product-compare-price">{{ product_compare }}</span>
                      {%- endif -%}
                    </div>
                    <span class="product-volume" data-volume-display>{{ block.settings.volume | default: '50 ML — 1.7 FL. OZ.' }}</span>
                  </div>

                  <div class="product-size-selector" role="group" aria-label="Select Edition or Bundle">
                    <span class="selector-label">Option:</span>
                    <div class="size-options">
                      {%- if product_obj != blank and product_obj.variants.size > 0 -%}
                        {%- for variant in product_obj.variants -%}
                          <button
                            type="button"
                            class="size-pill{% if forloop.first %} is-selected{% endif %}"
                            data-variant-id="{{ variant.id }}"
                            data-size="{{ variant.title | escape }}"
                            data-price="{{ variant.price | money }}"
                            {% if variant.compare_at_price > variant.price %}
                              data-compare="{{ variant.compare_at_price | money }}"
                            {% endif %}
                            data-volume="{{ variant.title | escape }}"
                            data-raw-cents="{{ variant.price }}"
                            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                          >
                            {{ variant.title }}
                          </button>
                        {%- endfor -%}
                      {%- else -%}
                        <button
                          type="button"
                          class="size-pill is-selected"
                          data-size="Single 50ml"
                          data-price="{{ block.settings.price | default: '₹4,999' }}"
                          data-compare="{{ block.settings.compare_at_price | default: '₹6,499' }}"
                          data-volume="50 ML — 1.7 FL. OZ."
                          data-raw-cents="499900"
                          aria-pressed="true"
                        >
                          Single 50ml
                        </button>
                        <button
                          type="button"
                          class="size-pill"
                          data-size="Pack of 2"
                          data-price="{{ block.settings.price_pack_2 | default: '₹8,999' }}"
                          data-volume="2 × 50 ML — 3.4 FL. OZ."
                          data-raw-cents="899900"
                          aria-pressed="false"
                        >
                          Pack of 2
                        </button>
                        <button
                          type="button"
                          class="size-pill"
                          data-size="Pack of 3"
                          data-price="{{ block.settings.price_pack_3 | default: '₹12,499' }}"
                          data-volume="3 × 50 ML — 5.1 FL. OZ."
                          data-raw-cents="1249900"
                          aria-pressed="false"
                        >
                          Pack of 3
                        </button>
                      {%- endif -%}
                    </div>
                  </div>



                  <div class="product-action-buttons">
                    <button
                      type="button"
                      class="product-primary-cta"
                      id="samay-add-to-cart-btn"
                      aria-label="Add to cart"
                    >
                      <span class="cta-glow-line" aria-hidden="true"></span>
                      <span class="cta-text">Add to Shopping Bag</span>
                      <span class="cta-arrow" aria-hidden="true">→</span>
                    </button>

                    <button
                      type="button"
                      class="product-buy-now-btn"
                      id="samay-buy-now-btn"
                      aria-label="Buy now, proceed directly to checkout"
                    >
                      <span>Buy Now</span>
                    </button>
                  </div>

                  <div class="product-inclusions" aria-label="Purchase guarantees">
                    {%- if block.settings.inclusion_1 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_1 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_2 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_2 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_3 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_3 }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                  {%- comment -%} Discovery Guarantee Badge {%- endcomment -%}
                  <div class="product-discovery-guarantee">
                    <div class="guarantee-shield" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                      </svg>
                    </div>
                    <div class="guarantee-content">
                      <h4 class="guarantee-title">The Discovery Guarantee</h4>
                      <p class="guarantee-text">[TO FILL - Details of discovery guarantee, trial experience, and return terms]</p>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'faq' -%}
          {%- comment -%} ═══ PANEL 5: FAQ ACCORDION (#faq) ═══ {%- endcomment -%}
          <section
            id="faq"
            class="samay-panel panel-faq"
            data-panel="{{ panel_index }}"
            data-anchor="faq"
            {{ block.shopify_attributes }}
            aria-label="FAQ — {{ block.settings.heading | default: 'Frequently Asked Questions' }}"
          >
            <span class="faq-chapter-bg" aria-hidden="true">05</span>

            <div class="faq-layout" data-faq-reveal>
              <header class="faq-header">
                <span class="faq-eyebrow">{{ block.settings.eyebrow | default: 'Inquiries & Guidance' }}</span>
                <h2 class="faq-heading">{{ block.settings.heading | default: 'Frequently Asked Questions' }}</h2>
                <div class="faq-rule" aria-hidden="true"></div>
                {%- if block.settings.subtext != blank -%}
                  <p class="faq-subtext">{{ block.settings.subtext }}</p>
                {%- endif -%}
              </header>

              <div class="faq-accordion-container" role="region" aria-label="Questions list">
                {%- for i in (1..6) -%}
                  {%- assign q_key = 'q' | append: i -%}
                  {%- assign a_key = 'a' | append: i -%}
                  {%- assign question = block.settings[q_key] -%}
                  {%- assign answer   = block.settings[a_key] -%}

                  {%- if question != blank and answer != blank -%}
                    <div class="faq-accordion-item{% if forloop.first %} is-open{% endif %}" data-faq-item>
                      <button
                        type="button"
                        class="faq-accordion-header"
                        aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-controls="faq-content-{{ block.id }}-{{ i }}"
                        id="faq-header-{{ block.id }}-{{ i }}"
                      >
                        <span class="faq-item-num">0{{ i }}</span>
                        <span class="faq-item-question">{{ question }}</span>
                        <span class="faq-item-icon" aria-hidden="true"></span>
                      </button>
                      <div
                        id="faq-content-{{ block.id }}-{{ i }}"
                        class="faq-accordion-content"
                        role="region"
                        aria-labelledby="faq-header-{{ block.id }}-{{ i }}"
                        {% unless forloop.first %}style="max-height:0;"{% endunless %}
                      >
                        <div class="faq-accordion-body">
                          <p>{{ answer }}</p>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </section>

        {%- elsif block.type == 'contact' -%}
          {%- comment -%} ═══ PANEL 7: CONTACT (#contact) ═══ {%- endcomment -%}
          <section
            id="contact"
            class="samay-panel panel-contact"
            data-panel="{{ panel_index }}"
            data-anchor="contact"
            {{ block.shopify_attributes }}
            aria-label="Contact — {{ block.settings.heading | default: 'Connect with the House' }}"
          >
            <span class="contact-chapter-bg" aria-hidden="true">06</span>

            <div class="contact-layout" data-contact-reveal>
              <div class="contact-col-info">
                <header class="contact-header">
                  <span class="contact-eyebrow">{{ block.settings.eyebrow | default: 'Direct Concierge' }}</span>
                  <h2 class="contact-heading">{{ block.settings.heading | default: 'Connect with the House' }}</h2>
                  <div class="contact-rule" aria-hidden="true"></div>
                  <p class="contact-subtext">{{ block.settings.subtext | default: 'Our concierge is at your service for bespoke inquiries, private appointments, and flacon reservations.' }}</p>
                </header>

                <div class="contact-meta-list">
                  {%- if block.settings.concierge_email != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Email Concierge</span>
                      <a href="mailto:{{ block.settings.concierge_email }}" class="meta-value">{{ block.settings.concierge_email }}</a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.concierge_phone != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Direct Line</span>
                      <a href="tel:{{ block.settings.concierge_phone | replace: ' ', '' }}" class="meta-value">{{ block.settings.concierge_phone }}</a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.concierge_city != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Atelier</span>
                      <span class="meta-value">{{ block.settings.concierge_city }}</span>
                    </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.whatsapp_number != blank -%}
                  <div class="contact-whatsapp-wrap">
                    {%- assign wa_num = block.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
                    {%- assign wa_msg = block.settings.whatsapp_message | default: 'Hello Samay Parfumes, I would like to inquire about the collection.' | url_encode -%}
                    <a
                      href="https://wa.me/{{ wa_num }}?text={{ wa_msg }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="contact-whatsapp-btn"
                      aria-label="Connect via WhatsApp"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
