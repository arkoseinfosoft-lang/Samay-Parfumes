{%- comment -%} ════════════════════════════════════════════════
    SLIDE-OUT CART DRAWER (Shopify AJAX Cart API)
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-cart-drawer" class="samay-cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Shopping Bag">
  <div id="cart-drawer-backdrop" class="cart-drawer-backdrop" aria-hidden="true"></div>
  <aside class="cart-drawer-panel">
    <header class="cart-drawer-header">
      <div class="cart-header-title-wrap">
        <h2 class="cart-drawer-title">Shopping Bag</h2>
        <span class="cart-drawer-count" id="cart-drawer-header-count">({{ cart.item_count }})</span>
      </div>
      <button type="button" id="cart-drawer-close" class="cart-drawer-close-btn" aria-label="Close cart">
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div class="cart-drawer-shipping-notice">
      <span class="shipping-icon" aria-hidden="true">◆</span>
      <span>Complimentary White-Glove Express Shipping Included</span>
    </div>

    <div class="cart-drawer-body" id="cart-drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty-state">
          <p class="cart-empty-text">Your selection is currently empty.</p>
          <a href="#bottle" class="cart-empty-cta" id="cart-empty-discover-btn">Explore The Flacon</a>
        </div>
      {%- else -%}
        <div class="cart-items-list" id="cart-items-list">
          {%- for item in cart.items -%}
            <div class="cart-item-row" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <div class="cart-item-thumb">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" width="70" height="70" loading="lazy">
                {%- else -%}
                  <div class="cart-item-thumb-placeholder">S</div>
                {%- endif -%}
              </div>
              <div class="cart-item-details">
                <h3 class="cart-item-title">{{ item.product.title }}</h3>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item-variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-item-price-row">
                  <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                  <div class="cart-item-qty-wrap">
                    <button type="button" class="cart-qty-btn cart-qty-minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
                    <span class="cart-qty-value">{{ item.quantity }}</span>
                    <button type="button" class="cart-qty-btn cart-qty-plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
                  </div>
                </div>
              </div>
              <button type="button" class="cart-item-remove" data-key="{{ item.key }}" aria-label="Remove item">
                <span aria-hidden="true">✕</span>
              </button>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <footer class="cart-drawer-footer">
      <div class="cart-subtotal-row">
        <span class="cart-subtotal-label">Subtotal</span>
        <span class="cart-subtotal-amount" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-taxes-note">Duties and taxes calculated during secure checkout.</p>
      <a href="/checkout" class="cart-checkout-btn" id="cart-drawer-checkout-btn">
        <span>Proceed to Checkout</span>
        <span class="checkout-arrow" aria-hidden="true">→</span>
      </a>
    </footer>
  </aside>
</div>

{%- comment -%} ════════════════════════════════════════════════
    POLICY MODAL (Shipping, Refund, Privacy, Terms)
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-policy-modal" class="samay-policy-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="policy-modal-title">
  <div class="policy-modal-backdrop" id="policy-modal-backdrop" aria-hidden="true"></div>
  <div class="policy-modal-dialog">
