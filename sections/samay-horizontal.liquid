{%- comment -%}
  samay-horizontal.liquid
  Samay Parfumes — Luxury horizontal scroll experience & Complete Brand Storefront
  Block-based schema so panels are reorderable in the theme editor.
{%- endcomment -%}

{%- liquid
  assign num_panels = section.blocks.size | default: 8
  assign label_url  = 'label.webp'  | asset_url
  assign ref_url    = 'bottle-ref.webp' | asset_url
  assign format_tag = 'amount'
  assign format_fallback = '₹{{' | append: format_tag | append: '}}'
  assign shop_format = shop.money_format | default: format_fallback
-%}

{{- 'samay.css' | asset_url | stylesheet_tag -}}

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"
  }
}
</script>

{%- comment -%} ── CDN Libraries ── {%- endcomment -%}
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" defer></script>

{%- comment -%} ── Site config object ── {%- endcomment -%}
<script>
  window.SamayConfig = {
    numPanels:  {{ num_panels }},
    labelUrl:   {{ label_url | json }},
    refUrl:     {{ ref_url   | json }},
    moneyFormat: {{ shop_format | json }}
  };
</script>

{%- comment -%} ── Grain overlay ── {%- endcomment -%}
<div id="samay-grain" aria-hidden="true"></div>

{%- comment -%} ── Custom cursor (desktop only) ── {%- endcomment -%}
<div id="samay-cursor" aria-hidden="true"></div>

{%- comment -%} ── Preloader ── {%- endcomment -%}
<div id="samay-preloader" role="status" aria-label="Loading Samay Parfumes">
  <span class="preloader-wordmark">{{ section.settings.brand_name | default: 'Samay' }}</span>
  <div class="preloader-bar-track" aria-hidden="true">
    <div class="preloader-bar-fill"></div>
  </div>
</div>

{%- comment -%} ── Three.js Canvas ── {%- endcomment -%}
<canvas id="samay-canvas" aria-hidden="true"></canvas>

{%- comment -%} ── Progress bar ── {%- endcomment -%}
<div id="samay-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Page progress">
  <div id="samay-progress-fill"></div>
</div>

{%- comment -%} ── Panel counter ── {%- endcomment -%}
<div id="samay-counter" aria-live="polite" aria-atomic="true">
  <span class="current">01</span> / {{ num_panels | prepend: '0' | slice: -2, 2 }}
</div>

{%- comment -%} ── Drag hint ── {%- endcomment -%}
<div id="drag-hint" role="note" aria-label="Drag to rotate bottle 360 degrees">
  <span class="drag-hint-icon" aria-hidden="true"></span>
  <span>Drag to rotate 360°</span>
</div>

{%- comment -%} ── Scroll hint (desktop) ── {%- endcomment -%}
<div class="scroll-hint" aria-hidden="true">
  <div class="scroll-hint-line"></div>
</div>

{%- comment -%} ════════════════════════════════════════════════
    FIXED MINIMAL NAVIGATION
    ════════════════════════════════════════════════ {%- endcomment -%}
<header id="samay-nav" class="samay-nav" role="banner">
  <div class="samay-nav-container">
    <div class="nav-left">
      <a href="#home" class="nav-logo" aria-label="{{ section.settings.brand_name | default: 'Samay Parfumes' }} Home">
        <span class="nav-logo-text">{{ section.settings.brand_name | default: 'SAMAY' }}</span>
        <span class="nav-logo-sub">PARFUMES</span>
      </a>
    </div>

    <div class="nav-center" aria-hidden="true">
      <span class="nav-chapter-indicator" id="nav-chapter-indicator">01 / OUVERTURE</span>
    </div>

    <div class="nav-right">
      {%- comment -%} Ambient Soundscape Toggle {%- endcomment -%}
      <button
        type="button"
        id="samay-sound-toggle"
        class="nav-control-btn nav-sound-btn"
        aria-label="Toggle ambient atelier soundscape"
        aria-pressed="false"
        title="Ambient Atelier Soundscape"
      >
        <span class="sound-bars" aria-hidden="true">
          <span class="sound-bar sb-1"></span>
          <span class="sound-bar sb-2"></span>
          <span class="sound-bar sb-3"></span>
        </span>
        <span class="sound-btn-text">SOUND</span>
      </button>

      {%- comment -%} Light / Dark Mode Toggle {%- endcomment -%}
      <button
        type="button"
        id="samay-theme-toggle"
        class="nav-control-btn nav-theme-btn"
        aria-label="Toggle appearance between Golden Hour and Midnight Noir"
        title="Switch Appearance"
      >
        <span class="theme-icon theme-icon--sun" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>

      {%- comment -%} Currency / Region Selector {%- endcomment -%}
      <div class="nav-currency-wrap" id="samay-currency-wrap">
        <button
          type="button"
          id="samay-currency-btn"
          class="nav-currency-btn"
          aria-label="Select currency"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span id="current-currency-symbol">₹</span>
          <span id="current-currency-code">INR</span>
          <span class="currency-arrow" aria-hidden="true">▾</span>
        </button>
        <div class="nav-currency-dropdown" id="nav-currency-dropdown" role="menu">
          <button type="button" class="currency-choice is-active" data-currency="INR" role="menuitem">
            <span class="cc-sym">₹</span> INR <span class="cc-name">— Indian Rupee</span>
          </button>
          <button type="button" class="currency-choice" data-currency="USD" role="menuitem">
            <span class="cc-sym">$</span> USD <span class="cc-name">— US Dollar</span>
          </button>
          <button type="button" class="currency-choice" data-currency="EUR" role="menuitem">
            <span class="cc-sym">€</span> EUR <span class="cc-name">— Euro</span>
          </button>
          <button type="button" class="currency-choice" data-currency="GBP" role="menuitem">
            <span class="cc-sym">£</span> GBP <span class="cc-name">— British Pound</span>
          </button>
          <button type="button" class="currency-choice" data-currency="AED" role="menuitem">
            <span class="cc-sym">د.إ</span> AED <span class="cc-name">— UAE Dirham</span>
          </button>
        </div>
      </div>

      <button
        type="button"
        id="nav-cart-btn"
        class="nav-icon-btn nav-cart-btn"
        aria-label="Open Shopping Bag ({{ cart.item_count }} items)"
        aria-controls="samay-cart-drawer"
        aria-expanded="false"
      >
        <span class="cart-btn-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </span>
        <span class="nav-cart-badge" id="nav-cart-count">{{ cart.item_count }}</span>
      </button>

      <button
        type="button"
        id="nav-menu-toggle"
        class="nav-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-controls="samay-menu-overlay"
        aria-expanded="false"
      >
        <span class="menu-toggle-box">
          <span class="menu-toggle-line menu-toggle-line--top"></span>
          <span class="menu-toggle-line menu-toggle-line--bottom"></span>
        </span>
        <span class="menu-toggle-label">MENU</span>
      </button>
    </div>
  </div>
</header>

