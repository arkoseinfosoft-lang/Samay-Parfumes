{%- comment -%} ════════════════════════════════════════════════
    SLIDE-OUT CART DRAWER (Shopify AJAX Cart API)
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-cart-drawer" class="samay-cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Shopping Bag">
  <div id="cart-drawer-backdrop" class="cart-drawer-backdrop" aria-hidden="true"></div>
  <aside class="cart-drawer-panel">
    <header class="cart-drawer-header">
      <div class="cart-header-title-wrap">
        <h2 class="cart-drawer-title">Shopping Bag</h2>
        <span class="cart-drawer-count" id="cart-drawer-header-count">({{ cart.item_count }})</span>
      </div>
      <button type="button" id="cart-drawer-close" class="cart-drawer-close-btn" aria-label="Close cart">
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div class="cart-drawer-shipping-notice">
      <span class="shipping-icon" aria-hidden="true">◆</span>
      <span>Complimentary White-Glove Express Shipping Included</span>
    </div>

    <div class="cart-drawer-body" id="cart-drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty-state">
          <p class="cart-empty-text">Your selection is currently empty.</p>
          <a href="#bottle" class="cart-empty-cta" id="cart-empty-discover-btn">Explore The Flacon</a>
        </div>
      {%- else -%}
        <div class="cart-items-list" id="cart-items-list">
          {%- for item in cart.items -%}
            <div class="cart-item-row" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <div class="cart-item-thumb">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" width="70" height="70" loading="lazy">
                {%- else -%}
                  <div class="cart-item-thumb-placeholder">S</div>
                {%- endif -%}
              </div>
              <div class="cart-item-details">
                <h3 class="cart-item-title">{{ item.product.title }}</h3>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item-variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-item-price-row">
                  <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                  <div class="cart-item-qty-wrap">
                    <button type="button" class="cart-qty-btn cart-qty-minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
                    <span class="cart-qty-value">{{ item.quantity }}</span>
                    <button type="button" class="cart-qty-btn cart-qty-plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
                  </div>
                </div>
              </div>
              <button type="button" class="cart-item-remove" data-key="{{ item.key }}" aria-label="Remove item">
                <span aria-hidden="true">✕</span>
              </button>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <footer class="cart-drawer-footer">
      <div class="cart-subtotal-row">
        <span class="cart-subtotal-label">Subtotal</span>
        <span class="cart-subtotal-amount" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-taxes-note">Duties and taxes calculated during secure checkout.</p>
      <a href="/checkout" class="cart-checkout-btn" id="cart-drawer-checkout-btn">
        <span>Proceed to Checkout</span>
        <span class="checkout-arrow" aria-hidden="true">→</span>
      </a>
    </footer>
  </aside>
</div>

{%- comment -%} ════════════════════════════════════════════════
    POLICY MODAL (Shipping, Refund, Privacy, Terms)
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-policy-modal" class="samay-policy-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="policy-modal-title">
  <div class="policy-modal-backdrop" id="policy-modal-backdrop" aria-hidden="true"></div>
  <div class="policy-modal-dialog">
    <header class="policy-modal-header">
      <h2 id="policy-modal-title" class="policy-modal-title">Policy</h2>
      <button type="button" id="policy-modal-close" class="policy-modal-close-btn" aria-label="Close dialog">
        <span aria-hidden="true">✕</span>
      </button>
    </header>
    <div id="policy-modal-content" class="policy-modal-content">
      {%- comment -%} Dynamically populated via JS {%- endcomment -%}
    </div>
  </div>
</div>

{%- comment -%} Hidden templates for shop policies {%- endcomment -%}
<div id="policy-data-templates" style="display:none;" aria-hidden="true">
  <div id="policy-template-shipping" data-title="Shipping Policy">
    {%- if shop.shipping_policy.body != blank -%}
      {{ shop.shipping_policy.body }}
    {%- else -%}
      <h3>Complimentary White-Glove Dispatch</h3>
      <p>All flacons from the House of Samay are protected in temperature-regulated, shock-absorbing presentation boxes. We provide complimentary express courier delivery across India, dispatched within 24 hours of order receipt.</p>
      <p>Domestic transit typically requires 2 to 4 business days. Real-time satellite tracking and digital delivery verification will be transmitted via SMS and email.</p>
      <h3>International Allocations</h3>
      <p>International shipments are handled via DHL Express Worldwide. Applicable duties, taxes, and customs inspections are calculated transparently during checkout.</p>
    {%- endif -%}
  </div>

  <div id="policy-template-refund" data-title="Refund &amp; Return Policy">
    {%- if shop.refund_policy.body != blank -%}
      {{ shop.refund_policy.body }}
    {%- else -%}
      <h3>The 14-Day Discovery Guarantee</h3>
      <p>Every Samay Extrait de Parfum flacon arrives with a complimentary 5ml discovery vial. We cordially invite you to experience the fragrance from the miniature vial first.</p>
      <p>Should the composition not completely align with your desires, you may return the unopened, sealed full-sized flacon within 14 days of receipt for an immediate, full refund.</p>
      <p>To initiate a return, contact our private concierge at <a href="mailto:concierge@samayparfumes.com">concierge@samayparfumes.com</a> with your order number.</p>
    {%- endif -%}
  </div>

  <div id="policy-template-privacy" data-title="Privacy Policy">
    {%- if shop.privacy_policy.body != blank -%}
      {{ shop.privacy_policy.body }}
    {%- else -%}
      <h3>Discretion &amp; Confidentiality</h3>
      <p>At Samay Parfumes, client discretion is paramount. We collect personal contact and shipping information solely to fulfill orders, provide concierge support, and issue certificates of authenticity.</p>
      <p>We do not sell, rent, or trade client dossiers to third parties. All transactional records and payment tokens are processed via 256-bit encrypted banking gateways.</p>
    {%- endif -%}
  </div>

  <div id="policy-template-terms" data-title="Terms of Service">
    {%- if shop.terms_of_service.body != blank -%}
      {{ shop.terms_of_service.body }}
    {%- else -%}
      <h3>Atelier Terms</h3>
      <p>Each release from Samay Parfumes is distilled in limited artisan batches. Due to rare botanical harvests and natural maceration variables, subtle chromatic and accord differences between production runs may occur and represent the mark of genuine artisan perfumery.</p>
      <p>All bottle architecture, visual assets, olfactory formulations, and brand trademarks remain the exclusive intellectual property of Samay Parfumes.</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} ════════════════════════════════════════════════
    ROOT / HORIZONTAL TRACK & PANELS
    ════════════════════════════════════════════════ {%- endcomment -%}
<div id="samay-root" class="full-width" role="main">
  <div id="samay-track-outer">
    <div id="samay-track">

      {%- for block in section.blocks -%}
        {%- assign panel_index = forloop.index0 -%}
        {%- assign panel_num   = forloop.index -%}

        {%- if block.type == 'hero' -%}
          {%- comment -%} ═══ PANEL 1: HERO (#home) ═══ {%- endcomment -%}
          <section
            id="home"
            class="samay-panel panel-hero"
            data-panel="{{ panel_index }}"
            data-anchor="home"
            {{ block.shopify_attributes }}
            aria-label="Hero — {{ block.settings.heading | default: 'Samay Parfumes' }}"
          >
            <div class="hero-content">
              <span class="hero-eyebrow">{{ block.settings.eyebrow | default: 'Fine Fragrances' }}</span>

              <h1 class="hero-heading" aria-label="{{ block.settings.heading | default: 'Time Captured in Scent' }}">
                {%- assign heading_words = block.settings.heading | default: 'Time Captured in Scent' | split: ' ' -%}
                {%- assign word_count = heading_words.size -%}
                {%- if word_count <= 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      <span class="word">{{ word }}&nbsp;</span>
                    {%- endfor -%}
                  </span>
                {%- elsif word_count == 3 -%}
                  <span class="line">
                    <span class="word">{{ heading_words[0] }}&nbsp;</span>
                    <span class="word">{{ heading_words[1] }}&nbsp;</span>
                  </span>
                  <span class="line">
                    <span class="word" style="color:var(--gold)">{{ heading_words[2] }}</span>
                  </span>
                {%- else -%}
                  {%- assign half = word_count | divided_by: 2 -%}
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 < half -%}
                        <span class="word">{{ word }}&nbsp;</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="line">
                    {%- for word in heading_words -%}
                      {%- if forloop.index0 >= half -%}
                        <span class="word"{% if forloop.last %} style="color:var(--gold)"{% endif %}>{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </h1>

              <p class="hero-sub">{{ block.settings.subtext | default: 'A rare alchemy of ancient woods, sacred resins and the golden hour — distilled into a single breath.' }}</p>

              <div class="hero-cta-wrap">
                <a
                  href="#bottle"
                  class="hero-cta"
                  data-nav-target="bottle"
                  aria-label="{{ block.settings.cta_label | default: 'Acquire The Flacon' }}"
                >
                  <span>{{ block.settings.cta_label | default: 'Acquire The Flacon' }}</span>
                  <span class="cta-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'story' -%}
          {%- comment -%} ═══ PANEL 2: STORY (#about) ═══ {%- endcomment -%}
          <section
            id="about"
            class="samay-panel panel-story"
            data-panel="{{ panel_index }}"
            data-anchor="about"
            {{ block.shopify_attributes }}
            aria-label="Story — {{ block.settings.heading | default: 'Our Story' }}"
          >
            <span class="story-chapter-bg" aria-hidden="true">02</span>

            <div class="story-content" data-story-reveal>
              <header class="story-header">
                <span class="story-eyebrow">{{ block.settings.eyebrow | default: 'The Origin' }}</span>
                <h2 class="story-heading">
                  {%- assign story_words = block.settings.heading | default: 'Born from Silence' | split: ' ' -%}
                  {%- for word in story_words -%}
                    <span class="s-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                  {%- endfor -%}
                </h2>
                <div class="story-rule" aria-hidden="true"></div>
              </header>

              <div class="story-body">
                <p class="story-p story-p--lead">{{ block.settings.paragraph_1 | default: 'Samay was born in the lantern-lit lanes of old Delhi, where a perfumers notebook and a grandmothers memory became the seed of something rare.' }}</p>
                <p class="story-p">{{ block.settings.paragraph_2 | default: 'We source only what the season offers willingly — raw oud from Assams oldest agarwood groves, Mysore sandalwood aged in silence, Bulgarian rose absolute hand-pressed at dawn.' }}</p>
                <p class="story-p">{{ block.settings.paragraph_3 | default: 'Every bottle holds a specific hour — not just a fragrance. An atmosphere you can return to.' }}</p>
              </div>

              <ol class="story-timeline" aria-label="Brand milestones">
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_1_year | default: '2018' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_1_text | default: 'First batch distilled in a copper athar still' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_2_year | default: '2021' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_2_text | default: 'Awarded India Finest Artisan Fragrance' }}</span>
                </li>
                <li class="story-milestone">
                  <span class="milestone-year">{{ block.settings.milestone_3_year | default: '2024' }}</span>
                  <span class="milestone-sep" aria-hidden="true"></span>
                  <span class="milestone-text">{{ block.settings.milestone_3_text | default: 'Expanded to 28 countries across 4 continents' }}</span>
                </li>
              </ol>

              {%- if block.settings.cta_label != blank -%}
                <a
                  href="#notes"
                  data-nav-target="notes"
                  class="story-cta"
                  aria-label="{{ block.settings.cta_label }}"
                >
                  <span>{{ block.settings.cta_label }}</span>
                  <span class="story-cta-line" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            </div>

            <div class="story-visual" aria-hidden="true" data-story-visual>
              <div class="story-visual-inner">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                            {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 768px) 80vw, 40vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="900"
                    height="1200"
                    loading="lazy"
                    class="story-img"
                  >
                {%- else -%}
                  <div class="story-art">
                    <div class="art-circle art-circle--lg"></div>
                    <div class="art-circle art-circle--md"></div>
                    <div class="art-circle art-circle--sm"></div>
                    <div class="art-lines">
                      {%- for i in (1..12) -%}
                        <div class="art-line" style="--i:{{ i }}"></div>
                      {%- endfor -%}
                    </div>
                    <div class="art-monogram">S</div>
                  </div>
                {%- endif -%}
                <div class="story-visual-overlay"></div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'notes' -%}
          {%- comment -%} ═══ PANEL 3: FRAGRANCE NOTES (#notes) ═══ {%- endcomment -%}
          <section
            id="notes"
            class="samay-panel panel-notes"
            data-panel="{{ panel_index }}"
            data-anchor="notes"
            {{ block.shopify_attributes }}
            aria-label="Fragrance Notes"
          >
            <span class="notes-chapter-bg" aria-hidden="true">03</span>

            <div class="notes-intro" data-notes-reveal>
              <span class="notes-eyebrow">{{ block.settings.eyebrow | default: 'The Composition' }}</span>
              <h2 class="notes-heading">
                {%- assign n_words = block.settings.heading | default: 'A Living Accord' | split: ' ' -%}
                {%- for word in n_words -%}
                  <span class="n-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                {%- endfor -%}
              </h2>
              <div class="notes-rule" aria-hidden="true"></div>
              <p class="notes-desc">{{ block.settings.description | default: 'A compound of 1000 g, matured in ethanol and rare musks. Every element chosen for the hour it inhabits.' }}</p>

              <div class="notes-concentration">
                <span class="conc-label">{{ block.settings.concentration_label | default: 'Concentration' }}</span>
                <span class="conc-value">{{ block.settings.concentration | default: 'Eau de Parfum Intense' }}</span>
              </div>
            </div>

            <div class="notes-pyramid" aria-label="Fragrance pyramid" data-notes-reveal>
              <div class="notes-tier notes-tier--top" data-tier="top">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.top_label | default: 'Top Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.top_sub | default: 'The first breath — bright &amp; fleeting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Top notes">
                  {%- assign top_notes = block.settings.top_notes | default: 'Bergamot,Blackcurrant,Apple,Pineapple Platinum' | split: ',' -%}
                  {%- for note in top_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              <div class="notes-tier notes-tier--heart" data-tier="heart">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.heart_label | default: 'Heart Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.heart_sub | default: 'The soul — warm &amp; enduring' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Heart notes">
                  {%- assign heart_notes = block.settings.heart_notes | default: 'Jasmine Absolute,Jasmine Sambac,Birch Tar,Patchouli' | split: ',' -%}
                  {%- for note in heart_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>

              <div class="notes-tier notes-tier--base" data-tier="base">
                <div class="tier-meta">
                  <span class="tier-arc" aria-hidden="true"></span>
                  <span class="tier-label">{{ block.settings.base_label | default: 'Base Notes' }}</span>
                  <span class="tier-sub">{{ block.settings.base_sub | default: 'The memory — deep &amp; long-lasting' }}</span>
                </div>
                <ol class="tier-notes" aria-label="Base notes">
                  {%- assign base_notes = block.settings.base_notes | default: 'White Musk,Vanilla,Ambraxon,Javanol (Sandalwood),Ambergris,Oakmoss' | split: ',' -%}
                  {%- for note in base_notes -%}
                    {%- unless note == blank -%}
                      <li class="tier-note" style="--ni:{{ forloop.index0 }}">{{ note | strip }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ol>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'product' -%}
          {%- comment -%} ═══ PANEL 4: THE BOTTLE / PRODUCT (#bottle) ═══ {%- endcomment -%}
          {%- liquid
            assign featured_product = block.settings.featured_product
            if featured_product != blank
              assign product_obj = featured_product
              assign current_variant = product_obj.selected_or_first_available_variant
              assign product_price = current_variant.price | money
              assign product_compare = current_variant.compare_at_price | money
              assign variant_id_val = current_variant.id
            else
              assign product_price = block.settings.price | default: '₹22,500'
              assign product_compare = block.settings.compare_at_price | default: '₹26,000'
              assign variant_id_val = ''
            endif
          -%}
          <section
            id="bottle"
            class="samay-panel panel-product"
            data-panel="{{ panel_index }}"
            data-anchor="bottle"
            {{ block.shopify_attributes }}
            aria-label="The Bottle — {{ block.settings.title | default: 'Samay Extrait de Parfum' }}"
          >
            <span class="product-chapter-bg" aria-hidden="true">04</span>

            <div class="product-layout" data-product-reveal>
              <div class="product-flank product-flank--specs">
                <header class="product-header">
                  <span class="product-eyebrow">{{ block.settings.eyebrow | default: 'The Artifact' }}</span>
                  <h2 class="product-heading">
                    {%- assign p_words = block.settings.heading | default: 'Sculpted in Darkness' | split: ' ' -%}
                    {%- for word in p_words -%}
                      <span class="p-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                    {%- endfor -%}
                  </h2>
                  <div class="product-rule" aria-hidden="true"></div>
                </header>

                <p class="product-desc">{{ block.settings.description | default: 'An architectural flacon sculpted from heavyweight smoked French crystal, crowned with a 24-karat gold-gilded magnetic stopper. Each flacon is individually numbered.' }}</p>

                <div class="product-specs-list" aria-label="Flacon specifications">
                  <div class="product-spec-item" style="--psi:0">
                    <span class="spec-label">{{ block.settings.spec_1_label | default: 'Vessel Architecture' }}</span>
                    <span class="spec-val">{{ block.settings.spec_1_val | default: 'Smoked French crystal, 420g solid base' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:1">
                    <span class="spec-label">{{ block.settings.spec_2_label | default: 'The Stopper' }}</span>
                    <span class="spec-val">{{ block.settings.spec_2_val | default: 'Solid Zamak alloy, hand-gilded in 24K gold' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:2">
                    <span class="spec-label">{{ block.settings.spec_3_label | default: 'Maceration Period' }}</span>
                    <span class="spec-val">{{ block.settings.spec_3_val | default: '180 days in dark French oak casks' }}</span>
                  </div>
                  <div class="product-spec-item" style="--psi:3">
                    <span class="spec-label">{{ block.settings.spec_4_label | default: 'Origin & Batch' }}</span>
                    <span class="spec-val">{{ block.settings.spec_4_val | default: 'Limited Run of 500 bottles • Grasse & New Delhi' }}</span>
                  </div>
                </div>
              </div>

              <div class="product-stage" aria-hidden="true">
                <div class="stage-reticle">
                  <div class="reticle-circle reticle-circle--outer"></div>
                  <div class="reticle-circle reticle-circle--inner"></div>
                  <div class="reticle-cross reticle-cross--h"></div>
                  <div class="reticle-cross reticle-cross--v"></div>
                </div>
                <div class="stage-coords">
                  <span class="coord-tag">FLACON NO. 01 / 500</span>
                  <span class="coord-drag-hint">DRAG TO INSPECT 360°</span>
                </div>
              </div>

              <div class="product-flank product-flank--commerce">
                <div class="product-card" id="samay-product-card" data-variant-id="{{ variant_id_val }}">
                  {%- if block.settings.badge_text != blank -%}
                    <div class="product-badge-wrap">
                      <span class="product-badge">
                        <span class="badge-dot" aria-hidden="true"></span>
                        {{ block.settings.badge_text }}
                      </span>
                    </div>
                  {%- endif -%}

                  <div class="product-title-group">
                    <h3 class="product-card-title">{{ block.settings.title | default: 'Samay Extrait de Parfum' }}</h3>
                    <span class="product-card-sub">{{ block.settings.subtitle | default: 'Batch No. 01 — Rare Harvest' }}</span>
                  </div>

                  <div class="product-price-row">
                    <div class="price-stack">
                      <span class="product-price" data-price-display>{{ product_price }}</span>
                      {%- if product_compare != blank -%}
                        <span class="product-compare-price">{{ product_compare }}</span>
                      {%- endif -%}
                    </div>
                    <span class="product-volume" data-volume-display>{{ block.settings.volume | default: '100 ML — 3.4 FL. OZ.' }}</span>
                  </div>

                  <div class="product-size-selector" role="group" aria-label="Select Volume">
                    <span class="selector-label">Volume:</span>
                    <div class="size-options">
                      <button
                        type="button"
                        class="size-pill is-selected"
                        data-size="100ml"
                        data-price="{{ product_price }}"
                        data-volume="100 ML — 3.4 FL. OZ."
                        aria-pressed="true"
                      >
                        100 ML
                      </button>
                      <button
                        type="button"
                        class="size-pill"
                        data-size="50ml"
                        data-price="{{ block.settings.price_50ml | default: '₹14,800' }}"
                        data-volume="50 ML — 1.7 FL. OZ."
                        aria-pressed="false"
                      >
                        50 ML
                      </button>
                    </div>
                  </div>

                  <div class="product-action-buttons">
                    <button
                      type="button"
                      class="product-primary-cta"
                      id="samay-add-to-cart-btn"
                      aria-label="Add to cart"
                    >
                      <span class="cta-glow-line" aria-hidden="true"></span>
                      <span class="cta-text">Add to Shopping Bag</span>
                      <span class="cta-arrow" aria-hidden="true">→</span>
                    </button>

                    <button
                      type="button"
                      class="product-buy-now-btn"
                      id="samay-buy-now-btn"
                      aria-label="Buy now, proceed directly to checkout"
                    >
                      <span>Buy Now</span>
                    </button>
                  </div>

                  <div class="product-inclusions" aria-label="Purchase guarantees">
                    {%- if block.settings.inclusion_1 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_1 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_2 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_2 }}</span>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.inclusion_3 != blank -%}
                      <div class="inclusion-row">
                        <span class="inclusion-bullet" aria-hidden="true">◆</span>
                        <span class="inclusion-text">{{ block.settings.inclusion_3 }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                </div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'reviews' -%}
          {%- comment -%} ═══ PANEL 5: REVIEWS / VOICES (#reviews) ═══ {%- endcomment -%}
          <section
            id="reviews"
            class="samay-panel panel-reviews"
            data-panel="{{ panel_index }}"
            data-anchor="reviews"
            {{ block.shopify_attributes }}
            aria-label="Voices — {{ block.settings.heading | default: 'Voices in Reverie' }}"
          >
            <span class="reviews-chapter-bg" aria-hidden="true">05</span>

            <div class="reviews-layout" data-reviews-reveal>
              <div class="reviews-editorial">
                <header class="reviews-header">
                  <span class="reviews-eyebrow">{{ block.settings.eyebrow | default: 'Critical Acclaim' }}</span>
                  <h2 class="reviews-heading">
                    {%- assign r_words = block.settings.heading | default: 'Voices in Reverie' | split: ' ' -%}
                    {%- for word in r_words -%}
                      <span class="r-word">{{ word }}{%- unless forloop.last -%}&nbsp;{%- endunless -%}</span>
                    {%- endfor -%}
                  </h2>
                  <div class="reviews-rule" aria-hidden="true"></div>
                </header>

                <p class="reviews-desc">{{ block.settings.description | default: 'Words from collectors, perfumers, and quiet observers who have made Samay their signature hour.' }}</p>

                <div class="reviews-score-badge">
                  <div class="score-stars" aria-label="5 out of 5 stars">
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                  </div>
                  <div class="score-meta">
                    <span class="score-number">{{ block.settings.rating_score | default: '4.98' }}</span>
                    <span class="score-divider">/ 5.0</span>
                    <span class="score-count">{{ block.settings.rating_count | default: '1,240+ Verified Collectors' }}</span>
                  </div>
                </div>

                <blockquote class="reviews-press-quote">
                  <p class="press-text">“{{ block.settings.press_quote | default: 'A composition that does not merely enter a room — it quietly claims memory itself.' }}”</p>
                  <cite class="press-source">— {{ block.settings.press_source | default: 'Le Nez Critique, Paris' }}</cite>
                </blockquote>
              </div>

              <div class="reviews-carousel-col">
                <div class="reviews-slider-card">
                  <div class="reviews-card-header">
                    <span class="quote-glyph" aria-hidden="true">“</span>
                    <div class="reviews-counter" aria-live="polite">
                      <span class="review-counter-current">01</span>
                      <span class="counter-slash">/</span>
                      <span class="counter-total">03</span>
                    </div>
                  </div>

                  <div class="reviews-slider-track">
                    <article class="review-card is-active" data-index="0">
                      <div class="review-stars" aria-label="5 stars">★★★★★</div>
                      <p class="review-quote">{{ block.settings.review_1_text | default: 'The transition from the crisp bergamot to the smoky birch tar is intoxicating. It lingers on cashmere for days without ever feeling overpowering.' }}</p>
                      <footer class="review-author-wrap">
                        <div class="author-details">
                          <span class="author-name">{{ block.settings.review_1_author | default: 'Julian V.' }}</span>
                          <span class="author-loc">{{ block.settings.review_1_location | default: 'London, UK' }}</span>
                        </div>
                        <span class="author-badge">
                          <span class="badge-dot" aria-hidden="true"></span>
                          {{ block.settings.review_1_badge | default: 'Verified Collector • Batch 01' }}
                        </span>
                      </footer>
                    </article>

                    <article class="review-card" data-index="1">
                      <div class="review-stars" aria-label="5 stars">★★★★★</div>
                      <p class="review-quote">{{ block.settings.review_2_text | default: 'You can taste the authenticity of the Assam agarwood and Mysore sandalwood. Nothing synthetic. A masterclass in restraint and quiet luxury.' }}</p>
                      <footer class="review-author-wrap">
                        <div class="author-details">
                          <span class="author-name">{{ block.settings.review_2_author | default: 'Dr. Ananya S.' }}</span>
                          <span class="author-loc">{{ block.settings.review_2_location | default: 'New Delhi, India' }}</span>
                        </div>
                        <span class="author-badge">
                          <span class="badge-dot" aria-hidden="true"></span>
                          {{ block.settings.review_2_badge | default: 'Artisan Patron' }}
                        </span>
                      </footer>
                    </article>

                    <article class="review-card" data-index="2">
                      <div class="review-stars" aria-label="5 stars">★★★★★</div>
                      <p class="review-quote">{{ block.settings.review_3_text | default: 'Rarely does a contemporary house achieve such timeless gravitas. Samay has bottled the quiet golden hour of twilight.' }}</p>
                      <footer class="review-author-wrap">
                        <div class="author-details">
                          <span class="author-name">{{ block.settings.review_3_author | default: "Harper's Bazaar Art" }}</span>
                          <span class="author-loc">{{ block.settings.review_3_location | default: 'Editorial Feature' }}</span>
                        </div>
                        <span class="author-badge">
                          <span class="badge-dot" aria-hidden="true"></span>
                          {{ block.settings.review_3_badge | default: 'Fragrance of the Year Mention' }}
                        </span>
                      </footer>
                    </article>
                  </div>

                  <div class="reviews-nav-bar">
                    <div class="review-dots" role="tablist" aria-label="Review pagination">
                      <button type="button" class="review-dot is-active" aria-label="Review 1" aria-pressed="true" data-index="0"></button>
                      <button type="button" class="review-dot" aria-label="Review 2" aria-pressed="false" data-index="1"></button>
                      <button type="button" class="review-dot" aria-label="Review 3" aria-pressed="false" data-index="2"></button>
                    </div>

                    <div class="review-arrows">
                      <button type="button" class="review-nav-btn review-nav-btn--prev" aria-label="Previous review">
                        <span class="arrow-sym" aria-hidden="true">←</span>
                      </button>
                      <button type="button" class="review-nav-btn review-nav-btn--next" aria-label="Next review">
                        <span class="arrow-sym" aria-hidden="true">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="reviews-bottle-stage" aria-hidden="true">
                <div class="bottle-glow-halo"></div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'faq' -%}
          {%- comment -%} ═══ PANEL 6: FAQ ACCORDION (#faq) ═══ {%- endcomment -%}
          <section
            id="faq"
            class="samay-panel panel-faq"
            data-panel="{{ panel_index }}"
            data-anchor="faq"
            {{ block.shopify_attributes }}
            aria-label="FAQ — {{ block.settings.heading | default: 'Frequently Asked Questions' }}"
          >
            <span class="faq-chapter-bg" aria-hidden="true">06</span>

            <div class="faq-layout" data-faq-reveal>
              <header class="faq-header">
                <span class="faq-eyebrow">{{ block.settings.eyebrow | default: 'Inquiries & Guidance' }}</span>
                <h2 class="faq-heading">{{ block.settings.heading | default: 'Frequently Asked Questions' }}</h2>
                <div class="faq-rule" aria-hidden="true"></div>
                {%- if block.settings.subtext != blank -%}
                  <p class="faq-subtext">{{ block.settings.subtext }}</p>
                {%- endif -%}
              </header>

              <div class="faq-accordion-container" role="region" aria-label="Questions list">
                {%- for i in (1..6) -%}
                  {%- assign q_key = 'q' | append: i -%}
                  {%- assign a_key = 'a' | append: i -%}
                  {%- assign question = block.settings[q_key] -%}
                  {%- assign answer   = block.settings[a_key] -%}

                  {%- if question != blank and answer != blank -%}
                    <div class="faq-accordion-item{% if forloop.first %} is-open{% endif %}" data-faq-item>
                      <button
                        type="button"
                        class="faq-accordion-header"
                        aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-controls="faq-content-{{ block.id }}-{{ i }}"
                        id="faq-header-{{ block.id }}-{{ i }}"
                      >
                        <span class="faq-item-num">0{{ i }}</span>
                        <span class="faq-item-question">{{ question }}</span>
                        <span class="faq-item-icon" aria-hidden="true"></span>
                      </button>
                      <div
                        id="faq-content-{{ block.id }}-{{ i }}"
                        class="faq-accordion-content"
                        role="region"
                        aria-labelledby="faq-header-{{ block.id }}-{{ i }}"
                        {% unless forloop.first %}style="max-height:0;"{% endunless %}
                      >
                        <div class="faq-accordion-body">
                          <p>{{ answer }}</p>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </section>

        {%- elsif block.type == 'contact' -%}
          {%- comment -%} ═══ PANEL 7: CONTACT (#contact) ═══ {%- endcomment -%}
          <section
            id="contact"
            class="samay-panel panel-contact"
            data-panel="{{ panel_index }}"
            data-anchor="contact"
            {{ block.shopify_attributes }}
            aria-label="Contact — {{ block.settings.heading | default: 'Connect with the House' }}"
          >
            <span class="contact-chapter-bg" aria-hidden="true">07</span>

            <div class="contact-layout" data-contact-reveal>
              <div class="contact-col-info">
                <header class="contact-header">
                  <span class="contact-eyebrow">{{ block.settings.eyebrow | default: 'Direct Concierge' }}</span>
                  <h2 class="contact-heading">{{ block.settings.heading | default: 'Connect with the House' }}</h2>
                  <div class="contact-rule" aria-hidden="true"></div>
                  <p class="contact-subtext">{{ block.settings.subtext | default: 'Our concierge is at your service for bespoke inquiries, private appointments, and flacon reservations.' }}</p>
                </header>

                <div class="contact-meta-list">
                  {%- if block.settings.concierge_email != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Email Concierge</span>
                      <a href="mailto:{{ block.settings.concierge_email }}" class="meta-value">{{ block.settings.concierge_email }}</a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.concierge_phone != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Direct Line</span>
                      <a href="tel:{{ block.settings.concierge_phone | replace: ' ', '' }}" class="meta-value">{{ block.settings.concierge_phone }}</a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.concierge_city != blank -%}
                    <div class="contact-meta-item">
                      <span class="meta-label">Atelier</span>
                      <span class="meta-value">{{ block.settings.concierge_city }}</span>
                    </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.whatsapp_number != blank -%}
                  <div class="contact-whatsapp-wrap">
                    {%- assign wa_num = block.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
                    {%- assign wa_msg = block.settings.whatsapp_message | default: 'Hello Samay Parfumes, I would like to inquire about the collection.' | url_encode -%}
                    <a
                      href="https://wa.me/{{ wa_num }}?text={{ wa_msg }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="contact-whatsapp-btn"
                      aria-label="Connect via WhatsApp"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.969.529 1.772.78 2.792.78 3.182 0 5.768-2.587 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.503-4.467 9.97-9.97 9.97-1.745 0-3.376-.452-4.796-1.242l-5.234 1.371 1.396-5.105c-.896-1.488-1.396-3.218-1.396-4.994 0-5.503 4.467-9.97 9.97-9.97 5.503 0 9.97 4.467 9.97 9.97z"/>
                      </svg>
                      <span>Chat on WhatsApp</span>
                    </a>
                  </div>
                {%- endif -%}
              </div>

              <div class="contact-col-form">
                <div class="contact-form-card">
                  {%- form 'contact', id: 'SamayContactForm', class: 'samay-ajax-contact-form' -%}
                    <div class="form-feedback-box" id="contact-form-feedback" aria-live="polite">
                      {%- if form.posted_successfully? -%}
                        <div class="form-status form-status--success">
                          <span class="status-icon">✓</span>
                          <span>Thank you. Your message has been received by our private concierge.</span>
                        </div>
                      {%- elsif form.errors -%}
                        <div class="form-status form-status--error">
                          <span class="status-icon">!</span>
                          <span>Please verify your details: {{ form.errors | default_errors }}</span>
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="form-row">
                      <div class="form-field">
                        <label for="ContactForm-name" class="form-label">Full Name</label>
                        <input
                          type="text"
                          id="ContactForm-name"
                          name="contact[name]"
                          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                          placeholder="Lord / Lady / Collector"
                          class="form-input"
                          required
                        >
                      </div>

                      <div class="form-field">
                        <label for="ContactForm-email" class="form-label">Email Address</label>
                        <input
                          type="email"
                          id="ContactForm-email"
                          name="contact[email]"
                          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                          placeholder="client@domain.com"
                          class="form-input"
                          required
                          spellcheck="false"
                          autocomplete="email"
                        >
                      </div>
                    </div>

                    <div class="form-field">
                      <label for="ContactForm-phone" class="form-label">Phone Number (Optional)</label>
                      <input
                        type="tel"
                        id="ContactForm-phone"
                        name="contact[phone]"
                        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                        placeholder="+91 00000 00000"
                        class="form-input"
                        autocomplete="tel"
                      >
                    </div>

                    <div class="form-field">
                      <label for="ContactForm-message" class="form-label">Your Message or Inquiry</label>
                      <textarea
                        id="ContactForm-message"
                        name="contact[body]"
                        rows="4"
                        placeholder="Inquire about custom allocations, private discovery sessions, or international shipping..."
                        class="form-textarea"
                        required
                      >{{ form.body }}</textarea>
                    </div>

                    <button type="submit" class="contact-submit-btn" id="contact-submit-btn">
                      <span class="submit-text">Transmit Message</span>
                      <span class="submit-arrow" aria-hidden="true">→</span>
                    </button>
                  {%- endform -%}
                </div>
              </div>
            </div>
          </section>

        {%- elsif block.type == 'footer_panel' -%}
          {%- comment -%} ═══ PANEL 8: FOOTER (#footer) ═══ {%- endcomment -%}
          <section
            id="footer"
            class="samay-panel panel-footer"
            data-panel="{{ panel_index }}"
            data-anchor="footer"
            {{ block.shopify_attributes }}
            aria-label="Footer &amp; Policies"
          >
