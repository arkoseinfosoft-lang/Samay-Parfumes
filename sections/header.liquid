{% comment %}
  SAMAY PARFUMES - LUXURY HEADER & ANNOUNCEMENT BAR
{% endcomment %}

<!-- Announcement Bar -->
<div class="samay-announcement-bar">
  <div class="samay-announcement-content">
    <div class="samay-announce-track">
      <span>✦ LAUNCH RESERVE: FLAT 30% OFF ALL ZAYRO EDITIONS</span>
      <span class="highlight">CODE: SAMAY30</span>
      <span>✦ COMPLIMENTARY EXPRESS DELIVERY ACROSS INDIA ✦</span>
      <span class="samay-announce-repeat">✦ 6-8 HOURS EAU DE PARFUM STRENGTH ✦</span>
    </div>
  </div>
</div>

<!-- Header -->
<header class="samay-header-wrapper" id="samayHeader">
  <div class="container samay-header-container">
    <div class="samay-header">
      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="samay-mobile-menu-btn" 
        id="samayMobileToggle" 
        aria-label="Open Navigation Menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>

      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="samay-logo-link" aria-label="Samay Parfumes Home">
        <img 
          src="{{ 'samay-logo-black.png' | asset_url }}" 
          alt="Samay Parfumes Logo" 
          class="samay-header-logo-img"
          width="192"
          height="70"
          loading="eager"
        >
      </a>

      <!-- Desktop Navigation -->
      <nav class="samay-nav" id="samayNav" aria-label="Main Navigation">
        <a href="#collection" class="samay-nav-link">Combos</a>
        <a href="#notes" class="samay-nav-link">The Notes</a>
        <a href="#about" class="samay-nav-link">About Us</a>
        <a href="#contact" class="samay-nav-link">Contact & FAQ</a>
      </nav>

      <!-- Header Actions -->
      <div class="samay-header-actions">
        <a href="#collection" class="samay-header-cta-btn">
          SHOP ZAYRO
        </a>

        <button 
          type="button" 
          class="samay-cart-trigger" 
          aria-label="View Shopping Bag"
          onclick="window.samayCart && window.samayCart.open()"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="samay-cart-badge" style="display: none;">0</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div class="samay-mobile-drawer-overlay" id="samayMobileDrawerOverlay">
  <div class="samay-mobile-drawer">
    <div class="samay-mobile-drawer-header">
      <a href="{{ routes.root_url }}" aria-label="Samay Parfumes Home">
        <img 
          src="{{ 'samay-logo-black.png' | asset_url }}" 
          alt="Samay Parfumes" 
          class="samay-mobile-drawer-logo-img"
          width="150"
          height="54"
        >
      </a>
      <button type="button" class="samay-mobile-drawer-close" id="samayMobileDrawerClose" aria-label="Close Menu">
        ✕
      </button>
    </div>

    <div class="samay-mobile-drawer-links">
      <a href="#collection" class="samay-mobile-link">2-in-1 Duo Combo <span class="samay-nav-tag">Popular</span></a>
      <a href="#collection" class="samay-mobile-link">3-in-1 Grand Trio <span class="samay-nav-tag gold">Best Value</span></a>
      <a href="#notes" class="samay-mobile-link">The Notes</a>
      <a href="#about" class="samay-mobile-link">About Us</a>
      <a href="#contact" class="samay-mobile-link">Contact & FAQ</a>
    </div>

    <div class="samay-mobile-drawer-footer">
      <a href="#collection" class="samay-btn samay-btn--gold samay-btn--full" style="padding: 14px;" id="samayMobileDrawerCta">
        SHOP ZAYRO EDITIONS
      </a>
      <div style="margin-top: 14px; text-align: center; font-size: 0.78rem; color: var(--taupe);">
        A Fragrance Beyond Time · Free Express Shipping
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Header",
  "settings": []
}
{% endschema %}
