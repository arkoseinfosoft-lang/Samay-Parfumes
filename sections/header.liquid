{% comment %}
  SAMAY PARFUMES - LUXURY HEADER & ANNOUNCEMENT BAR
{% endcomment %}

<!-- Announcement Bar -->
<div class="samay-announcement-bar">
  <div class="samay-announcement-content">
    <div class="samay-announce-track">
      <span>{{ section.settings.announcement_text | default: '✦ Introductory offer · Free shipping across India' }}</span>
      <span class="samay-announce-repeat">✦ Eau de Parfum ✦</span>
    </div>
  </div>
</div>

<!-- Header -->
<header class="samay-header-wrapper" id="samayHeader">
  <div class="container samay-header-container">
    <div class="samay-header">
      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="samay-mobile-menu-btn" 
        id="samayMobileToggle" 
        aria-label="Open Navigation Menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>

      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="samay-logo-link" aria-label="{{ shop.name | escape }}">
        <img 
          src="{{ 'samay-logo.png' | asset_url }}" 
          alt="{{ shop.name | escape }}" 
          class="samay-header-logo-img"
          width="210"
          height="64"
          loading="eager"
          fetchpriority="high"
        >
      </a>

      <!-- Desktop Navigation -->
      <nav class="samay-nav" id="samayNav" aria-label="Main Navigation">
        <a href="{{ routes.root_url }}#collection" class="samay-nav-link">Combos</a>
        <a href="{{ routes.root_url }}#notes" class="samay-nav-link">The Notes</a>
        <a href="{{ routes.root_url }}#about" class="samay-nav-link">About Us</a>
        <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="samay-nav-link">Contact</a>
      </nav>

      <!-- Header Actions -->
      <div class="samay-header-actions">
        <a href="{{ routes.root_url }}#collection" class="samay-btn samay-btn--gold samay-header-cta-btn">
          SHOP ZAYRO
        </a>

        <a 
          href="{{ routes.cart_url }}" 
          class="samay-cart-trigger" 
          id="samayCartTrigger"
          aria-label="View Shopping Bag"
          onclick="if (window.samayCart && typeof window.samayCart.open === 'function') { event.preventDefault(); window.samayCart.open(); }"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="samay-cart-badge" style="{% if cart.item_count == 0 %}display: none;{% endif %}">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div class="samay-mobile-drawer-overlay" id="samayMobileDrawerOverlay">
  <div class="samay-mobile-drawer">
    <div class="samay-mobile-drawer-header">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img 
          src="{{ 'samay-logo.png' | asset_url }}" 
          alt="{{ shop.name | escape }}" 
          class="samay-mobile-drawer-logo-img"
          width="145"
          height="44"
          loading="eager"
        >
      </a>
      <button type="button" class="samay-mobile-drawer-close" id="samayMobileDrawerClose" aria-label="Close Menu">
        ✕
      </button>
    </div>

    <div class="samay-mobile-drawer-links">
      <a href="{{ routes.root_url }}#collection" class="samay-mobile-link">Combos <span class="samay-nav-tag">Popular</span></a>
      <a href="{{ routes.root_url }}#collection" class="samay-mobile-link">Grand Trio <span class="samay-nav-tag gold">3 Bottles</span></a>
      <a href="{{ routes.root_url }}#notes" class="samay-mobile-link">The Notes</a>
      <a href="{{ routes.root_url }}#about" class="samay-mobile-link">About Us</a>
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="samay-mobile-link">Contact & FAQ</a>
    </div>

    <div class="samay-mobile-drawer-footer">
      <a href="{{ routes.root_url }}#collection" class="samay-btn samay-btn--gold samay-btn--full" style="padding: 14px;" id="samayMobileDrawerCta">
        SHOP SAMAY
      </a>
      <div style="margin-top: 14px; text-align: center; font-size: var(--fs-xs); color: var(--samay-gold, #d4af37);">
        Artisanal Eau de Parfum · Free Shipping Across India
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "✦ Introductory offer · Free shipping across India"
    }
  ]
}
{% endschema %}
