<!-- PDP Interactive Client Logic -->
<script>
  (function() {
    function initPdp() {
      // 1. Gallery Thumbnail Click
      var thumbs = document.querySelectorAll('.samay-pdp-thumb-btn');
      var mainImg = document.getElementById('samayPdpMainImg');
      if (thumbs.length && mainImg) {
        thumbs.forEach(function(btn) {
          btn.addEventListener('click', function() {
            thumbs.forEach(function(b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            var newSrc = btn.getAttribute('data-image-src');
            if (newSrc) {
              mainImg.src = newSrc;
            }
          });
        });
      }

      // 2. Quantity Stepper
      var minusBtn = document.getElementById('samayPdpQtyMinus');
      var plusBtn = document.getElementById('samayPdpQtyPlus');
      var qtyInput = document.getElementById('samayPdpQtyInput');
      if (minusBtn && plusBtn && qtyInput) {
        minusBtn.addEventListener('click', function() {
          var val = parseInt(qtyInput.value, 10) || 1;
          if (val > 1) qtyInput.value = val - 1;
        });
        plusBtn.addEventListener('click', function() {
          var val = parseInt(qtyInput.value, 10) || 1;
          if (val < 99) qtyInput.value = val + 1;
        });
      }

      // 3. Variant Pills Selection
      var pills = document.querySelectorAll('.samay-variant-pill');
      var select = document.getElementById('samayVariantSelect');
      var priceEl = document.getElementById('samayPdpPrice');
      var compareEl = document.getElementById('samayPdpCompare');
      var discountEl = document.getElementById('samayPdpDiscount');
      var addBtn = document.getElementById('samayPdpAddToCartBtn');

      if (pills.length && select) {
        pills.forEach(function(pill) {
          pill.addEventListener('click', function() {
            pills.forEach(function(p) { p.classList.remove('is-active'); });
            pill.classList.add('is-active');
            var varId = pill.getAttribute('data-variant-id');
            select.value = varId;

            var opt = select.querySelector('option[value="' + varId + '"]');
            if (opt) {
              var priceText = opt.getAttribute('data-price');
              var compareText = opt.getAttribute('data-compare');
              var rawPrice = parseFloat(opt.getAttribute('data-raw-price')) || 0;
              var rawCompare = parseFloat(opt.getAttribute('data-raw-compare')) || 0;
              var isAvail = opt.getAttribute('data-available') === 'true';

              if (priceEl && priceText) priceEl.textContent = priceText;
              if (compareEl) {
                if (rawCompare > rawPrice) {
                  compareEl.textContent = compareText;
                  compareEl.style.display = 'inline';
                  if (discountEl) {
                    var pct = Math.round(((rawCompare - rawPrice) / rawCompare) * 100);
                    discountEl.textContent = '-' + pct + '% OFF';
                    discountEl.style.display = 'inline';
                  }
                } else {
                  compareEl.style.display = 'none';
                  if (discountEl) discountEl.style.display = 'none';
                }
              }

              if (addBtn) {
                if (isAvail) {
                  addBtn.disabled = false;
                  addBtn.textContent = 'ADD TO SHOPPING BAG';
                } else {
                  addBtn.disabled = true;
                  addBtn.textContent = 'OUT OF STOCK';
                }
              }

              // Update Low-Stock Alert reactively
              var alertEl = document.getElementById('samayPdpStockAlert');
              var qtyEl = document.getElementById('samayPdpStockQty');
              if (alertEl) {
                var threshold = parseInt(alertEl.getAttribute('data-threshold'), 10) || 20;
                var invMgmt = opt.getAttribute('data-inventory-management') || pill.getAttribute('data-inventory-management') || '';
                var invQtyStr = opt.getAttribute('data-inventory-quantity') || pill.getAttribute('data-inventory-quantity') || '0';
                var invQty = parseInt(invQtyStr, 10);
                var isTracked = invMgmt && invMgmt.trim() !== '' && invMgmt !== 'null';

                if (isTracked && isAvail && !isNaN(invQty) && invQty > 0 && invQty <= threshold) {
                  if (qtyEl) qtyEl.textContent = invQty;
                  alertEl.style.display = 'inline-flex';
                } else {
                  alertEl.style.display = 'none';
                }
              }
            }
          });
        });
      }

      // 4. Add to Cart with window.samayCart
      if (addBtn) {
        addBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var variantId = select ? select.value : '{{ current_variant.id }}';
          var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;

          if (window.samayCart && typeof window.samayCart.add === 'function') {
            window.samayCart.add(variantId, qty);
          } else {
            // Fallback native submit
            var form = document.getElementById('samayProductForm');
            if (form) form.submit();
          }
        });
      }

      // 5. Accordion Toggles
      var accordions = document.querySelectorAll('.samay-accordion');
      accordions.forEach(function(acc) {
        var trigger = acc.querySelector('.samay-accordion-trigger');
        if (trigger) {
          trigger.addEventListener('click', function() {
            var isOpen = acc.classList.contains('is-open');
            acc.classList.toggle('is-open', !isOpen);
            trigger.setAttribute('aria-expanded', !isOpen);
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdp);
    } else {
      initPdp();
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury Product Detail",
  "settings": [
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 1,
      "max": 100,
      "step": 1,
      "label": "Low stock alert threshold",
      "default": 50
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
