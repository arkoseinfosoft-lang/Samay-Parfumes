{% comment %}
  SAMAY PARFUMES - LUXURY PRODUCT DETAIL TEMPLATE (PDP)
  Mobile-first architecture, rich imagery, variant picker, quantity stepper,
  AJAX cart integration via window.samayCart, and olfactory accordions.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign compare_at = current_variant.compare_at_price -%}
{%- assign price = current_variant.price -%}
{%- assign on_sale = false -%}
{%- if compare_at and compare_at > price -%}
  {%- assign on_sale = true -%}
  {%- assign discount_percent = compare_at | minus: price | times: 100 | divided_by: compare_at -%}
{%- endif -%}

{%- assign low_stock_threshold = section.settings.low_stock_threshold | default: 20 -%}

{%- assign fallback_img = 'samay-product-single.webp' | asset_url -%}
{%- if product.handle contains 'duo' -%}
  {%- assign fallback_img = 'samay-product-duo.webp' | asset_url -%}
{%- elsif product.handle contains 'trio' -%}
  {%- assign fallback_img = 'samay-product-trio.webp' | asset_url -%}
{%- endif -%}

<section class="samay-pdp-section" id="samayPdpSection" data-product-id="{{ product.id }}">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="samay-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="samay-breadcrumb-sep">/</span>
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">Collections</a>
      <span class="samay-breadcrumb-sep">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="samay-pdp-grid">
      <!-- Media Gallery -->
      <div class="samay-pdp-gallery">
        <div class="samay-pdp-main-media">
          <span class="samay-pdp-badge">✦ EAU DE PARFUM · 50ML</span>
          {%- if product.featured_image -%}
            <img 
              id="samayPdpMainImg"
              src="{{ product.featured_image | image_url: width: 1024 }}" 
              alt="{{ product.title | escape }}" 
              class="samay-pdp-main-img"
              width="1024"
              height="682"
              loading="eager"
            >
          {%- else -%}
            <img 
              id="samayPdpMainImg"
              src="{{ fallback_img }}" 
              alt="{{ product.title | escape }}" 
              class="samay-pdp-main-img"
              width="1024"
              height="682"
              loading="eager"
            >
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="samay-pdp-thumbs" id="samayPdpThumbs" role="tablist" aria-label="Product Gallery Thumbnails">
            {%- for img in product.images -%}
              <button 
                type="button" 
                class="samay-pdp-thumb-btn {% if forloop.first %}is-active{% endif %}"
                data-image-src="{{ img | image_url: width: 1024 }}"
                aria-label="View product image {{ forloop.index }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img src="{{ img | image_url: width: 150, height: 150, crop: 'center' }}" alt="{{ img.alt | default: product.title | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Information & Order Actions -->
      <div class="samay-pdp-details">
        <div class="samay-pdp-kicker">MAISON SAMAY · ARTISAN PERFUMERY</div>
        <h1 class="samay-pdp-title">{{ product.title }}</h1>
        <div class="samay-pdp-rating">
          <span>Eau de Parfum &middot; 6&ndash;8 Hours Longevity</span>
        </div>

        <!-- Price Row -->
        <div class="samay-pdp-price-row">
          <span class="samay-pdp-price" id="samayPdpPrice">{{ price | money }}</span>
          <span class="samay-pdp-compare" id="samayPdpCompare" style="{% unless on_sale %}display: none;{% endunless %}">
            {{ compare_at | money }}
          </span>
          <span class="samay-pdp-save-badge" id="samayPdpDiscount" style="{% unless on_sale %}display: none;{% endunless %}">
            -{{ discount_percent }}% OFF
          </span>
        </div>

        <!-- Red Low-Stock Alert (Only shown when inventory tracked, >0, and <= threshold) -->
        {%- render 'stock-alert', variant: current_variant, threshold: low_stock_threshold, is_pdp: true -%}

        <div class="samay-pdp-shipping-badge">
          <span>✦</span>
          <span><strong>Free Express Shipping across India</strong> · Inclusive of all taxes</span>
        </div>

        <!-- Product Description Dropdown (Amazon-style on mobile) -->
        <div class="samay-pdp-desc-wrap">
          <div class="samay-pdp-desc-accordion samay-accordion" id="samayPdpDescAccordion">
            <button 
              type="button" 
              class="samay-accordion-trigger samay-pdp-desc-trigger" 
              aria-expanded="false"
              aria-controls="samayPdpDescBody"
            >
              <span class="samay-pdp-desc-trigger-label">
                <span class="samay-pdp-desc-title">Description</span>
              </span>
              <span class="samay-accordion-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="samay-pdp-desc-chevron" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </button>
            <div class="samay-accordion-body samay-pdp-desc-body" id="samayPdpDescBody">
              {%- if product.description != blank -%}
                <div class="samay-pdp-desc">
                  {{ product.description }}
                </div>
              {%- else -%}
                <div class="samay-pdp-desc">
                  <p>
                    Handcrafted with a blend of citrus, spice, florals, and amber oud. Zayro is formulated with a potent 15-20% pure perfume oil concentration to command presence and leave an indelible olfactory impression.
                  </p>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

        <!-- Add to Cart Form -->
        {%- form 'product', product, id: 'samayProductForm', class: 'samay-pdp-form' -%}
          <!-- Hidden Variant Select for Native Fallback -->
          <select name="id" id="samayVariantSelect" style="display: none;">
            {%- for variant in product.variants -%}
              <option 
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected="selected"{% endif %}
                data-price="{{ variant.price | money }}"
                data-compare="{{ variant.compare_at_price | money }}"
                data-raw-price="{{ variant.price }}"
                data-raw-compare="{{ variant.compare_at_price }}"
                data-available="{{ variant.available }}"
                data-inventory-management="{{ variant.inventory_management }}"
                data-inventory-quantity="{{ variant.inventory_quantity }}"
              >
                {{ variant.title }}
              </option>
            {%- endfor -%}
          </select>

          <!-- Interactive Variant Pills (if more than 1 variant) -->
          {%- if product.variants.size > 1 -%}
            <div class="samay-pdp-variants">
              <span class="samay-pdp-label">Select Edition</span>
              <div class="samay-variant-pills" id="samayVariantPills">
                {%- for variant in product.variants -%}
                  <button 
                    type="button" 
                    class="samay-variant-pill {% if variant == current_variant %}is-active{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-available="{{ variant.available }}"
                    data-inventory-management="{{ variant.inventory_management }}"
                    data-inventory-quantity="{{ variant.inventory_quantity }}"
                  >
                    {{ variant.title }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Quantity Stepper & Add to Cart -->
          <div class="samay-pdp-actions">
            <div class="samay-pdp-qty-row">
              <div class="samay-qty-stepper">
                <button type="button" id="samayPdpQtyMinus" aria-label="Decrease quantity">−</button>
                <input type="number" id="samayPdpQtyInput" name="quantity" value="1" min="1" max="99" aria-label="Product Quantity">
                <button type="button" id="samayPdpQtyPlus" aria-label="Increase quantity">+</button>
              </div>

              <button 
                type="button" 
                id="samayPdpAddToCartBtn"
                class="samay-btn samay-btn--gold samay-pdp-add-btn"
                {% unless current_variant.available %}disabled="disabled"{% endunless %}
              >
                {%- if current_variant.available -%}
                  ADD TO SHOPPING BAG
                {%- else -%}
                  OUT OF STOCK
                {%- endif -%}
              </button>
            </div>

            {{ form | payment_button }}
          </div>
        {%- endform -%}

        <!-- Trust Badges Strip -->
        <div class="samay-pdp-trust">
          <div class="samay-pdp-trust-item">
            <span>✦</span>
            <span>Free Express Courier</span>
          </div>
          <div class="samay-pdp-trust-item">
            <span>⌛</span>
            <span>6-8 Hours Longevity</span>
          </div>
          <div class="samay-pdp-trust-item">
            <span>⚜</span>
            <span>15-20% Perfume Oil</span>
          </div>
          <div class="samay-pdp-trust-item">
            <span>✦</span>
            <span>Handcrafted in India</span>
          </div>
        </div>

        <!-- Luxury Accordions for Olfactory Notes & Details -->
        <div class="samay-pdp-accordions" id="samayPdpAccordions">
          <!-- Accordion 1: Olfactory Pyramid -->
          <div class="samay-accordion is-open">
            <button type="button" class="samay-accordion-trigger" id="PdpAccordionTrigger1" aria-expanded="true" aria-controls="PdpAccordionBody1">
              <span>Olfactory Pyramid & Notes</span>
              <span class="samay-accordion-icon">+</span>
            </button>
            <div class="samay-accordion-body" id="PdpAccordionBody1" role="region" aria-labelledby="PdpAccordionTrigger1">
              <p style="margin-bottom: 10px;">
                <strong>Top Notes:</strong> Bergamot, Sparkling Lemon Zest, Crisp Green Apple.<br>
                <strong>Heart Notes:</strong> Lavender, Birch Wood, Violet Leaf.<br>
                <strong>Base Notes:</strong> Amber Crystals, Smoked Cedarwood, Sensual White Musk.
              </p>
              <p style="font-size: 0.85rem; color: var(--dim); margin: 0;">
                Designed to evolve dynamically over 8 hours from radiant citrus to an addictive warm amber and oud trail.
              </p>
            </div>
          </div>

          <!-- Accordion 2: Performance & Application -->
          <div class="samay-accordion">
            <button type="button" class="samay-accordion-trigger" id="PdpAccordionTrigger2" aria-expanded="false" aria-controls="PdpAccordionBody2">
              <span>Performance & Longevity</span>
              <span class="samay-accordion-icon">+</span>
            </button>
            <div class="samay-accordion-body" id="PdpAccordionBody2" role="region" aria-labelledby="PdpAccordionTrigger2">
              <p>
                Concentrated at an authentic 15-20% pure oil ratio (Eau de Parfum grade). Delivers up to 6-8 hours (varies by skin) of longevity with moderate to strong projection for the first 3 hours. Apply 3-4 sprays to pulse points (neck, collarbones, inner wrists) for optimal sillage.
              </p>
            </div>
          </div>

          <!-- Accordion 3: Delivery & Complimentary Shipping -->
          <div class="samay-accordion">
            <button type="button" class="samay-accordion-trigger" id="PdpAccordionTrigger3" aria-expanded="false" aria-controls="PdpAccordionBody3">
              <span>Shipping & Delivery across India</span>
              <span class="samay-accordion-icon">+</span>
            </button>
            <div class="samay-accordion-body" id="PdpAccordionBody3" role="region" aria-labelledby="PdpAccordionTrigger3">
              <p>
                Express courier delivery is 100% complimentary across all pin codes in India. Metro cities receive dispatch in 24 hours with arrival in 2-3 business days. All orders ship with secure packaging and real-time SMS tracking updates.
              </p>
            </div>
          </div>

          <!-- Accordion 4: Artisan Flacon & Packaging -->
          <div class="samay-accordion">
            <button type="button" class="samay-accordion-trigger" id="PdpAccordionTrigger4" aria-expanded="false" aria-controls="PdpAccordionBody4">
              <span>Flacon & Presentation</span>
              <span class="samay-accordion-icon">+</span>
            </button>
            <div class="samay-accordion-body" id="PdpAccordionBody4" role="region" aria-labelledby="PdpAccordionTrigger4">
              <p>
                Each flacon is cast from heavyweight crystal glass embossed with the timeless Samay pocket-watch emblem, crowned by a satisfying magnetic closure and precision micro-mist atomiser. Presented in an embossed gold-foil gift presentation box.
              </p>
            </div>
          </div>

          <!-- Accordion 5: Frequently Asked Questions -->
          <div class="samay-accordion" id="faq">
            <button type="button" class="samay-accordion-trigger" id="PdpAccordionTrigger5" aria-expanded="false" aria-controls="PdpAccordionBody5">
              <span>Frequently Asked Questions</span>
              <span class="samay-accordion-icon">+</span>
            </button>
            <div class="samay-accordion-body" id="PdpAccordionBody5" role="region" aria-labelledby="PdpAccordionTrigger5">
              <p style="margin-bottom: 12px;">
                <strong>How long does Zayro last?</strong><br>
                Zayro is formulated as an Eau de Parfum (15-20% oil concentration), delivering up to 6-8 hours of wear on skin (varies by skin) and throughout the day on fabrics.
              </p>
              <p style="margin-bottom: 12px;">
                <strong>Is shipping really free across India?</strong><br>
                Yes! We offer 100% complimentary express shipping on all orders to all pin codes in India with delivery in 2-3 business days for metro areas.
              </p>
              <p style="margin-bottom: 12px;">
                <strong>What if my bottle arrives damaged?</strong><br>
                If your bottle is damaged or leaking in transit, send photo and video evidence within 48 hours to samayparfume@gmail.com and we dispatch an immediate replacement at zero cost.
              </p>
              <p style="margin: 0;">
                <strong>What payment methods are supported?</strong><br>
                We accept Cash on Delivery (COD), UPI (Google Pay, PhonePe, Paytm), NetBanking, and all major debit/credit cards.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

