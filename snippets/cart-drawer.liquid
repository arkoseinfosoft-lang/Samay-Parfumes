{% comment %}
  SAMAY PARFUMES - GLOBAL SLIDE-OUT CART DRAWER & OVERLAY
{% endcomment %}
<div class="samay-cart-drawer-overlay" id="samayCartOverlay">
  <div class="samay-cart-drawer">
    <div class="samay-drawer-header">
      <h3 class="samay-drawer-title">Shopping Bag</h3>
      <button type="button" class="samay-drawer-close" onclick="window.samayCart && window.samayCart.close()" aria-label="Close Shopping Bag">✕</button>
    </div>

    <div class="samay-drawer-body">
      <div class="samay-cart-free-shipping" id="samayCartFreeShipping" style="{% if cart.item_count == 0 %}display: none;{% endif %}">
        ✦ <strong>Free shipping across India</strong> unlocked on your order!
      </div>
      <div id="samayCartDrawerItems">
        <!-- Rendered dynamically by samay.js -->
      </div>
    </div>

    <div class="samay-drawer-footer" id="samayDrawerFooter">
      <div class="samay-drawer-subtotal">
        <span>Estimated Total</span>
        <strong id="samayCartSubtotal">{{ cart.original_total_price | default: cart.items_subtotal_price | default: cart.total_price | money }}</strong>
      </div>
      <div class="samay-drawer-tax-note">All taxes included · Free shipping across India</div>
      <form action="{{ routes.cart_url | default: '/cart' }}" method="post" id="samayCartDrawerForm" class="samay-cart-drawer-form" style="width: 100%; margin: 0;">
        <div id="samayCartCouponBox" style="{% if cart.item_count == 0 %}display: none;{% endif %}">
          {%- render 'coupon-banner' -%}
        </div>
        <button type="submit" name="checkout" id="samayCartCheckoutBtn" class="samay-btn samay-btn--gold samay-btn--full" style="{% if cart.item_count == 0 %}display: none;{% endif %} font-size: var(--fs-sm); padding: 18px 24px; cursor: pointer; border: none; width: 100%;">
          PROCEED TO CHECKOUT
        </button>
      </form>
      <div style="text-align: center; margin-top: 10px;">
        <a href="{{ routes.cart_url | default: '/cart' }}" style="font-size: var(--fs-xs); color: var(--dim); text-decoration: underline;" onclick="window.samayCart && window.samayCart.close()">
          View Full Bag & Special Instructions →
        </a>
      </div>
    </div>
  </div>
</div>
