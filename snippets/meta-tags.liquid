





























{%- liquid
  assign og_title = page_title | default: shop.name
  if request.page_type == 'index'
    assign og_title = 'Zayro Eau de Parfum 50ml | Buy Online India | Samay Parfumes'
  elsif request.page_type == 'search'
    assign og_title = 'Search Results'
  elsif request.page_type == 'collection' or page_title == 'Products'
    assign og_title = 'All SAMAY Packs'
  elsif request.page_type == 'page' and page_title == 'Contact'
    assign og_title = 'Contact & Concierge'
  elsif request.page_type == 'page' and page.template_suffix == 'faq'
    assign og_title = 'Frequently Asked Questions | Samay Parfumes'
  elsif request.page_type == 'page' and page.template_suffix == 'about'
    assign og_title = 'The Story of Samay Parfumes | Artisan Perfumery India'
  elsif request.page_type == 'product' and page_title == 'Samay Zayro'
    assign og_title = 'Samay Zayro 50ml EDP'
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  assign single_prod = all_products['samay-zayro-50ml-eau-de-parfum']
  assign duo_prod = all_products['samay-zayro-duo-combo-2-in-1']
  assign trio_prod = all_products['samay-zayro-grand-trio-3-in-1-combo']

  if single_prod == blank or duo_prod == blank or trio_prod == blank
    for p in collections.all.products
      assign handle_downcase = p.handle | downcase
      if handle_downcase contains 'trio'
        assign trio_prod = trio_prod | default: p
      elsif handle_downcase contains 'duo'
        assign duo_prod = duo_prod | default: p
      elsif handle_downcase contains 'zayro' or handle_downcase contains 'single'
        assign single_prod = single_prod | default: p
      endif
    endfor
  endif

  assign single_price = single_prod.price | money | default: '₹1,599'
  assign duo_price = duo_prod.price | money | default: '₹3,198'
  assign trio_price = trio_prod.price | money | default: '₹4,797'

  assign dynamic_home_description = 'Shop Zayro, a 50ml Eau de Parfum by Samay Parfumes. Choose Single ' | append: single_price | append: ', Duo ' | append: duo_price | append: ' or Trio ' | append: trio_price | append: '. Free shipping across India.'

  assign og_description = page_description
  if request.page_type == 'index' or og_description contains '1,499' or og_description contains '1499' or og_description == blank
    if request.page_type == 'index' or og_description contains '1,499' or og_description contains '1499'
      assign og_description = dynamic_home_description
    elsif request.page_type == 'cart'
      assign og_description = 'Review your shopping bag for Samay Zayro 50ml Eau de Parfum. Fast dispatch across India with complimentary shipping.'
    elsif request.page_type == 'collection'
      assign og_description = 'Discover the complete Samay Parfumes collection: Zayro 50ml Single, Duo Combo, and Grand Trio artisanal Eau de Parfum packs.'
    elsif request.page_type == 'search'
      assign og_description = 'Search the Samay Parfumes luxury fragrance catalogue for Zayro Eau de Parfum packs, notes, and curated gift combos.'
    elsif request.page_type == '404'
      assign og_description = 'The page you requested on Samay Parfumes could not be found. Explore our luxury Zayro Eau de Parfum packs online.'
    elsif request.page_type == 'page' and page.template_suffix == 'faq'
      assign og_description = 'Frequently Asked Questions about Samay Parfumes, Zayro Eau de Parfum packs, shipping across India, and damaged bottle guarantees.'
    elsif request.page_type == 'page' and page.template_suffix == 'about'
      assign og_description = 'Discover the story of Samay Parfumes: small-batch artisanal perfumery in India crafting Zayro 50ml Eau de Parfum.'
    elsif request.page_type == 'page'
      assign og_description = 'Connect with the Samay Parfumes concierge for order assistance, artisanal fragrance inquiries, and bespoke gifting across India.'
    elsif request.page_type == 'policy'
      assign og_description = 'Official customer policies for Samay Parfumes, covering complimentary shipping, 48-hour transit protection, returns, and privacy.'
    else
      assign og_description = 'Samay Parfumes — Zayro 50ml Eau de Parfum, a fragrance beyond time. Single, Duo and Trio packs crafted in India.'
    endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # 1. Social Image Resolution (page_image > product.featured_image > fallback)
  assign social_image = nil
  assign social_image_alt = og_title

  if page_image
    assign social_image = page_image
    assign social_image_alt = page_image.alt | default: og_title
  elsif request.page_type == 'product' and product.featured_image
    assign social_image = product.featured_image
    assign social_image_alt = product.featured_image.alt | default: product.title
  endif

  if social_image
    assign og_image_url = social_image | image_url: width: 1200
    assign og_image_width = social_image.width | default: 1200
    assign og_image_height = social_image.height | default: 630
    unless og_image_url contains 'http'
      assign og_image_url = 'https:' | append: og_image_url
    endunless
  else
    assign og_image_url = 'samay-hero-clock.jpg' | asset_url
    unless og_image_url contains 'http'
      assign og_image_url = 'https:' | append: og_image_url
    endunless
    assign og_image_width = 1024
    assign og_image_height = 571
    assign social_image_alt = og_title
  endif

  # Organization Settings
  assign org_name = 'Samay Parfumes'
  assign org_url = shop.url
  assign org_logo_url = 'samay-logo-black.png' | asset_url
  unless org_logo_url contains 'http'
    assign org_logo_url = 'https:' | append: org_logo_url
  endunless
  # TODO: Verify/update customer contact email (samayparfume@gmail.com)
  assign org_email = settings.contact_email | default: 'samayparfume@gmail.com'
  assign org_phone = settings.contact_phone | default: '+91 93058 88555'

  assign social_instagram = settings.social_instagram_link
  assign social_facebook = settings.social_facebook_link

  assign open_brace = '{'
  assign close_brace = '}'
  assign search_target_url = org_url | append: routes.search_url | append: '?q=' | append: open_brace | append: 'search_term_string' | append: close_brace
-%}

<!-- OpenGraph / Social Metadata -->
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:secure_url" content="{{ og_image_url }}">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta property="og:image:alt" content="{{ social_image_alt | escape }}">

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<!-- Twitter Card Metadata -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_image_url }}">
<meta name="twitter:image:alt" content="{{ social_image_alt | escape }}">

<!-- Canonical & Title -->
<link rel="canonical" href="{{ canonical_url }}">
<title>{%- if request.page_type == 'index' -%}
    Zayro Eau de Parfum 50ml | Buy Online India | Samay Parfumes
  {%- elsif request.page_type == 'search' -%}
    Search Results &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'collection' or page_title == 'Products' -%}
    All SAMAY Packs &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'page' and page.template_suffix == 'faq' -%}
    Frequently Asked Questions &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'page' and page.template_suffix == 'about' -%}
    The Story of Samay Parfumes &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'page' and page_title == 'Contact' -%}
    Contact &amp; Concierge &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'product' and page_title == 'Samay Zayro' -%}
    Samay Zayro 50ml EDP &ndash; {{ shop.name }}
  {%- else -%}
    {{ page_title | strip_html }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}</title>
<meta name="description" content="{{ og_description | escape }}">

<!-- Crawl Hygiene -->
{%- if template contains 'thank-you' or page.handle contains 'thank-you' or request.page_type == 'cart' or request.page_type == 'search' or request.page_type == '404' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<!-- 1. Organization & WebSite JSON-LD (Site-Wide) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ org_url | append: '/#organization' | json }},
      "name": {{ org_name | json }},
      "url": {{ org_url | json }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ org_logo_url | json }}
      },
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "IN"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "areaServed": "IN",
        "availableLanguage": "en"{% if org_email != blank %},
        "email": {{ org_email | json }}{% endif %}{% if org_phone != blank %},
        "telephone": {{ org_phone | json }}{% endif %}
      }{% if social_instagram != blank or social_facebook != blank %},
      "sameAs": [
        {%- assign comma = false -%}
        {%- if social_instagram != blank -%}
          {{ social_instagram | json }}
          {%- assign comma = true -%}
        {%- endif -%}
        {%- if social_facebook != blank -%}
          {%- if comma -%},{%- endif -%}
          {{ social_facebook | json }}
        {%- endif -%}
      ]{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": {{ org_url | append: '/#website' | json }},
      "name": {{ org_name | json }},
      "url": {{ org_url | json }},
      "publisher": {
        "@id": {{ org_url | append: '/#organization' | json }}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_target_url | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>

<!-- 2. BreadcrumbList JSON-LD -->
{%- if request.page_type == 'product' -%}
  {%- assign breadcrumb_col = collection -%}
  {%- if breadcrumb_col == blank and product.collections.size > 0 -%}
    {%- assign breadcrumb_col = product.collections.first -%}
  {%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {%- if breadcrumb_col and breadcrumb_col.url != blank -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumb_col.title | json }},
        "item": {{ shop.url | append: breadcrumb_col.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- else -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": "All SAMAY Packs",
        "item": {{ shop.url | append: routes.all_products_collection_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- elsif request.page_type == 'collection' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | default: 'All SAMAY Packs' | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    ]
  }
  </script>
{%- elsif request.page_type == 'page' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ shop.url | append: page.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

<!-- 3. Product JSON-LD (PDP) -->
{%- if request.page_type == 'product' -%}
  {%- assign current_var = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ shop.name | default: 'Samay Parfumes' | json }}
    },
    {%- if product.featured_image -%}
    {%- assign feat_img_url = product.featured_image | image_url: width: 1200 -%}
    {%- unless feat_img_url contains 'http' -%}{%- assign feat_img_url = 'https:' | append: feat_img_url -%}{%- endunless -%}
    "image": [
      {{ feat_img_url | json }}
    ],
    {%- endif -%}
    {%- if current_var.sku != blank -%}
    "sku": {{ current_var.sku | json }},
    {%- endif -%}
    "offers": {
      "@type": "Offer",
      "url": {{ shop.url | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | default: 'INR' | json }},
      "price": {{ current_var.price | money_without_currency | remove: ',' | json }},
      "availability": "https://schema.org/{% if current_var.available %}InStock{% else %}OutOfStock{% endif %}"
    }
  }
  </script>
{%- endif -%}


