{%- liquid
  assign og_title = page_title | default: shop.name
  if request.page_type == 'index' and page_title == shop.name
    assign og_title = 'Samay Parfumes | Zayro Eau de Parfum 50ml'
  elsif request.page_type == 'search'
    assign og_title = 'Search Results'
  elsif request.page_type == 'collection' or page_title == 'Products'
    assign og_title = 'All Fragrance Editions'
  elsif request.page_type == 'page' and page_title == 'Contact'
    assign og_title = 'Contact & Concierge'
  elsif request.page_type == 'product' and page_title == 'Samay Zayro'
    assign og_title = 'Samay Zayro 50ml EDP'
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  assign og_description = page_description
  if og_description == blank
    if request.page_type == 'cart'
      assign og_description = 'Review your shopping bag for Samay Zayro 50ml Eau de Parfum. Fast express dispatch across India with complimentary shipping.'
    elsif request.page_type == 'collection'
      assign og_description = 'Discover the complete Samay Parfumes collection: Zayro 50ml Single, Duo Combo, and Grand Trio artisanal Eau de Parfum editions.'
    elsif request.page_type == 'search'
      assign og_description = 'Search the Samay Parfumes luxury fragrance catalogue for Zayro Eau de Parfum editions, notes, and curated gift combos.'
    elsif request.page_type == '404'
      assign og_description = 'The page you requested on Samay Parfumes could not be found. Explore our luxury Zayro Eau de Parfum editions online.'
    elsif request.page_type == 'page'
      assign og_description = 'Connect with the Samay Parfumes concierge for order assistance, artisanal fragrance inquiries, and bespoke gifting across India.'
    elsif request.page_type == 'policy'
      assign og_description = 'Official customer policies for Samay Parfumes, covering complimentary shipping, 48-hour transit protection, returns, and privacy.'
    else
      assign og_description = 'Samay Parfumes — Zayro 50ml Eau de Parfum, a fragrance beyond time. Single, Duo and Trio editions crafted in India.'
    endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url: width: 1200, height: 630 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url: width: 1200, height: 630 }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width | default: 1200 }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height | default: 630 }}"
  >
{%- else -%}
  <meta
    property="og:image"
    content="https:{{ 'samay-hero-clock.jpg' | asset_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ 'samay-hero-clock.jpg' | asset_url }}"
  >
  <meta
    property="og:image:width"
    content="1024"
  >
  <meta
    property="og:image:height"
    content="571"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>{%- if request.page_type == 'index' and page_title == shop.name -%}
    Samay Parfumes | Zayro Eau de Parfum 50ml
  {%- elsif request.page_type == 'search' -%}
    Search Results &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'collection' or page_title == 'Products' -%}
    All Fragrance Editions &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'page' and page_title == 'Contact' -%}
    Contact &amp; Concierge &ndash; {{ shop.name }}
  {%- elsif request.page_type == 'product' and page_title == 'Samay Zayro' -%}
    Samay Zayro 50ml EDP &ndash; {{ shop.name }}
  {%- else -%}
    {{ page_title | strip_html }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{%- if template contains 'thank-you' or page.handle contains 'thank-you' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

