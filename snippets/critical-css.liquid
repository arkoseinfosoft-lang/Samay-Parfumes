{% comment %}
  Critical CSS for Samay Parfumes - Inlined in <head> for 0ms render-blocking delay
  Covers Above-The-Fold: Self-Hosted Fonts, Resets, Announcement Bar, Luxury Header & Hero
{% endcomment %}
@font-face {
  font-family: 'Bodoni Moda';
  font-style: normal;
  font-weight: 300 900;
  font-display: swap;
  src: url('{{ "bodoni-moda-latin-normal.woff2" | asset_url }}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Bodoni Moda';
  font-style: italic;
  font-weight: 300 900;
  font-display: swap;
  src: url('{{ "bodoni-moda-latin-italic.woff2" | asset_url }}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Plus Jakarta Sans';
  font-style: normal;
  font-weight: 300 800;
  font-display: swap;
  src: url('{{ "plus-jakarta-sans-latin-normal.woff2" | asset_url }}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
:root {
  /* ==========================================================================
     DESIGN TOKENS (COLLAPSED SCALES)
     ========================================================================== */
  /* Border Radius: 3 vars */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --radius-xs: var(--radius-sm);

  /* Font Sizes: 7 vars (12/14/16/20/24/32/48px) */
  --fs-xs: 12px;
  --fs-sm: 14px;
  --fs-md: 16px;
  --fs-lg: 20px;
  --fs-xl: 24px;
  --fs-2xl: 32px;
  --fs-3xl: 48px;

  /* Text Colours: 8 vars */
  --text-primary: #1b1309;
  --text-secondary: #554736;
  --text-muted: #5c5040;
  --text-on-dark: #f7f2ea;
  --text-gold: #c9a96e;
  --text-link: #78521d;
  --text-error: #991b1b;
  --text-success: #2e7d32;

  --cream: #f7f2ea;
  --cream2: #efe8dc;
  --cream3: #e5ddd0;
  --cream-card: #fdfbf7;
  --white: #ffffff;
  --samay-gold: #c9a96e;
  --samay-gold-hover: #dfc89e;
  --gold: #c9a96e;
  --gold-dark: #78521d;
  --gold-hover: #b89659;
  --gold-light: #dfc89e;
  --gold-gradient: linear-gradient(135deg, #dfc89e 0%, #c9a96e 50%, #78521d 100%);
  --brown: #2c1f0e;
  --brown-dark: #1b1309;
  --taupe: #554736;
  --dim: #5c5040;
  --border: #ddd0bc;
  --border-light: #ece3d4;
  --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
  --sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --header-height: 100px;
  --announcement-height: 38px;
  --page-width: 1440px;
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --shadow-subtle: 0 4px 20px rgba(44, 31, 14, 0.05);
  --shadow-card: 0 10px 30px rgba(44, 31, 14, 0.07);
  --shadow-hover: 0 18px 45px rgba(44, 31, 14, 0.12);
  --shadow-modal: 0 25px 60px rgba(22, 17, 11, 0.25);
  --transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}
html {
  scroll-behavior: smooth;
  box-sizing: border-box;
  font-size: var(--fs-md);
  background-color: var(--cream);
  color: var(--brown);
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}
*, *::before, *::after {
  box-sizing: inherit;
}
body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
  font-family: var(--sans);
  background-color: var(--cream);
  color: var(--brown);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: clip;
}
#MainContent, .shopify-section, .shopify-section-group-header-group, .shopify-section-group-footer-group {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
}
.shopify-section-group-header-group {
  position: -webkit-sticky !important;
  position: sticky !important;
  top: calc(-1 * var(--announcement-height, 0px)) !important;
  z-index: 900 !important;
}
.shopify-section > * {
  width: 100% !important;
}
h1, h2, h3, h4, h5, h6, .serif-font {
  font-family: var(--serif);
  font-weight: 400;
  margin: 0;
  color: var(--brown);
  letter-spacing: -0.01em;
}
p {
  margin: 0 0 1rem;
  color: var(--taupe);
}
a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition);
}
img {
  max-width: 100%;
  height: auto;
  display: block;
}
button, input, textarea, select {
  font-family: inherit;
}
.container {
  width: 100%;
  max-width: var(--page-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: clamp(16px, 4vw, 40px);
  padding-right: clamp(16px, 4vw, 40px);
  box-sizing: border-box;
}
.samay-announcement-bar {
  background-color: var(--gold);
  color: #1a1612;
  padding: 9px 12px;
  font-family: var(--sans);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: none;
  text-align: center;
  position: relative;
  z-index: 100;
  overflow: hidden;
  width: 100%;
}
.samay-announcement-content {
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  white-space: nowrap;
}
.samay-announce-track {
  display: flex;
  align-items: center;
  gap: 1.4rem;
}
.samay-announce-track span.highlight {
  font-weight: 700;
  background: rgba(44, 31, 14, 0.2);
  color: var(--text-on-dark);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  letter-spacing: 0.15em;
}
.samay-header-wrapper {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 900;
  background-color: #000000;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-bottom: none;
  box-shadow: none;
  transition: var(--transition);
}
.samay-header-wrapper.is-scrolled,
.samay-header-wrapper.is-transparent,
.samay-header-wrapper--transparent {
  background-color: #000000;
  border-bottom: none;
  box-shadow: none;
}
.samay-header {
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}
.samay-logo-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
  margin-left: 1cm;
}
.samay-header-logo-img {
  height: 64px;
  max-height: 66px;
  width: auto;
  object-fit: contain;
  transition: transform 0.3s ease;
}
.samay-logo-link:hover .samay-header-logo-img {
  transform: scale(1.02);
}
.samay-nav {
  display: flex;
  align-items: center;
  gap: 2.2rem;
}
.samay-nav-link {
  font-family: var(--sans);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--samay-gold);
  position: relative;
  padding: 6px 0;
  transition: color 0.25s ease;
  white-space: nowrap;
}
.samay-nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1.5px;
  background-color: var(--samay-gold-hover);
  transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}
.samay-nav-link:hover,
.samay-nav-link:active,
.samay-nav-link.is-active {
  color: var(--samay-gold-hover);
}
.samay-nav-link:hover::after,
.samay-nav-link:active::after,
.samay-nav-link.is-active::after {
  width: 100%;
}
.samay-nav-dropdown,
.samay-dropdown,
.samay-submenu,
.samay-nav-item .dropdown,
.samay-dropdown-menu,
.header__submenu {
  background-color: #000000;
  border: 1px solid rgba(212, 175, 55, 0.25);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.85);
}
.samay-nav-dropdown a,
.samay-dropdown a,
.samay-submenu a,
.samay-dropdown-menu a,
.header__submenu a,
.header__menu-item {
  color: var(--samay-gold);
  transition: color 0.25s ease;
}
.samay-nav-dropdown a:hover,
.samay-nav-dropdown a:active,
.samay-dropdown a:hover,
.samay-dropdown a:active,
.samay-submenu a:hover,
.samay-submenu a:active,
.samay-dropdown-menu a:hover,
.samay-dropdown-menu a:active,
.header__submenu a:hover,
.header__submenu a:active,
.header__menu-item:hover {
  color: var(--samay-gold-hover);
}
.samay-header-actions {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-shrink: 0;
}
.samay-header-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 22px;
  font-family: var(--sans);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border-radius: var(--radius-sm);
  background: var(--gold);
  color: var(--brown-dark);
  border: 1px solid var(--gold);
  min-height: 42px;
  text-decoration: none;
  cursor: pointer;
  transition: var(--transition);
}
.samay-header-cta-btn:hover {
  background: var(--gold-dark);
  border-color: var(--gold-dark);
  color: var(--white);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(201, 169, 110, 0.35);
}
.samay-cart-trigger {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(212, 175, 55, 0.35);
  background: transparent;
  color: var(--samay-gold);
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
}
.samay-cart-trigger:hover,
.samay-cart-trigger:active {
  border-color: var(--samay-gold-hover);
  background: rgba(212, 175, 55, 0.12);
  color: var(--samay-gold-hover);
  transform: translateY(-2px);
}
.samay-cart-trigger svg {
  stroke: currentColor;
}
.samay-header-icon,
.samay-search-trigger,
.samay-account-trigger,
.header__icon,
.header__icon--account,
.header__icon--search {
  color: var(--samay-gold);
  transition: color 0.25s ease;
}
.samay-header-icon:hover,
.samay-header-icon:active,
.samay-search-trigger:hover,
.samay-search-trigger:active,
.samay-account-trigger:hover,
.samay-account-trigger:active,
.header__icon:hover,
.header__icon:active {
  color: var(--samay-gold-hover);
}
.samay-header-icon svg,
.samay-search-trigger svg,
.samay-account-trigger svg,
.header__icon svg {
  stroke: currentColor;
}
.samay-cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--samay-gold);
  color: #000000;
  font-size: var(--fs-xs);
  font-weight: 700;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid #000000;
}
.samay-mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  color: var(--samay-gold);
  cursor: pointer;
  padding: 8px;
  border-radius: var(--radius-xs);
  transition: color 0.25s ease;
}
.samay-mobile-menu-btn:hover,
.samay-mobile-menu-btn:active {
  color: var(--samay-gold-hover);
}
.samay-mobile-menu-btn svg {
  stroke: currentColor;
}
.samay-hero-section {
  position: relative;
  min-height: 92vh;
  min-height: 92svh;
  width: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: #1a1309;
}
.samay-hero-media-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.samay-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center right;
  filter: brightness(0.9);
  transform: scale(1.02);
}
.samay-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(22, 17, 11, 0.92) 0%, rgba(22, 17, 11, 0.85) 45%, rgba(22, 17, 11, 0.3) 78%, rgba(22, 17, 11, 0.12) 100%);
  pointer-events: none;
}
.samay-hero-content {
  position: relative;
  z-index: 2;
  max-width: 680px;
  padding: 70px 0;
  color: var(--cream);
}
.samay-hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--sans);
  font-size: var(--fs-sm);
  letter-spacing: 0.06em;
  
  color: var(--gold);
  margin-bottom: 1.4rem;
  font-weight: 600;
}
.samay-hero-eyebrow::before {
  content: '';
  width: 32px;
  height: 1.5px;
  background-color: var(--gold);
}
.samay-hero-title {
  font-family: var(--serif);
  font-size: clamp(2.8rem, 5.2vw, 4.8rem);
  font-weight: 300;
  line-height: 1.06;
  color: var(--cream);
  margin-bottom: 1.4rem;
}
.samay-hero-title em {
  font-style: italic;
  font-weight: 400;
  color: var(--gold-light);
}
.samay-hero-desc {
  font-family: var(--sans);
  font-size: var(--fs-md);
  line-height: 1.8;
  color: var(--text-on-dark);
  margin-bottom: 2.4rem;
  font-weight: 300;
}
.samay-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.2rem;
  align-items: center;
}
.samay-hero-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 1.8rem;
  margin-top: 3.5rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(221, 208, 188, 0.22);
}
.samay-highlight-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  letter-spacing: 0.12em;
  
  color: var(--gold-light);
  font-weight: 500;
}
.samay-highlight-item svg {
  color: var(--gold);
}
.samay-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 16px 36px;
  font-family: var(--sans);
  font-size: var(--fs-sm);
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  border-radius: var(--radius-xs);
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
  border: 1px solid transparent;
  min-height: 50px;
}
.samay-btn--gold {
  background: var(--gold);
  color: var(--brown-dark);
  border-color: var(--gold);
}
.samay-btn--gold:hover {
  background: var(--gold-dark);
  border-color: var(--gold-dark);
  color: var(--white);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(201, 169, 110, 0.35);
}
.samay-btn--outline {
  background: transparent;
  color: var(--cream);
  border-color: rgba(247, 242, 234, 0.5);
}
.samay-btn--outline:hover {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(201, 169, 110, 0.1);
  transform: translateY(-2px);
}
.samay-btn--dark {
  background: var(--brown);
  color: var(--cream);
  border-color: var(--brown);
}
.samay-btn--dark:hover {
  background: var(--brown-dark);
  color: var(--gold);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(44, 31, 14, 0.25);
}
@media screen and (max-width: 1024px) {
  :root {
    --header-height: 88px;
  }
  .samay-header-logo-img {
    height: 54px;
    max-height: 56px;
  }
  .samay-nav {
    gap: 1.4rem;
  }
}
@media screen and (max-width: 768px) {
  :root {
    --header-height: 72px;
    --announcement-height: 32px;
  }
  .container {
    padding-left: 16px;
    padding-right: 16px;
  }
  .samay-announcement-bar {
    font-size: var(--fs-xs);
    padding: 7px 8px;
    letter-spacing: 0.12em;
  }
  .samay-announce-repeat {
    display: none;
  }
  .samay-announce-track {
    gap: 0.8rem;
  }
  .samay-header {
    height: var(--header-height);
  }
  .samay-nav, .samay-header-cta-btn {
    display: none;
  }
  .samay-mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .samay-logo-link {
    margin-left: 0;
  }
  .samay-header-logo-img {
    height: 44px;
    max-height: 46px;
    width: auto;
    object-fit: contain;
  }
  .samay-cart-trigger {
    width: 44px;
    height: 44px;
  }
  .samay-hero-section {
    min-height: auto;
    height: auto;
    display: flex;
    flex-direction: column;
    background-color: #000000;
    overflow: visible;
  }
  .samay-hero-media-wrap {
    position: relative;
    top: auto;
    left: auto;
    width: 100%;
    aspect-ratio: 1024 / 571;
    background-color: #000000;
    overflow: hidden;
  }
  .samay-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: brightness(0.96);
    transform: none;
  }
  .samay-hero-overlay {
    display: none;
  }
  .samay-hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-left: clamp(16px, 4vw, 24px);
    padding-right: clamp(16px, 4vw, 24px);
  }
  .samay-hero-content {
    position: static;
    max-width: 100%;
    padding: 24px 0 36px;
    background-color: #000000;
    color: var(--cream);
    text-align: center;
  }
  .samay-hero-eyebrow {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--samay-gold);
    margin-bottom: 0.8rem;
  }
  .samay-hero-eyebrow::before {
    display: none;
  }
  .samay-hero-title {
    font-size: clamp(2rem, 7.5vw, 2.6rem);
    line-height: 1.12;
    margin-bottom: 0.9rem;
  }
  .samay-hero-desc {
    font-size: clamp(0.9rem, 3.4vw, 1rem);
    line-height: 1.65;
    color: var(--text-on-dark);
    margin-bottom: 1.6rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .samay-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  .samay-hero-actions .samay-btn {
    width: 100%;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .samay-hero-highlights {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 20px;
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
  }
  .samay-highlight-item {
    font-size: var(--fs-xs);
    color: var(--samay-gold-hover);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .samay-highlight-item svg {
    color: var(--samay-gold);
  }
}
@media screen and (max-width: 480px) {
  :root {
    --header-height: 66px;
  }
  .samay-header-logo-img {
    height: 40px;
    max-height: 42px;
  }
}
@media (hover: none), (pointer: coarse) {
  .samay-atomizer, .samay-spray-canvas {
    display: none !important;
  }
}
.hp-field {
  position: absolute !important;
  left: -9999px !important;
  width: 1px !important;
  height: 1px !important;
  overflow: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
.samay-whatsapp-floating {
  position: fixed;
  bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  right: calc(24px + env(safe-area-inset-right, 0px));
  width: 56px;
  height: 56px;
  min-width: 56px;
  min-height: 56px;
  border-radius: 50%;
  background-color: #25d366;
  color: var(--text-on-dark) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 18px rgba(37, 211, 102, 0.4), 0 2px 8px rgba(0, 0, 0, 0.2);
  z-index: 850;
  text-decoration: none;
}
@media screen and (max-width: 768px) {
  .samay-whatsapp-floating {
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    right: calc(16px + env(safe-area-inset-right, 0px));
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
  }
}
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}
.ep-price-per-ml, .samay-pdp-price-per-ml {
  display: block;
  font-size: var(--fs-xs);
  color: var(--dim, #8c7f70);
  margin-top: 3px;
  font-family: var(--sans, 'Plus Jakarta Sans', sans-serif);
  letter-spacing: 0.02em;
}
.samay-gift-banner {
  margin-top: 32px;
  padding: 16px 20px;
  background: rgba(201, 169, 110, 0.08);
  border: 1px solid rgba(201, 169, 110, 0.25);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.samay-gift-text {
  margin: 0;
  font-size: var(--fs-sm);
  color: var(--brown, #2c1f0e);
  line-height: 1.5;
  font-family: var(--sans, 'Plus Jakarta Sans', sans-serif);
}
.samay-gift-text span {
  color: var(--samay-gold, #c9a96e);
  margin-right: 4px;
}
.samay-gift-link {
  font-size: var(--fs-sm);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--samay-gold, #c9a96e);
  text-decoration: none;
  white-space: nowrap;
  transition: color 0.2s ease;
}
.samay-gift-link:hover {
  color: var(--gold-dark, #78521d);
}
.samay-apply-section {
  width: 100%;
  padding: 100px 0;
  background: var(--cream2);
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
}
.samay-apply-box {
  max-width: 960px;
  margin: 0 auto;
  text-align: center;
  padding: 0 20px;
}
.samay-apply-title {
  font-family: var(--serif);
  font-size: var(--fs-2xl);
  font-weight: 300;
  margin: 12px 0 16px;
  color: var(--text-primary);
}
.samay-apply-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-top: 42px;
  text-align: center;
}
.samay-apply-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 24px;
  background: var(--cream-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  transition: var(--transition);
}
.samay-apply-step:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
  box-shadow: var(--shadow-card);
}
.samay-apply-icon-wrap {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--cream2);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  color: var(--text-gold);
}
.samay-apply-icon {
  width: 28px;
  height: 28px;
  stroke: var(--samay-gold, #c9a96e);
  stroke-width: 1.5px;
}
.samay-apply-step-num {
  font-family: var(--sans);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--text-link);
  margin-bottom: 8px;
  text-transform: uppercase;
}
.samay-apply-step-text {
  font-family: var(--sans);
  font-size: var(--fs-sm);
  line-height: 1.65;
  color: var(--text-secondary);
  margin: 0;
}
@media screen and (max-width: 768px) {
  .samay-apply-section {
    padding: 48px 0;
  }
  .samay-apply-grid {
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .samay-apply-step {
    padding: 24px 18px;
  }
}
.samay-pdp-summary-seo {
  margin-top: 16px;
  margin-bottom: 20px;
  padding: 14px 16px;
  background: rgba(201, 169, 110, 0.05);
  border-left: 2px solid var(--samay-gold, #c9a96e);
  border-radius: 0 4px 4px 0;
}
.samay-pdp-summary-seo p {
  margin: 0;
  font-size: var(--fs-sm);
  line-height: 1.6;
  color: var(--dim, #5c5040);
  font-family: var(--sans, 'Plus Jakarta Sans', sans-serif);
}
.gold-link {
  color: var(--samay-gold, #c9a96e);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}
.gold-link:hover {
  color: var(--gold-dark, #78521d);
}
.samay-page-section {
  padding: 40px 0 80px;
  background: var(--cream, #f7f2ea);
  min-height: 70vh;
}

.samay-heading-section {
  font-family: var(--serif);
  font-size: var(--fs-2xl);
  text-transform: none;
  font-weight: 300;
  line-height: 1.25;
}
.samay-heading-eyebrow {
  font-family: var(--sans);
  font-size: var(--fs-xs);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
  line-height: 1.4;
}
.samay-footer-heading {
  font-family: var(--sans);
  font-size: var(--fs-xs);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-light);
  font-weight: 600;
  margin-bottom: 20px;
}
.samay-footer-links li {
  font-size: var(--fs-sm);
  color: var(--text-on-dark);
  line-height: 1.6;
}
.samay-footer-bottom {
  font-size: var(--fs-xs);
  color: var(--text-on-dark);
  text-transform: none;
}
.samay-seller-info-section {
  padding: 24px 0;
  color: var(--text-muted);
}
.samay-seller-info-card {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
}
.samay-seller-info-title {
  font-family: var(--serif);
  font-size: var(--fs-lg);
  font-weight: 400;
  color: var(--text-primary);
  margin: 0;
  letter-spacing: -0.01em;
}
.samay-seller-info-item dd,
.samay-seller-info-ingredients {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}
