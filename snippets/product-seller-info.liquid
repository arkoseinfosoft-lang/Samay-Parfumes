{% comment %}
  SAMAY PARFUMES - PRODUCT & SELLER INFORMATION (SNIPPET)
  Statutory disclosure & mandatory labeling block above footer.
  All values wrapped in {% if %} guards; unverified/unsupplied fields render nothing.
  Fields are editable in the Theme Customizer via section settings or global settings.
{% endcomment %}
{%- assign section_heading = section.settings.heading | default: settings.seller_info_heading | default: 'Product & Seller Information' -%}
{%- assign net_qty = section.settings.net_quantity | default: settings.seller_net_quantity | default: '50ml' -%}
{%- assign origin_country = section.settings.country_of_origin | default: settings.seller_country_of_origin | default: 'India' -%}
{%- assign batch_text = section.settings.batch_expiry | default: settings.seller_batch_expiry | default: 'Printed on the bottle and outer box' -%}
{%- assign company = section.settings.company_name | default: settings.seller_company_name | default: 'Samay Parfumes' -%}
{%- assign address = section.settings.address | default: settings.seller_address | default: 'Kalyanpur, Kanpur Nagar, Uttar Pradesh, India' -%}
{%- assign ingredients_text = section.settings.ingredients | default: settings.seller_ingredients -%}
{%- assign allergen_text = section.settings.allergen_note | default: settings.seller_allergen_note -%}
{%- assign grievance_text = section.settings.grievance_officer | default: settings.seller_grievance_officer -%}

<section class="samay-seller-info-section" id="seller-info" aria-label="Product and Seller Information">
  <div class="container">
    <div class="samay-seller-info-card">
      <details class="samay-seller-info-details" open>
        <summary class="samay-seller-info-summary">
          <div class="samay-seller-info-header">
            <span class="samay-seller-info-badge">⚜ Statutory Details</span>
            <h2 class="samay-seller-info-title">{{ section_heading | escape }}</h2>
          </div>
          <span class="samay-seller-info-toggle-icon" aria-hidden="true">▾</span>
        </summary>

        <div class="samay-seller-info-content">
          <dl class="samay-seller-info-grid">
            {%- if net_qty != blank -%}
              <div class="samay-seller-info-item">
                <dt>Net Quantity</dt>
                <dd>{{ net_qty | escape }}</dd>
              </div>
            {%- endif -%}

            {%- if origin_country != blank -%}
              <div class="samay-seller-info-item">
                <dt>Country of Origin</dt>
                <dd>{{ origin_country | escape }}</dd>
              </div>
            {%- endif -%}

            {%- if batch_text != blank -%}
              <div class="samay-seller-info-item">
                <dt>Batch / Mfg / Expiry</dt>
                <dd>{{ batch_text | escape }}</dd>
              </div>
            {%- endif -%}

            {%- if company != blank or address != blank -%}
              <div class="samay-seller-info-item samay-seller-info-item--wide">
                <dt>Manufactured / Marketed By</dt>
                <dd>
                  {%- if company != blank -%}{{ company | escape }}{%- endif -%}
                  {%- if company != blank and address != blank -%}, {% endif -%}
                  {%- if address != blank -%}{{ address | escape }}{%- endif -%}
                </dd>
              </div>
            {%- endif -%}

            {%- if ingredients_text != blank -%}
              <div class="samay-seller-info-item samay-seller-info-item--full">
                <dt>Ingredients</dt>
                <dd class="samay-seller-info-ingredients">{{ ingredients_text | escape }}</dd>
              </div>
            {%- endif -%}

            {%- if allergen_text != blank -%}
              <div class="samay-seller-info-item samay-seller-info-item--full">
                <dt>Allergen &amp; Safety Note</dt>
                <dd>{{ allergen_text | escape }}</dd>
              </div>
            {%- endif -%}

            {%- if grievance_text != blank -%}
              <div class="samay-seller-info-item samay-seller-info-item--full">
                <dt>Grievance Officer</dt>
                <dd>{{ grievance_text | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  (function() {
    try {
      var d = document.querySelector('.samay-seller-info-details');
      if (d && window.innerWidth <= 768) {
        d.removeAttribute('open');
      }
    } catch(e) {}
  })();
</script>
